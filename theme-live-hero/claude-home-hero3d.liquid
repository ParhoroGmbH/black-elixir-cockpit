{%- comment -%} Teil der Section claude-home – Hero mit 4 Motiven aus echten Produktfotos (Adventskalender, Geschenk-Seifen, Fragrance Library, DUMO). Claude · 11.11.2026, Kamera-Orbit 12.11.2026, Slider 20 s + Pause bei Interaktion 12.11.2026 – nicht anfassen {%- endcomment -%}
{%- assign s = sec.settings -%}
{%- render 'claude-home-hero3d-css' -%}
<style>.ch .h3-slide::before{display:none!important}.ch .h3-slide{background:#000;overflow:hidden}.ch .h3-bgl{position:absolute;inset:0;z-index:0;pointer-events:none;background:var(--bg) center/cover no-repeat;transform:translate3d(var(--px,0px),0,0) scale(1.04);will-change:transform}.ch .h3-bgl::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.9) 0%,rgba(0,0,0,.62) 38%,rgba(0,0,0,.12) 72%,rgba(0,0,0,.25))}.ch .h3-floor{display:none}.ch .h3-slide.is-on .h3-wipe{animation-name:h3WipeT}@keyframes h3WipeT{0%{transform:translateX(0);opacity:1}100%{transform:translateX(500%);opacity:0}}.ch .h3-par{transform:none!important}.ch .m3{position:relative;width:460px;height:560px}.ch .m3 model-viewer{position:absolute;z-index:1;left:0;right:0;top:0;bottom:92px;width:100%;height:auto;--poster-color:transparent;background:transparent;transform:translate3d(0,calc(var(--dy,0px) + var(--sy,0px)),0) scale(var(--ms,1));transform-origin:50% 60%;transition:opacity .35s}.ch .m3 model-viewer::part(default-progress-bar){display:none}.ch .m3 [slot^=hotspot]{width:1px;height:1px;opacity:0;pointer-events:none}.ch .m3-soap model-viewer{--ms:.72}.ch .m3-glint{position:absolute;z-index:0;left:var(--gx,50%);top:var(--gy,80%);width:300px;height:46px;margin:-23px 0 0 -150px;border-radius:50%;background:radial-gradient(ellipse at 50% 50%,rgba(255,222,165,.30),rgba(255,200,130,.10) 45%,transparent 72%);filter:blur(6px);mix-blend-mode:screen;pointer-events:none;opacity:0;transition:opacity .8s}.ch .m3.is-set .m3-glint{opacity:1}.ch .m3-soap .m3-glint{width:240px;margin-left:-120px}.ch .m3-dust{position:absolute;left:-40px;top:-40px;width:calc(100% + 80px);height:calc(100% + 80px);pointer-events:none;z-index:2}.js .ch .h3-slide:not(.is-on):not(.bg-ok) .h3-bgl{background-image:none!important}.ch .m3 model-viewer{opacity:0}.ch .m3:not(.is-set) .m3-tabs{visibility:hidden}.ch .m3-tabs{top:calc(var(--gy,500px) + 40px);bottom:auto;gap:4px;width:460px;flex-wrap:wrap;justify-content:center}.ch .m3-tabs button{padding:6px 10px;min-height:30px;font-size:10px;letter-spacing:.1em}.ch .m3-dumo .dm3-ring{top:40%;width:340px;height:340px;margin:-170px 0 0 -170px;opacity:.55}.ch .m3 .sp3-tag{right:auto;left:50%;top:10px;transform:translate(-50%,-100%) rotate(-3deg);white-space:nowrap;transition:left .3s,top .3s}.ch .m3:not(.is-set) .sp3-tag{visibility:hidden}.ch .ch-h3 .ch-ctrl{left:50%;right:auto;bottom:24px;transform:translateX(-50%)}.ch .h3-slide.is-on{z-index:1}.ch .h3-slide:not(.is-on){transition:opacity .5s .7s}.ch .ch-h3 .ch-ctrl{z-index:4}@media (max-width:1100px){.ch .m3{scale:.82}}@media (max-width:860px){.ch .m3{height:560px;scale:.62}}@media (max-width:400px){.ch .m3{scale:.56}}@media (max-width:860px){.ch .h3-bgl{background-position:70% center}.ch .h3-bgl::after{background:linear-gradient(180deg,rgba(0,0,0,.9) 0%,rgba(0,0,0,.6) 40%,rgba(0,0,0,.2) 75%,rgba(0,0,0,.5))}.ch .m3-tabs{width:560px}.ch .m3 model-viewer{bottom:110px}}</style>
<div class="ch-hero ch-h3" data-ch-hero>
  {%- for i in (1..14) -%}
    <span class="ch-dust" style="left:{{ i | times: 37 | modulo: 100 }}%;width:{{ i | modulo: 3 | plus: 2 }}px;height:{{ i | modulo: 3 | plus: 2 }}px;animation-delay:-{{ i | times: 0.61 }}s" aria-hidden="true"></span>
  {%- endfor -%}
  {%- for n in (1..4) -%}
    {%- liquid
      assign btn2 = blank
      case n
        when 1
          assign eyebrow = 'Adventskalender 2026'
          assign title = s.hero1_title
          assign text = s.hero1_text
          assign btn = s.hero1_btn
          assign link = s.hero1_link
        when 2
          assign eyebrow = 'Nur bis 31.12.2026 · nur im Onlineshop'
          assign title = 'Italienische Seife geschenkt'
          assign text = s.hero2_text
          assign btn = s.hero2_btn
          assign link = s.hero2_link
          assign btn2 = 'So geht’s'
          assign link2 = '#ch-geschenk'
        when 3
          assign eyebrow = 'Fragrance Library · Extrait de Parfum'
          assign title = 'Jeder Duft ist eine Geschichte'
          assign text = 'Sieben Extraits, ein Flakon – jeder trägt die Farben seiner Geschichte. Wähle einen Titel und dreh ihn in Ruhe.'
          assign btn = 'Zur Bibliothek'
          assign link = routes.collections_url | append: '/' | append: s.col_library
        else
          assign eyebrow = 'DUMO · Luxury Perfume'
          assign title = 'Sieben Krieger, sieben Düfte'
          assign text = 'Jeder Flakon eine Büste aus Metall-Optik – gold, silber, bronze oder schwarz. Wähle deinen Kämpfer.'
          assign btn = 'Die Arena betreten'
          assign link = routes.collections_url | append: '/' | append: s.col_dumo
      endcase
      assign last = title | split: ' ' | last
      assign first = title | remove_last: last
      assign fl = '0.73,0.76,0.73,0.76' | split: ',' | slice: forloop.index0 | first
      comment
        Bodenlinie je Hintergrundbild (Anteil der Bildhöhe, Oberkante der Tisch-/Bodenfläche + Standfläche davor), 12.11.2026 nachgemessen; mobil eigene Werte
      endcomment
      assign flm = '0.76,0.77,0.74,0.78' | split: ',' | slice: forloop.index0 | first
      assign bgn = 'be-hero-bg-advent.png,be-hero-bg-seife.png,be-hero-bg-library.png,be-hero-bg-dumo.png' | split: ',' | slice: forloop.index0 | first
    -%}
    <div class="ch-slide h3-slide{% if forloop.first %} is-on{% endif %}" data-h3-slide data-floor="{{ fl }}" data-floor-m="{{ flm }}" style="--bg:url({{ images[bgn] | image_url: width: 2000 }})">
      <span class="h3-bgl" aria-hidden="true"></span><span class="h3-wipe" aria-hidden="true"></span>
      <div class="h3-text">
        <a href="{{ routes.collections_url }}/{{ s.col_soaps }}" class="h3-chip ch-glassD"><i></i>Seife geschenkt ab 59 € · ohne Code</a>
        <p class="h3-eyebrow">{{ eyebrow }}</p>
        {%- if forloop.first -%}<h1 class="h3-title">{{ first }}<em class="h3-shine">{{ last }}</em></h1>{%- else -%}<h2 class="h3-title">{{ first }}<em class="h3-shine">{{ last }}</em></h2>{%- endif -%}
        <p class="d">{{ text }}</p>
        {%- if n == 1 -%}<p class="h3-count" data-h3-count></p>{%- endif -%}
        <div class="h3-btns"><a class="ch-btn ch-btn--gold" href="{{ link }}">{{ btn }}</a>{%- if btn2 != blank -%}<a class="ch-btn ch-btn--line" href="{{ link2 }}">{{ btn2 }}</a>{%- endif -%}</div>
      </div>
      <div class="h3-stage">
        <span class="h3-floor" aria-hidden="true"></span>
        <div class="h3-par">
          {%- liquid
            case n
              when 1
                assign mlist = 'BABOR|eab800eba079cdeb/be-cal-babor.glb|-24|26,ARTDECO|7f0bc976655f8fa4/be-cal-artdeco.glb|-24|26,Molton Brown|5c65f193dc68588a/be-cal-mb3.glb|-24|26,Wir für Sie|8c572b0420074443/be-cal-wfs.glb|-24|26' | split: ','
              when 2
                assign mlist = 'Ambra & Vaniglia|66fa7df71ad55bd5/be2-soap-ambra.glb|-14|22,Bergamotto|9833b75849710d28/be2-soap-bergamotto.glb|-14|22,Fiori di Ciliegio|f65a5d777bb2cf87/be2-soap-ciliegio.glb|-14|22,Gelsomino|75befa81eadd0dfc/be2-soap-gelsomino.glb|-14|22,Lavanda|48fc8442dbc81963/be2-soap-lavanda.glb|-14|22,Orchidea Nera|9f0765b514b3ab27/be2-soap-orchidea.glb|-14|22' | split: ','
              when 3
                assign mlist = 'The Alchemist|726d6965c7f4d746/be4-fl-red.glb|20|200,The House of Mirth|7a67b14fc1ffec9a/be4-fl-yellow.glb|20|200,Orlando|d4c849a1041ec3a7/be4-fl-orlando.glb|20|200,Invisible Cities|b4395c42ef329856/be4-fl-cities.glb|20|200,Beloved|50b5261580d3bfd9/be4-fl-beloved.glb|20|200,Romeo and Juliet|ce3b708a28188d20/be4-fl-romeo.glb|20|200,Rebecca|13a61eafefe41e40/be4-fl-white.glb|20|200' | split: ','
            endcase
          -%}
          {%- if n == 4 -%}
            {%- assign c_dumo = collections[s.col_dumo] -%}
            <div class="m3 m3-dumo" data-m3 data-slam>
              <span class="dm3-ring" aria-hidden="true"></span>
              <span class="m3-glint" aria-hidden="true"></span><model-viewer data-m3-mv data-base="0" alt="DUMO Flakon in 3D" camera-orbit="0deg 80deg 105%" field-of-view="22deg" min-camera-orbit="auto 50deg auto" max-camera-orbit="auto 110deg auto" camera-controls disable-zoom disable-pan interaction-prompt="none" tone-mapping="neutral" environment-image="neutral" exposure="1.2" shadow-intensity="1" shadow-softness=".55" loading="lazy"><div slot="hotspot-foot" data-m3-foot data-position="0m 0m 0m" data-normal="0m 1m 0m"></div></model-viewer><canvas class="m3-dust" data-m3-dust aria-hidden="true"></canvas>
              <div class="ca3-tabs m3-tabs" role="group" aria-label="Krieger wählen">
                {%- for p in c_dumo.products limit: 7 -%}
                  {%- assign nm = p.title | remove: 'DUMO ' | split: ' ' | first -%}{%- assign low = nm | downcase -%}
                  {%- if low == 'spartacus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/047518974017eb47/be6-dumo-spartacus.glb' -%}{%- elsif low == 'commodus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/61da2d04a7777b4a/be6-dumo-commodus.glb' -%}{%- elsif low == 'crixus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/7cc23c0d5f6caf4f/be6-dumo-crixus.glb' -%}{%- elsif low == 'marcus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/93cab1590bc3d47f/be6-dumo-marcus.glb' -%}{%- elsif low == 'rexor' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/ac06e8a8d2318792/be6-dumo-rexor.glb' -%}{%- elsif low == 'priscus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/4ba273098301cc2a/be6-dumo-priscus.glb' -%}{%- elsif low == 'verus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/f62e89f263d62df5/be6-dumo-verus.glb' -%}{%- else -%}{%- assign glb = '' -%}{%- endif -%}
                  <button type="button" data-m3-go data-src="{{ glb }}" data-base="0"{% if forloop.first %} class="on"{% endif %}>{{ nm | capitalize }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            {%- assign m0 = mlist[0] | split: '|' -%}
            <div class="m3{% if n == 2 %} m3-soap{% endif %}" data-m3>
              <span class="m3-glint" aria-hidden="true"></span><model-viewer data-m3-mv data-base="{{ m0[2] }}" {% if n == 1 %}src{% else %}data-src{% endif %}="https://cdn.shopify.com/3d/models/o/{{ m0[1] }}" alt="{{ m0[0] }} in 3D" camera-orbit="{{ m0[2] }}deg 80deg auto" field-of-view="22deg" min-camera-orbit="auto 45deg auto" max-camera-orbit="auto 110deg auto" camera-controls disable-zoom disable-pan interaction-prompt="none" tone-mapping="neutral" environment-image="neutral" exposure="1.15" shadow-intensity="1" shadow-softness=".55" loading="{% if n == 1 %}eager{% else %}lazy{% endif %}"><div slot="hotspot-foot" data-m3-foot data-position="0m 0m 0m" data-normal="0m 1m 0m"></div>{% if n == 2 %}<div slot="hotspot-top" data-m3-top data-position="0m 0m 0m" data-normal="0m 1m 0m"></div>{% endif %}</model-viewer>
              {%- if mlist.size > 1 -%}
              <div class="ca3-tabs m3-tabs" role="group" aria-label="Auswahl">{%- for it in mlist -%}{%- assign ip = it | split: '|' -%}<button type="button" data-m3-go data-src="https://cdn.shopify.com/3d/models/o/{{ ip[1] }}" data-base="{{ ip[2] }}"{% if forloop.first %} class="on"{% endif %}>{{ ip[0] }}</button>{%- endfor -%}</div>
              {%- endif -%}{%- if n == 2 -%}<span class="sp3-tag">Ab 59 € geschenkt</span>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
  <div class="ch-ctrl">
    <button type="button" data-h3-prev aria-label="Vorheriges Motiv">←</button>
    <div class="ch-dots">{%- for n in (1..4) -%}<button type="button" data-h3-dot="{{ forloop.index0 }}" aria-label="Motiv {{ n }}"{% if forloop.first %} class="is-on"{% endif %}></button>{%- endfor -%}</div>
    <button type="button" data-h3-next aria-label="Nächstes Motiv">→</button>
  </div>
</div>
<script>
  (function () {
    var h = document.currentScript.previousElementSibling;
    // Adventskalender: Tage bis zum ersten Türchen
    var cn = h.querySelector('[data-h3-count]'), now = new Date(), y = now.getFullYear(), d1 = new Date(y, 11, 1), days = Math.ceil((d1 - now) / 864e5);
    if (cn) cn.innerHTML = days > 0 ? '<b>' + days + '</b>' + (days === 1 ? 'Tag' : 'Tage') + ' bis zum ersten Türchen' : (now.getMonth() === 11 && now.getDate() <= 24 ? '<b>' + now.getDate() + '</b>Heute öffnet Türchen ' + now.getDate() : '');
    if (!customElements.get('model-viewer')) { var ms = document.createElement('script'); ms.type = 'module'; ms.src = 'https://cdn.jsdelivr.net/npm/@google/model-viewer@3.5.0/dist/model-viewer.min.js'; document.head.appendChild(ms); }
    // Einheitlicher Stil: Produkt steht auf der Fläche im Bild, die Kamera kreist langsam darum (360° in 28 s), Hintergrund wandert mit.
    var still = matchMedia('(prefers-reduced-motion:reduce)').matches, SPEED = 360 / 28, TAU = 1.2, PHI = '80deg', IW = 1344, IH = 752, D = 0.42;
    // Eigener Slider (Attribute data-h3-*, damit der 8-s-Timer aus claude-home-js nicht greift): 20 s pro Motiv, ein Modellwechsel bei 10 s.
    // Klick/Ziehen am Modell, Pfeile oder Punkte stoppen den Automatismus für diesen Besuch; Maus über dem Hero pausiert.
    var slides = h.querySelectorAll('[data-h3-slide]'), dots = h.querySelectorAll('[data-h3-dot]'), si = 0, el = 0, sw = 0, stop = 0, hov = 0, last = Date.now(), DUR = 20000, SWT = 10000;
    function hold() { stop = 1; }
    // 12.11.2026: Motiv erst einblenden, wenn sein Hintergrundbild geladen ist (max. 2,5 s warten) – nie schwarzer Hero; Nachbarmotiv sofort vorladen.
    var want = -1;
    function bgReady(sl, cb) {
      sl.classList.add('bg-ok'); var m = /url\(["']?([^"')]+)/.exec(sl.style.getPropertyValue('--bg') || ''), done = 0;
      function ok() { if (!done) { done = 1; cb(); } }
      if (!m) return ok(); var im = new Image(); im.onload = im.onerror = ok; im.src = m[1]; if (im.complete) ok(); setTimeout(ok, 2500);
    }
    function boxOf(sl) { return boxes.filter(function (o) { return o.sl === sl; })[0] || null; }
    function show(i) {
      si = (i + slides.length) % slides.length; el = 0; sw = 0; var j = si, n = slides.length; want = j;
      dots.forEach(function (x, k) { x.classList.toggle('is-on', k === j); });
      load(boxOf(slides[j]));
      bgReady(slides[j], function () {
        if (want !== j) return;
        slides.forEach(function (x, k) { x.classList.toggle('is-on', k === j); });
        enter(boxOf(slides[j])); go();
        slides[(j + 1) % n].classList.add('bg-ok'); slides[(j + n - 1) % n].classList.add('bg-ok');
      });
    }
    var pv = h.querySelector('[data-h3-prev]'), nx = h.querySelector('[data-h3-next]');
    if (pv) pv.addEventListener('click', function () { hold(); show(si - 1); });
    if (nx) nx.addEventListener('click', function () { hold(); show(si + 1); });
    dots.forEach(function (x, k) { x.addEventListener('click', function () { hold(); show(k); }); });
    h.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') hov = 1; });
    h.addEventListener('pointerleave', function () { hov = 0; });
    var boxes = [].map.call(h.querySelectorAll('[data-m3]'), function (box) {
      var mv = box.querySelector('[data-m3-mv]'), sl = box.closest('[data-h3-slide]');
      var o = { box: box, mv: mv, bs: box.querySelectorAll('[data-m3-go]'), foot: box.querySelector('[data-m3-foot]'), top: box.querySelector('[data-m3-top]'), tag: box.querySelector('.sp3-tag'), sl: sl, bgl: sl.querySelector('.h3-bgl'), stage: sl.querySelector('.h3-stage'),
        cv: box.querySelector('[data-m3-dust]'), slam: box.hasAttribute('data-slam'), i: 0, base: +mv.dataset.base || 0, rad: (mv.getAttribute('camera-orbit') || '').split(' ')[2] || 'auto',
        t0: 0, touched: 0, dy: 0, n: 0, footOk: 0, sT: -1, parts: [] };
      mv.addEventListener('load', function () {
        var c = mv.getBoundingBoxCenter(), d = mv.getDimensions();
        mv.updateHotspot({ name: 'hotspot-foot', position: c.x + 'm ' + (c.y - d.y / 2) + 'm ' + c.z + 'm' });
        if (o.top) mv.updateHotspot({ name: 'hotspot-top', position: c.x + 'm ' + (c.y + d.y / 2) + 'm ' + c.z + 'm' });
        // Erst platzieren (unsichtbar), dann einblenden – kein sichtbarer Sprung (tick: o.rdy)
        o.footOk = 1; o.n = 0; o.rdy = 0; o.ok = 0; o.tries = 0; mv.style.transition = 'none'; mv.style.opacity = 0;
      });
      mv.addEventListener('camera-change', function (e) { if (e.detail && e.detail.source === 'user-interaction') { o.touched = performance.now(); hold(); } });
      mv.addEventListener('pointerdown', function (e) { if (e.pointerType === 'mouse') hold(); });
      o.bs.forEach(function (b, j) { b.addEventListener('click', function () { hold(); o.touched = 0; pick(o, j); }); });
      return o;
    });
    function load(o) { if (!o) return; var s = o.mv.src || o.mv.dataset.src || (o.bs[0] && o.bs[0].dataset.src); if (s && o.mv.src !== s) o.mv.src = s; }
    function pick(o, j) {
      o.i = j % o.bs.length; var b = o.bs[o.i];
      o.bs.forEach(function (x, k) { x.classList.toggle('on', k === o.i); });
      if (b.dataset.base) o.base = +b.dataset.base;
      o.t0 = performance.now(); o.footOk = 0;
      if (b.dataset.src && o.mv.src !== b.dataset.src) { if (o.slam && !still) o.mv.style.opacity = 0; o.mv.src = b.dataset.src; }
      else if (o.slam) slam(o, o.t0);
    }
    function slam(o, t) { if (still) { o.mv.style.opacity = 1; return; } o.sT = t; o.hit = 0; o.t0 = t + 900; o.mv.style.setProperty('--sy', '-300px'); o.mv.style.opacity = 1; }
    // Fußpunkt des Modells (Hotspot) auf die Bodenlinie des Hintergrundbilds setzen.
    // 12.11.2026: Produktgruppe (Modell + Buttons + Badge) auf Desktop Richtung ~63 % der Hero-Breite (nie in den Text),
    // und so hoch begrenzt, dass die Buttons mind. 16 px über der festen Pfeil-/Punkte-Zeile enden.
    function txr(sl) { var m = 0; [].forEach.call(sl.querySelectorAll('.h3-text > *'), function (e) { var g = document.createRange(); g.selectNodeContents(e); m = Math.max(m, g.getBoundingClientRect().right); }); return m; }
    function fit(o) {
      var r = o.sl.getBoundingClientRect(), b = o.box.getBoundingClientRect(), k = b.height / o.box.offsetHeight || 1, sh = parseFloat(o.box.style.left) || 0, nx = 0;
      if (innerWidth > 860) {
        var c0 = b.left + b.width / 2 - sh, bl = 1e9; [].forEach.call(o.bs, function (x) { bl = Math.min(bl, x.getBoundingClientRect().left - sh); });
        var dl = c0 - Math.min(bl, c0 - 150 * k), want = Math.max(r.left + r.width * .635, txr(o.sl) + 32 + dl);
        nx = Math.min(0, want - c0);
      }
      if (Math.abs(nx - sh) > .5) { o.box.style.left = nx.toFixed(1) + 'px'; b = o.box.getBoundingClientRect(); }
      var f = o.foot.getBoundingClientRect();
      if (!f.width && !f.height && !f.top) return NaN;
      var sc = Math.max(r.width / IW, r.height / IH), ih = IH * sc, cy = r.top + r.height / 2, fl = innerWidth <= 860 ? +o.sl.dataset.floorM || .8 : +o.sl.dataset.floor || .75;
      var ty = cy + (r.top + (r.height - ih) / 2 + fl * ih - cy) * 1.04, fy = f.top + f.height / 2 - (parseFloat(o.mv.style.getPropertyValue('--sy')) || 0) * k;
      var tabs = o.box.querySelector('.m3-tabs'), ctl = h.querySelector('.ch-ctrl');
      // Text links (Headline/CTA) bei niedrigem Hero etwas anheben, damit die CTA nie in die Pfeil-Zeile ragt
      var tx = o.sl.querySelector('.h3-text'), cr = ctl && ctl.getBoundingClientRect();
      if (tx && cr && innerWidth > 860) { var t0 = parseFloat(tx.style.top) || 0, xb = 0, xr = 0;
        [].forEach.call(tx.querySelectorAll('.h3-btns a'), function (a) { var q = a.getBoundingClientRect(); xb = Math.max(xb, q.bottom - t0); xr = Math.max(xr, q.right); });
        var lift = xr > cr.left - 16 ? Math.max(0, Math.min(xb - (cr.top - 16), tx.getBoundingClientRect().top - t0 - r.top - 16)) : 0;
