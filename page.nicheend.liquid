function ages(){const d=new Date(bday.value+"T00:00:00");const days=(Date.now()-d)/864e5;
 if(!bday.value||isNaN(days)||days<0){agesEl.innerHTML="";note.textContent="Bitte ein gültiges Datum in der Vergangenheit eingeben.";return;}
 note.textContent=bday.value==="1996-05-14"?"Beispiel: 14.05.1996":Math.floor(days).toLocaleString("de-DE")+" Tage auf der Erde";
 agesEl.innerHTML=ORB.map(([id,n,p])=>{const pp=P.find(x=>x.id===id);return `<a class="ag" href="#${id}" style="--c:${pp.c}">${globe(pp)}<b>${n}</b><span>${fmt(days/p)}<small>Jahre</small></span></a>`;}).join("");}
bday.addEventListener("input",ages);ages();

/* Kompass */
const all=[...P,...B];const res=document.getElementById("result");
function show(k){document.querySelectorAll(".chip").forEach(c=>c.setAttribute("aria-pressed",c.dataset.k===k));
 res.innerHTML=all.filter(p=>p.k.includes(k)).map(p=>`<a class="r-item" href="#${p.id}" style="--c:${p.c}"><span class="dot"><img src="${F("cut/"+p.id+".png")}" alt=""></span><span><b>${esc(p.n)}</b><em>${esc(p.tag)}</em></span></a>`).join("");}
document.querySelectorAll(".chip").forEach(c=>c.onclick=()=>show(c.dataset.k));show("floral");
</script>
{% endraw %}
</body>
</html>
