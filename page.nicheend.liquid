<style>
/* Layout: festes 3D-Weltall hinter der Seite. Beim Scrollen fliegt die Kamera von Station zu Station, nach Pluto folgt ein Hyperraum-Sprung ins tiefe All. Unten ein Entfernungslineal in AE */
:root{
  --void:#05070F; --glass:rgba(6,8,18,.66); --ink:#ECE8F4; --dim:#A09DB8; --faint:#66647F;
  --gold:#C9A46A; --line:rgba(236,232,244,.13);
  --f-display:"Michroma","Eurostile","Arial Black",sans-serif;
  --f-body:"Instrument Sans","Helvetica Neue",Arial,sans-serif;
  --f-data:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--void);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.6;margin:0;padding-block:0 90px;overflow-x:hidden}
.pad{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
#stars,#solar{position:fixed;inset:0;width:100%;height:100%;display:block}
#stars{z-index:0;pointer-events:none}
#solar{z-index:1;cursor:grab;touch-action:pan-y}
#flash{position:fixed;inset:0;background:#EAF0FF;opacity:0;pointer-events:none;z-index:3}
main{position:relative;z-index:2;pointer-events:none}
main a,main button,main input,main .panel,main .card,main .port,main .r-item{pointer-events:auto}
.wrap{max-width:1180px;margin:0 auto}
a{color:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.panel{background:var(--glass);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);border:1px solid var(--line)}

/* Hero */
.hero{height:clamp(560px,88vh,880px);position:relative}
.hero-copy{padding-block:44px 0}
.hero-copy .inner{max-width:500px;padding:28px 30px;pointer-events:auto}
.brandline{font-family:var(--f-data);font-size:12px;letter-spacing:.18em;color:var(--gold);text-transform:uppercase}
h1{font-family:var(--f-display);font-weight:400;font-size:clamp(24px,3vw,40px);line-height:1.14;letter-spacing:.04em;margin:14px 0 12px;text-wrap:balance}
.lede{color:var(--dim);max-width:40ch;margin:0 0 22px}
.cta{display:inline-flex;gap:10px;align-items:center;border:1px solid var(--gold);color:var(--ink);text-decoration:none;padding:11px 18px;font-size:14px;letter-spacing:.06em;background:rgba(5,7,15,.5);transition:background .2s;cursor:pointer;font-family:inherit}
.cta:hover{background:rgba(201,164,106,.16)}
.labels{position:fixed;inset:0;pointer-events:none;z-index:2;transition:opacity .3s}
.lbl{position:absolute;transform:translate(-50%,0);pointer-events:auto;background:none;border:0;color:var(--ink);font-family:var(--f-data);font-size:10px;letter-spacing:.14em;padding:4px 6px;cursor:pointer;white-space:nowrap;opacity:.78;text-shadow:0 1px 6px #000}
.lbl:hover,.lbl:focus-visible{opacity:1;color:var(--gold)}
.hero-note{position:absolute;right:0;bottom:16px;font-family:var(--f-data);font-size:11px;color:var(--faint);text-align:right;line-height:1.5}

.intro{padding:28px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.intro h2{font-family:var(--f-display);font-weight:400;font-size:13px;letter-spacing:.14em;color:var(--gold);margin:0 0 8px}
.intro p{margin:0;color:var(--dim);font-size:15px}
.chapter{font-family:var(--f-data);font-size:12px;letter-spacing:.2em;color:var(--dim);text-transform:uppercase;padding-block:64px 10px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;text-shadow:0 1px 8px #000}

/* Stationen: Text links, Planet rechts im Raum, Flakon im Bullauge */
.station{min-height:118vh;display:grid;grid-template-columns:minmax(0,520px) minmax(0,1fr);gap:32px;align-items:center;padding-block:10vh}
.station .panel{padding:28px 30px;min-width:0}
.port{width:min(56vw,230px);aspect-ratio:420/600;position:relative}
.port::before{content:"";position:absolute;inset:6% -18% -4%;border-radius:50%;background:radial-gradient(closest-side,var(--c),transparent 72%);opacity:.75;filter:blur(26px)}
.port::after{content:"";position:absolute;inset:20% 22% 8%;border-radius:40%;background:radial-gradient(closest-side,rgba(255,250,240,.55),transparent);filter:blur(22px);z-index:0}
.port img{position:relative;z-index:1;width:100%;height:100%;object-fit:contain;display:block;filter:drop-shadow(0 0 18px var(--c)) drop-shadow(0 0 2px rgba(255,255,255,.35)) drop-shadow(0 22px 26px rgba(0,0,0,.55))}
.station .port{justify-self:start;align-self:start;position:sticky;top:calc(50vh - 190px);margin-left:-2%}
.head{display:flex;align-items:center;gap:14px}
.globe{flex:none;width:44px;aspect-ratio:1;border-radius:50%;background-repeat:repeat-x;background-size:200% 100%;
  box-shadow:inset -12px -5px 16px rgba(0,0,0,.88),inset 4px 2px 8px rgba(255,255,255,.12);animation:spin 26s linear infinite}
.globe.sun{box-shadow:inset -6px -4px 14px rgba(120,0,0,.6),0 0 22px 4px rgba(230,40,20,.5);animation-duration:40s}
@keyframes spin{to{background-position:-200% 0}}
.dist{font-family:var(--f-data);font-size:13px;color:var(--gold);letter-spacing:.06em;font-variant-numeric:tabular-nums}
.station h3{font-family:var(--f-display);font-weight:400;font-size:clamp(26px,4.4vw,48px);letter-spacing:.14em;margin:14px 0 4px;line-height:1.1;white-space:nowrap}
.tag{color:var(--ink);font-size:18px;margin:0 0 14px}
.fact{color:var(--dim);margin:0 0 24px;max-width:52ch;padding-left:14px;border-left:2px solid var(--c)}
.layers{display:grid;margin:0 0 24px;border-top:1px solid var(--line)}
.layer{display:grid;grid-template-columns:130px minmax(0,1fr);gap:16px;padding:11px 0;border-bottom:1px solid var(--line)}
.layer dt{font-family:var(--f-data);font-size:12px;line-height:1.5;color:var(--faint);letter-spacing:.04em}
.layer dt b{display:block;color:var(--dim);font-weight:500}
.layer dd{margin:0;font-size:15px}
.buy{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
.price{font-family:var(--f-data);font-size:15px;font-variant-numeric:tabular-nums}
.price small{color:var(--faint);margin-left:6px}
.soldout{font-family:var(--f-data);font-size:12px;color:var(--dim);border:1px solid var(--line);padding:4px 10px}

/* Jenseits */
.warpzone{height:120vh}
.beyond{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);margin-top:32px}
.card{background:rgba(6,8,18,.74);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);padding:28px 24px 26px;display:grid;gap:10px;align-content:start;min-width:0}
.card .port{width:min(48vw,170px);margin-bottom:4px}
.card h3{font-family:var(--f-display);font-weight:400;font-size:clamp(16px,1.7vw,20px);letter-spacing:.16em;margin:0;white-space:nowrap}
.card .tag{font-size:15px;margin:0}
.card .fact{font-size:14px;margin:0}
.card .notes{font-size:13px;color:var(--dim);margin:0}
.card .buy{margin-top:6px}

/* Planetenalter */
.age{margin-top:72px;padding:30px}
.age h2,.compass h2{font-family:var(--f-display);font-weight:400;font-size:clamp(20px,2.8vw,30px);letter-spacing:.08em;margin:0 0 8px}
.age p,.compass p{color:var(--dim);margin:0 0 18px;max-width:62ch}
.age-form{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin-bottom:22px}
.age-form label{display:grid;gap:6px;font-family:var(--f-data);font-size:12px;color:var(--dim);letter-spacing:.06em}
.age-form input{background:rgba(255,255,255,.05);border:1px solid var(--line);color:var(--ink);font:inherit;font-size:16px;padding:10px 12px;color-scheme:dark}
.age-note{font-family:var(--f-data);font-size:12px;color:var(--faint)}
.ages{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
.ag{background:rgba(6,8,18,.8);padding:16px;display:grid;grid-template-columns:auto minmax(0,1fr);gap:4px 14px;align-items:center;text-decoration:none}
.ag:hover{background:rgba(201,164,106,.1)}
.ag .globe{grid-row:span 2;width:40px}
.ag b{font-family:var(--f-display);font-weight:400;font-size:12px;letter-spacing:.14em}
.ag span{font-family:var(--f-data);font-size:20px;font-variant-numeric:tabular-nums}
.ag span small{font-size:12px;color:var(--dim);margin-left:4px}

.compass{margin-top:32px;padding:30px}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:22px}
.chip{background:transparent;color:var(--ink);border:1px solid var(--line);padding:9px 16px;font:inherit;font-size:14px;cursor:pointer;border-radius:999px}
.chip[aria-pressed="true"]{border-color:var(--gold);background:rgba(201,164,106,.14)}
.result{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;min-height:120px}
.r-item{display:flex;gap:12px;align-items:center;min-width:0;text-decoration:none;border:1px solid var(--line);padding:8px 16px 8px 8px;border-radius:999px;background:rgba(6,8,18,.6)}
.r-item:hover{border-color:var(--gold)}
.r-item .dot{width:44px;height:62px;flex:none;filter:drop-shadow(0 0 10px var(--c))}
.r-item img{width:100%;height:100%;object-fit:contain}
.r-item b{font-family:var(--f-display);font-weight:400;letter-spacing:.16em;font-size:13px}
.r-item em{display:block;font-style:normal;color:var(--dim);font-size:12px}
.r-item>span:last-child{min-width:0}

footer{margin-top:40px;border-top:1px solid var(--line);padding-block:30px;color:var(--faint);font-size:13px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}

.ruler{position:fixed;left:0;right:0;bottom:0;z-index:20;background:rgba(5,7,15,.88);backdrop-filter:blur(8px);border-top:1px solid var(--line);
  padding:10px max(16px,env(safe-area-inset-right,0px)) calc(10px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px))}
.ruler-in{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:auto minmax(0,1fr);gap:20px;align-items:center}
.r-read{font-family:var(--f-data);font-size:12px;color:var(--dim);white-space:nowrap;font-variant-numeric:tabular-nums}
.r-read strong{color:var(--ink);font-weight:500;font-size:14px;margin-right:6px}
#scale{width:100%;height:34px;display:block}

@media (max-width:1080px) and (min-width:821px){.result{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:820px){
  .hero{height:auto;min-height:100vh}
  .hero-copy{padding-block:20px 0}
  .hero-copy .inner{padding:20px}
  .hero-note{display:none}
  .intro{grid-template-columns:minmax(0,1fr)}
  .station{grid-template-columns:minmax(0,1fr);gap:18px;padding-block:44vh 8vh;min-height:auto}
  .station .port{justify-self:end;order:-1;width:140px;margin:0 6% 0 0;position:relative;top:auto}
  .station .panel{padding:22px 20px}
  .layer{grid-template-columns:100px minmax(0,1fr)}
  .beyond{grid-template-columns:minmax(0,1fr)}
  .ages{grid-template-columns:repeat(2,minmax(0,1fr))}
  .result{grid-template-columns:minmax(0,1fr)}
  .ruler-in{grid-template-columns:minmax(0,1fr);gap:4px}
  .lbl{font-size:9px}
}
@media (prefers-reduced-motion:reduce){.globe{animation:none}}
</style>

