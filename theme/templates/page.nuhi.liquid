<script>
(function(){var T=window.NUT;if(!T||window.NUL==='de')return;
  var w=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT),ns=[];while(w.nextNode())ns.push(w.currentNode);
  ns.forEach(function(n){var v=n.nodeValue,k=v.replace(/\s+/g,' ').trim();if(!k)return;var t=T(k);if(t!==k)n.nodeValue=t});
  ['aria-label','alt'].forEach(function(a){document.querySelectorAll('['+a+']').forEach(function(e){e.setAttribute(a,T(e.getAttribute(a)))})});
})();
</script>
<script>
(function(){
  var still=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var film=document.querySelector('[data-film]');
  var layers=[].slice.call(film.querySelectorAll('.layer'));
  var caps=[].slice.call(film.querySelectorAll('.cap'));
  var acts=[].slice.call(film.querySelectorAll('.acts a'));
  var cue=film.querySelector('.cue');
  var N=layers.length, cur=-1, target=0, raf=0;
  function clamp(v){return v<0?0:v>1?1:v}
  function progress(){
    var r=film.getBoundingClientRect(),span=film.offsetHeight-innerHeight;
    return clamp(-r.top/Math.max(1,span))*(N-1);
  }
  function paint(p){
    layers.forEach(function(l,i){
      // each picture dissolves in over the one before it and is dropped once the next one covers it
      var o=i===0?1:clamp((p-(i-.72))/.44), covered=p>i+.8;
      var show=o>0&&!covered;
      l.style.visibility=show?'visible':'hidden';
      if(show){l.style.opacity=o.toFixed(3);l.style.setProperty('--z',(1.08-clamp((p-i+.72)/1.5)*.08).toFixed(4))}
      var v=l.querySelector('video');
      if(v){
        var near=Math.abs(p-i)<1.6, live=Math.abs(p-i)<.95;
        if(near&&!v.src&&!still)v.src=v.dataset.v;
        if(v.src){if(live&&!still){if(v.paused){var pr=v.play();if(pr)pr.catch(function(){})}}else if(!v.paused)v.pause()}
      }
    });
    caps.forEach(function(c,i){
      var d=Math.abs(p-i), o=clamp(1-(d-.16)/.22);
      c.style.visibility=o>0?'visible':'hidden';
      c.style.opacity=o.toFixed(3);
      c.style.transform='translateY('+((i-p)*46).toFixed(1)+'px)';
      c.classList.toggle('on',o>.6);
    });
    acts.forEach(function(a){a.classList.toggle('on',p>=+a.dataset.go-.5&&p<=+a.dataset.to+.5)});
    cue.style.opacity=p<.3?1:0;
  }
  function loop(){
    raf=0;
    cur+=(target-cur)*(still?1:.14);
    if(Math.abs(target-cur)<.0015)cur=target;
    paint(cur);
    if(cur!==target)raf=requestAnimationFrame(loop);
  }
  function kick(){target=progress();if(cur<0)cur=target;if(!raf)raf=requestAnimationFrame(loop)}
  addEventListener('scroll',kick,{passive:true});
  addEventListener('resize',kick);
  kick();

  acts.forEach(function(a){a.addEventListener('click',function(e){
    e.preventDefault();
    var span=film.offsetHeight-innerHeight, top=film.getBoundingClientRect().top+scrollY;
    scrollTo({top:top+span*(+a.dataset.go/(N-1)),behavior:still?'auto':'smooth'});
  })});

  // slow drifting dust over the bottle inside the horse
  document.querySelectorAll('[data-dust]').forEach(function(cv){
    if(still)return;
    var ctx=cv.getContext('2d'),ps=[],w=0,h=0,dpr=Math.min(2,devicePixelRatio||1),last=0,host=cv.parentNode;
    function size(){var r=cv.getBoundingClientRect();w=r.width;h=r.height;cv.width=w*dpr;cv.height=h*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);
      ps=[];for(var i=0;i<150;i++)ps.push({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1.8+.5,v:Math.random()*16+6,a:Math.random()*.55+.25,ph:Math.random()*6.28});}
    size();addEventListener('resize',size);
    (function tick(t){
      requestAnimationFrame(tick);
      if(host.style.visibility!=='visible'){last=t;return}
      var dt=Math.min(.05,(t-last)/1000||0);last=t;
      ctx.clearRect(0,0,w,h);
      for(var i=0;i<ps.length;i++){var p=ps[i];
        p.y+=p.v*dt;p.ph+=dt*.7;p.x+=Math.sin(p.ph)*.22;
        if(p.y>h+4){p.y=-4;p.x=Math.random()*w}
        var lit=.45+.55*Math.max(0,1-Math.abs(p.x/w-.42)*2.4);
        ctx.globalAlpha=p.a*lit;ctx.fillStyle='#f6ead2';
        ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,6.283);ctx.fill();}
    })(0);
  });

  var cards=document.querySelector('.cards'),chips=[].slice.call(document.querySelectorAll('.chip'));
  chips.forEach(function(c){c.addEventListener('click',function(){
    var on=c.getAttribute('aria-pressed')==='true';
    chips.forEach(function(x){x.setAttribute('aria-pressed','false')});
    cards.querySelectorAll('.card').forEach(function(k){k.classList.remove('on')});
    cards.classList.toggle('pick',!on);
    if(!on){c.setAttribute('aria-pressed','true');cards.querySelector('.card[data-k="'+c.dataset.k+'"]').classList.add('on')}
  })});
})();
</script>
