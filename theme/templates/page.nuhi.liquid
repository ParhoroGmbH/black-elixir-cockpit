{%- layout none -%}
{%- assign nu_l = request.locale.iso_code | slice: 0, 2 -%}
{%- if routes.root_url == '/' -%}{%- assign nu_shop = '/products/' -%}{%- else -%}{%- assign nu_shop = routes.root_url | append: '/products/' -%}{%- endif -%}
{%- assign nu_p1 = all_products['nuhi-paris-trojan-horse-eau-de-parfum'] -%}{%- capture nu_pr1 -%}{%- if nu_p1 != empty and nu_p1.price -%}{{ nu_p1.price | money_without_currency | strip_html | strip }} €{%- else -%}229,95 €{%- endif -%}{%- endcapture -%}
{%- assign nu_p2 = all_products['nuhi-paris-oud-eau-de-parfum-100-ml'] -%}{%- capture nu_pr2 -%}{%- if nu_p2 != empty and nu_p2.price_min -%}{{ nu_p2.price_min | money_without_currency | strip_html | strip }} €{%- else -%}66,35 €{%- endif -%}{%- endcapture -%}
{%- assign nu_p3 = all_products['nuhi-paris-nuhi-intense-eau-de-parfum'] -%}{%- capture nu_pr3 -%}{%- if nu_p3 != empty and nu_p3.price -%}{{ nu_p3.price | money_without_currency | strip_html | strip }} €{%- else -%}66,35 €{%- endif -%}{%- endcapture -%}
{%- assign nu_p4 = all_products['nuhi-paris-nuhi-eau-de-toilette'] -%}{%- capture nu_pr4 -%}{%- if nu_p4 != empty and nu_p4.price -%}{{ nu_p4.price | money_without_currency | strip_html | strip }} €{%- else -%}79,95 €{%- endif -%}{%- endcapture -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% if nu_l == 'ar' or nu_l == 'he' %} class="nu-rtl{% if nu_l == 'ar' %} nu-ar{% endif %}" dir="ltr"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Nuhi Paris – {% case nu_l %}{% when 'en' %}Trojan Horse, Oud, Nuhi and Intense{% when 'fr' %}Trojan Horse, Oud, Nuhi et Intense{% when 'it' %}Trojan Horse, Oud, Nuhi e Intense{% when 'da' %}Trojan Horse, Oud, Nuhi og Intense{% when 'ar' %}Trojan Horse وOud وNuhi وIntense{% when 'he' %}Trojan Horse, Oud, Nuhi ו-Intense{% else %}Trojan Horse, Oud, Nuhi und Intense{% endcase %} | BLACK ELIXIR</title>
<meta name="description" content="{% case nu_l %}{% when 'en' %}Nuhi Paris at BLACK ELIXIR: Trojan Horse, Oud, Nuhi Eau de Toilette and Nuhi Intense – four fragrances from the house of fashion designer Fehmi Nouhi, with top, heart and base notes.{% when 'fr' %}Nuhi Paris chez BLACK ELIXIR : Trojan Horse, Oud, Nuhi Eau de Toilette et Nuhi Intense – quatre parfums de la maison du créateur de mode Fehmi Nouhi, avec notes de tête, de cœur et de fond.{% when 'it' %}Nuhi Paris da BLACK ELIXIR: Trojan Horse, Oud, Nuhi Eau de Toilette e Nuhi Intense – quattro profumi della maison dello stilista Fehmi Nouhi, con note di testa, di cuore e di fondo.{% when 'da' %}Nuhi Paris hos BLACK ELIXIR: Trojan Horse, Oud, Nuhi Eau de Toilette og Nuhi Intense – fire dufte fra modedesigneren Fehmi Nouhis hus, med top-, hjerte- og basisnoter.{% when 'ar' %}Nuhi Paris لدى BLACK ELIXIR: Trojan Horse وOud وNuhi Eau de Toilette وNuhi Intense – أربعة عطور من دار مصمّم الأزياء فهمي نوهي، مع نوتات المقدمة والقلب والقاعدة.{% when 'he' %}Nuhi Paris ב-BLACK ELIXIR: Trojan Horse, Oud, Nuhi Eau de Toilette ו-Nuhi Intense – ארבעה בשמים מבית מעצב האופנה פהמי נוהי, עם תווים עליונים, תווי לב ותווי בסיס.{% else %}Nuhi Paris bei BLACK ELIXIR: Trojan Horse, Oud, Nuhi Eau de Toilette und Nuhi Intense – vier Düfte aus dem Haus des Modedesigners Fehmi Nouhi, mit Kopf-, Herz- und Basisnoten.{% endcase %}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="image" href="{{ 'nuhi-horse2.webp' | asset_url }}" fetchpriority="high">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Forum&family=Inter:wght@300;400;500;600&display=swap">
{{ content_for_header }}
{% render 'nuhi-i18n' %}
<style>
:root{
  --black:#000; --fog:#9a958d; --bone:#f2efe9; --ember:#c9954f; --ember2:#e8c488;
  --disp:"Forum","Trajan Pro",Georgia,serif;
  --ar:"Aref Ruqaa","Amiri",serif;
  --sans:"Inter",system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{margin:0;background:var(--black);color:var(--bone);font:300 17px/1.75 var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip}
h1,h2,h3,p{margin:0;font-weight:400}
img,video{display:block}
a{color:inherit}
.wrap{width:min(1280px,100%);margin-inline:auto;padding-inline:clamp(20px,5vw,64px)}
.eyebrow{display:flex;align-items:center;gap:13px;font:400 11.5px/1 var(--sans);letter-spacing:.34em;text-transform:uppercase;color:var(--ember)}
.eyebrow::before{content:"";width:clamp(20px,3.4vw,40px);height:1px;background:var(--ember);opacity:.75;flex:none}
.eyebrow em{font-family:var(--ar);font-style:normal;font-size:17px;letter-spacing:0;text-transform:none;color:var(--ember2);opacity:.85;direction:rtl}
.btn{display:inline-block;padding:19px 42px;background:var(--bone);color:#0a0a0a;border:1px solid var(--bone);font:500 12px/1 var(--sans);letter-spacing:.26em;text-transform:uppercase;text-decoration:none;transition:background .3s,color .3s}
.btn:hover{background:transparent;color:var(--bone)}
.btn:focus-visible,.chip:focus-visible,.card:focus-visible,.acts a:focus-visible{outline:1px solid var(--ember);outline-offset:4px}

/* ---------- film grain ---------- */
.grain{position:fixed;inset:-50%;z-index:9;pointer-events:none;opacity:.055;mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='180' height='180'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3'/%3E%3C/filter%3E%3Crect width='180' height='180' filter='url(%23n)'/%3E%3C/svg%3E");
  animation:grain 1.1s steps(3) infinite}
@keyframes grain{0%{transform:translate(0,0)}33%{transform:translate(-2%,1%)}66%{transform:translate(1%,-2%)}}

/* ---------- the film: one pinned stage, every picture dissolves into the next ---------- */
.film{position:relative;height:calc(var(--n)*100vh)}
.stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;background:#000}
.layer{position:absolute;inset:0;opacity:0;visibility:hidden;will-change:opacity}
.layer:first-child{opacity:1;visibility:visible}
.layer>video,.layer>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:var(--pos,50% 50%);transform:scale(var(--z,1.06));will-change:transform}
.layer::after{content:"";position:absolute;inset:0;background:var(--scrim,none)}
.layer.l::after{--scrim:linear-gradient(90deg,#000000eb 0,#000000a8 32%,#0000 62%),linear-gradient(0deg,#00000099,#0000 36%)}
.layer.r::after{--scrim:linear-gradient(270deg,#000000eb 0,#000000a8 32%,#0000 62%),linear-gradient(0deg,#00000099,#0000 36%)}
.dust{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;mix-blend-mode:screen;z-index:1}

.caps{position:absolute;inset:0;z-index:3;pointer-events:none}
.cap{position:absolute;inset:0;display:grid;align-items:center;opacity:0;visibility:hidden;will-change:opacity,transform}
.cap>.wrap{display:grid}
.cap__in{width:min(var(--cw,470px),100%);justify-self:start}
.cap.r .cap__in{justify-self:end}
.cap.top{align-items:start}
.cap.top .cap__in{padding-top:clamp(96px,15svh,180px)}
.cap.on{pointer-events:auto}
.cap h1{font:400 clamp(44px,7.8vw,124px)/.98 var(--disp);letter-spacing:.1em;text-transform:uppercase;margin:24px 0 8px}
.cap h2{font:400 clamp(36px,5.2vw,78px)/1.03 var(--disp);letter-spacing:.015em;margin:22px 0 4px;text-wrap:balance}
.cap h2.name{text-transform:uppercase;letter-spacing:.1em;font-size:clamp(38px,5.8vw,92px)}
.cap .arh{font-family:var(--ar);font-size:clamp(28px,3.6vw,52px);line-height:1.6;color:var(--ember2);direction:rtl;margin-bottom:16px}
.cap h1+.arh{font-size:clamp(36px,5.6vw,80px);line-height:1.5;margin-bottom:22px}
.cap p{color:#e4e0d8d9;font-size:clamp(15px,1.2vw,18px);max-width:40ch}
.cap .list{margin-top:22px;padding-top:18px;border-top:1px solid #ffffff2b;color:var(--fog);font-size:14.5px;line-height:2.05;letter-spacing:.02em;max-width:34ch}
.price{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:10px 20px;margin:26px 0 26px;padding-block:18px;border-top:1px solid #ffffff2b;border-bottom:1px solid #ffffff2b}
.price b{font:400 clamp(34px,3.8vw,52px)/1 var(--disp);font-variant-numeric:lining-nums}
.price span{color:var(--fog);font:400 11px/1 var(--sans);letter-spacing:.26em;text-transform:uppercase}

.mark{position:absolute;z-index:4;top:calc(26px + env(safe-area-inset-top,0px));left:0;right:0;text-align:center;font:400 11.5px/1 var(--sans);letter-spacing:.42em;text-indent:.42em;text-transform:uppercase;color:#f2efe9b8;pointer-events:none}
.acts{position:absolute;z-index:4;right:calc(clamp(14px,2.6vw,36px) + 132px);top:calc(14px + env(safe-area-inset-top,0px));display:flex;gap:clamp(14px,2vw,30px);align-items:center}
.acts a{display:flex;align-items:center;gap:10px;text-decoration:none;font:400 10px/1 var(--sans);letter-spacing:.24em;text-transform:uppercase;color:#f2efe966;transition:color .4s}
.acts a{padding-block:8px;border-bottom:1px solid #0000}
.acts a.on{color:var(--ember2);border-bottom-color:var(--ember)}
.cue{position:absolute;z-index:4;left:0;right:0;bottom:clamp(22px,4.5vh,46px);display:grid;justify-items:center;gap:12px;font:400 10.5px/1 var(--sans);letter-spacing:.3em;text-transform:uppercase;color:#f2efe980;pointer-events:none;transition:opacity .5s}
.cue i{display:block;width:1px;height:38px;background:linear-gradient(#f2efe9,#f2efe900);animation:cue 2.4s ease-in-out infinite}
@keyframes cue{50%{transform:translateY(9px)}}

/* ---------- maison ---------- */
.maison{position:relative;overflow:hidden}
.maison>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:70% 50%;opacity:.7}
.maison::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#000000f5 0,#000000c2 34%,#00000040 70%),linear-gradient(180deg,#000,#0000 22%,#0000 78%,#000)}
.maison .wrap{position:relative;z-index:1;padding-block:clamp(110px,15vw,210px)}
.maison__copy{width:min(500px,100%)}
.maison h2{font:400 clamp(32px,4.4vw,64px)/1.05 var(--disp);letter-spacing:.02em;margin:20px 0 18px}
.maison p{color:#e4e0d8cc;max-width:40ch}
.maison p+p{margin-top:14px}

/* ---------- family ---------- */
.fam{padding-block:clamp(84px,11vw,160px);border-top:1px solid #ffffff1a}
.fam__top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:24px;margin-bottom:clamp(32px,4.5vw,58px)}
.fam h2{font:400 clamp(30px,4.2vw,58px)/1.05 var(--disp);letter-spacing:.02em}
.fam h2 b{font-weight:400;text-transform:uppercase;letter-spacing:.2em}
.fam .ar{font-family:var(--ar);direction:rtl;font-size:clamp(17px,2vw,26px);line-height:1.9;color:var(--ember2);opacity:.8;margin-top:6px}
.chips{display:flex;flex-wrap:wrap;gap:9px}
.chip{font:400 11.5px/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;padding:14px 19px;border:1px solid #ffffff2b;background:none;color:#e4e0d8;cursor:pointer;transition:.25s}
.chip:hover{border-color:#ffffff73}
.chip[aria-pressed=true]{background:var(--bone);color:#0a0a0a;border-color:var(--bone)}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(10px,1.4vw,20px)}
.card{display:flex;flex-direction:column;text-decoration:none;transition:opacity .35s}
.card__img{aspect-ratio:4/5;overflow:hidden;background:#050505;margin-bottom:20px}
.card__img img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.1,1)}
.card:hover .card__img img{transform:scale(1.05)}
.card h3{font:400 clamp(20px,1.9vw,26px)/1.1 var(--disp);letter-spacing:.04em}
.card p{color:var(--fog);font-size:13.5px;line-height:1.65;margin:8px 0 16px;flex:1}
.card__row{display:flex;flex-wrap:wrap;gap:4px 10px;justify-content:space-between;align-items:baseline;padding-top:13px;border-top:1px solid #ffffff1f;font-size:12px;letter-spacing:.08em;color:var(--fog)}
.card__row b{font:400 18px/1 var(--disp);color:var(--bone);letter-spacing:0}
.cards.pick .card{opacity:.3}
.cards.pick .card.on{opacity:1}

/* ---------- proof band ---------- */
.proof{position:relative;overflow:hidden;border-top:1px solid #ffffff1a}
.proof>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.22}
.proof::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#000 0,#000000d9 30%,#000000d9 70%,#000 100%)}
.proof .wrap{position:relative;z-index:1;padding-block:clamp(48px,6vw,84px)}
.proof h3{text-align:center;font:400 11px/1 var(--sans);letter-spacing:.3em;text-transform:uppercase;color:var(--fog);margin-bottom:26px}
.proof__row{display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;gap:clamp(22px,5vw,78px)}
.proof__row div{display:flex;align-items:baseline;gap:12px}
.proof__row b{font:400 clamp(30px,3.6vw,46px)/1 var(--disp);color:var(--ember2);font-variant-numeric:lining-nums}
.proof__row span{font:400 11px/1 var(--sans);letter-spacing:.26em;text-transform:uppercase;color:var(--fog)}
.src{margin-top:clamp(20px,2.6vw,32px);text-align:center;color:#9a958da6;font-size:12.5px;letter-spacing:.03em}
footer{border-top:1px solid #ffffff1a;padding-block:38px;text-align:center}
footer .ar{font-family:var(--ar);direction:rtl;font-size:19px;color:var(--ember2);opacity:.8}
footer span{display:block;margin-top:8px;font:400 11.5px/1 var(--sans);letter-spacing:.24em;text-transform:uppercase;color:var(--fog)}

@media (max-width:900px){
  .cards{grid-template-columns:1fr 1fr}
  .layer>video,.layer>img{object-position:var(--mpos,var(--pos,50% 40%))}
  .layer.l::after,.layer.r::after{--scrim:linear-gradient(0deg,#000 0,#000000d9 40%,#0000 74%)}
  .cap,.cap.top{align-items:end}
  .cap__in,.cap.r .cap__in{justify-self:start;padding-top:0!important;padding-bottom:clamp(58px,11svh,110px)}
  .acts{top:calc(58px + env(safe-area-inset-top,0px));left:0;right:0;justify-content:center;gap:16px}
  .mark{display:none}
  .acts a{font-size:9px}
  .maison::after{background:linear-gradient(0deg,#000 0,#000000d1 46%,#00000059 80%)}
  .proof__row{gap:18px 30px}
}
@media (prefers-reduced-motion:reduce){
  .grain{animation:none;opacity:.03}
  .cue i{animation:none}
}

/* ---------- shop chrome: home link, language, rtl ---------- */
.nu-home{position:fixed;z-index:60;top:calc(14px + env(safe-area-inset-top,0px));left:clamp(14px,2.6vw,36px);font:600 11px/1 Inter,system-ui,sans-serif;letter-spacing:.22em;color:#e9e3d6;text-decoration:none;padding:10px 14px;border:1px solid #ffffff33;border-radius:999px;background:#05060bb3;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.nu-home:hover{background:#fff;color:#000}
.nu-home:focus-visible{outline:1px solid var(--ember);outline-offset:3px}
.nu-rtl .cap__in,.nu-rtl .maison__copy,.nu-rtl .fam,.nu-rtl .proof,.nu-rtl footer{direction:rtl}
.nu-rtl .cap__in,.nu-rtl .maison__copy{text-align:right}
.nu-rtl .cap p,.nu-rtl .maison p{margin-inline-start:0}
.nu-ar .eyebrow em{display:none}
</style>
</head>
<body>
<a class="nu-home" href="{{ routes.root_url }}">BLACK ELIXIR</a>
{% render 'claude-lang-switch', pos: 'top:calc(14px + env(safe-area-inset-top,0px));right:clamp(14px,2.6vw,36px)' %}
<div class="film" data-film style="--n:19">
  <div class="stage">
    <!-- ACT I · TROJAN HORSE -->
    <div class="layer l" data-at="0" style="--pos:58% 50%;--mpos:56% 42%"><video muted loop playsinline preload="metadata" poster="{{ 'nuhi-horse2.webp' | asset_url }}" data-v="{{ 'nuhi-horse2.mp4' | asset_url }}"></video></div>
    <div class="layer l" data-at="1" style="--pos:62% 50%;--mpos:58% 50%"><video muted loop playsinline preload="none" poster="{{ 'nuhi-hatch.webp' | asset_url }}" data-v="{{ 'nuhi-hatch.mp4' | asset_url }}"></video></div>
    <div class="layer r" data-at="2" style="--pos:36% 50%;--mpos:30% 42%"><img src="{{ 'nuhi-c-horse.webp' | asset_url }}" alt="Nuhi Paris Trojan Horse Flakon im Inneren des hölzernen Pferdes" width="1600" height="892" loading="lazy" decoding="async"><canvas class="dust" data-dust></canvas></div>
    <div class="layer l" data-at="3" style="--pos:76% 50%;--mpos:72% 40%"><video muted loop playsinline preload="none" poster="{{ 'nuhi-frucht.webp' | asset_url }}" data-v="{{ 'nuhi-frucht.mp4' | asset_url }}"></video></div>
    <div class="layer r" data-at="4" style="--pos:20% 50%;--mpos:24% 40%"><video muted loop playsinline preload="none" poster="{{ 'nuhi-bluete.webp' | asset_url }}" data-v="{{ 'nuhi-bluete.mp4' | asset_url }}"></video></div>
    <div class="layer l" data-at="5" style="--pos:66% 50%;--mpos:66% 40%"><video muted loop playsinline preload="none" poster="{{ 'nuhi-head.webp' | asset_url }}" data-v="{{ 'nuhi-head.mp4' | asset_url }}"></video></div>
    <div class="layer l" data-at="6" style="--pos:66% 50%;--mpos:64% 40%"><video muted loop playsinline preload="none" poster="{{ 'nuhi-bloom.webp' | asset_url }}" data-v="{{ 'nuhi-bloom.mp4' | asset_url }}"></video></div>
    <div class="layer l" data-at="7" style="--pos:58% 50%;--mpos:60% 42%"><img src="{{ 'nuhi-c-box2.webp' | asset_url }}" alt="Trojan Horse Flakon vor seiner schwarzen Schachtel mit goldenem Pferde-Emblem" width="1600" height="893" loading="lazy" decoding="async"></div>
    <!-- ACT II · OUD -->
    <div class="layer l" data-at="8" style="--pos:66% 60%;--mpos:66% 60%"><video muted loop playsinline preload="none" poster="{{ 'nuhi-o1.webp' | asset_url }}" data-v="{{ 'nuhi-o1.mp4' | asset_url }}"></video></div>
    <div class="layer l" data-at="9" style="--pos:70% 50%;--mpos:72% 42%"><img src="{{ 'nuhi-p-oud-a.webp' | asset_url }}" alt="Nuhi Paris Oud Flakon auf verkohltem Holz neben Glut" width="1600" height="893" loading="lazy" decoding="async"></div>
    <div class="layer l" data-at="10" style="--pos:66% 50%;--mpos:64% 42%"><video muted loop playsinline preload="none" poster="{{ 'nuhi-o2.webp' | asset_url }}" data-v="{{ 'nuhi-o2.mp4' | asset_url }}"></video></div>
    <div class="layer r" data-at="11" style="--pos:32% 50%;--mpos:36% 42%"><img src="{{ 'nuhi-o3.webp' | asset_url }}" alt="" width="1600" height="895" loading="lazy" decoding="async"></div>
    <div class="layer r" data-at="12" style="--pos:30% 50%;--mpos:28% 42%"><img src="{{ 'nuhi-p-oud-b.webp' | asset_url }}" alt="Nuhi Paris Oud Flakon mit Kardamom und Lavendel" width="1600" height="893" loading="lazy" decoding="async"></div>
    <!-- ACT III · NUHI -->
    <div class="layer l" data-at="13" style="--pos:50% 60%;--mpos:8% 60%"><video muted loop playsinline preload="none" poster="{{ 'nuhi-n1.webp' | asset_url }}" data-v="{{ 'nuhi-n1.mp4' | asset_url }}"></video></div>
    <div class="layer l" data-at="14" style="--pos:70% 50%;--mpos:72% 42%"><img src="{{ 'nuhi-p-edt-a.webp' | asset_url }}" alt="Nuhi Eau de Toilette Flakon auf nassem Schiefer im Morgenlicht" width="1600" height="893" loading="lazy" decoding="async"></div>
    <div class="layer l" data-at="15" style="--pos:70% 55%;--mpos:68% 45%"><video muted loop playsinline preload="none" poster="{{ 'nuhi-n2.webp' | asset_url }}" data-v="{{ 'nuhi-n2.mp4' | asset_url }}"></video></div>
    <div class="layer l" data-at="16" style="--pos:66% 50%;--mpos:64% 42%"><img src="{{ 'nuhi-n4.webp' | asset_url }}" alt="" width="1600" height="895" loading="lazy" decoding="async"></div>
    <div class="layer r" data-at="17" style="--pos:30% 50%;--mpos:28% 42%"><img src="{{ 'nuhi-p-edt-b.webp' | asset_url }}" alt="Nuhi Eau de Toilette Flakon auf Zedernholz mit Minze" width="1600" height="893" loading="lazy" decoding="async"></div>
    <!-- CODA · INTENSE -->
    <div class="layer l" data-at="18" style="--pos:22% 50%;--mpos:50% 30%"><img src="{{ 'nuhi-p-trio.webp' | asset_url }}" alt="Nuhi Intense, drei Flakons zu 11 ml" width="1600" height="893" loading="lazy" decoding="async"></div>

    <div class="mark">Nuhi Paris</div>
    <nav class="acts" aria-label="Düfte">
      <a href="#trojan" data-go="0" data-to="7">Trojan Horse</a>
      <a href="#oud" data-go="8" data-to="12">Oud</a>
      <a href="#nuhi" data-go="13" data-to="17">Nuhi</a>
      <a href="#intense" data-go="18" data-to="18">Intense</a>
