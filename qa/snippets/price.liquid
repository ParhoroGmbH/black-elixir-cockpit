{%- comment -%} BE KW45-2 02.11.2026: UVP-Kennzeichnung + kein SALE-Badge nur in Kollektion luxus-adventskalender (Tag be-echter-sale = echter Rabatt -> SALE bleibt) {%- endcomment -%}
{%- liquid
  assign be_uvp_scope = false
  if template.name == 'collection' and collection.handle == 'luxus-adventskalender'
    assign be_uvp_scope = true
  endif
  assign be_echter_sale = false
  if product.tags contains 'be-echter-sale'
    assign be_echter_sale = true
  endif
-%}
{%- comment -%} BE UVP-Ausblendung 03.11.2026 (CEO): Streichpreis + SALE-Badges nur fuer Ausnahme-Marken (snippets/be-uvp-ausnahme.liquid). Sonst nur Verkaufspreis. {%- endcomment -%}
{%- capture be_uvp_ausnahme -%}{%- render 'be-uvp-ausnahme', vendor: product.vendor -%}{%- endcapture -%}
{%- liquid
  assign be_show_uvp = false
  if be_uvp_ausnahme contains 'ja'
    assign be_show_uvp = true
  endif
-%}
<div class="price price--{{ settings.typography_preset }} {% if in_card_product and settings.typography_preset == 'custom' and settings.product_price_size == 'default' %}{% if uppercase_price %} uppercase{% endif %}{% if bolder_price_font %} bolder-font{% endif %}{% endif %}
  {% if price_settings.text_size and price_settings.text_size != 'default' %} {{ price_settings.text_size }}{% endif %}{% if price_settings.text_size and price_settings.text_size == 'default' and settings.typography_preset == 'custom' %}{% if settings.uppercase_body_s %} uppercase{% endif %}{% if settings.bolder_font_body_s %} bolder-font{% endif %}{% endif %}">
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif
  if settings.show_first_image == false and settings.show_selected_variant_value == true
    assign target = product.selected_or_first_available_variant
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 2504
  assign available = target.available | default: false
  comment
    BE 10.11.2026: Geschenk-Seife 0-€-Anzeige nur im Theme, wenn der anrechenbare
    Warenkorb die Schwelle erreicht. Produktpreis bleibt unverändert.
  endcomment
-%}
{%- capture be_gift_preis_flag -%}{%- render 'be-geschenk-preis', product: product -%}{%- endcapture -%}
{%- liquid
  assign be_gift_preis_flag = be_gift_preis_flag | strip
  assign be_gift_show_zero = false
  assign be_gift_show_note = false
  if be_gift_preis_flag == 'ZERO'
    assign be_gift_show_zero = true
    assign be_gift_original = price
    assign price = 0
  elsif be_gift_preis_flag == 'NOTE'
    assign be_gift_show_note = true
  endif
  assign money_price = price | money
  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
  endif
  assign price_from = true
  if settings.show_first_image == false and settings.show_selected_variant_value == true
    assign price_from = false
  endif
  if price_from and target == product and product.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
-%}
  <div class="price__wrapper">
    {%- if be_gift_show_zero -%}
      <div class="price__on-sale be-gift-price be-gift-price--zero" data-be-gift-price="zero" data-be-gift-original="{{ be_gift_original }}">
        <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
        <span class="sale-price">{{ money_price }}</span>
        <span class="be-gift-price-label">Geschenk</span>
      </div>
      <div class="price__regular">
        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
        <s class="regular-price{% if settings.dim_text %} dim{% endif %}">
          {%- if settings.currency_code_enabled -%}
            {{ be_gift_original | money_with_currency }}
          {%- else -%}
            {{ be_gift_original | money }}
          {%- endif -%}
        </s>
      </div>
    {%- elsif be_show_uvp and target.compare_at_price and compare_at_price > price %}
      {% comment %}On sale - Sale price{% endcomment %}
      <div class="price__on-sale">
        <span class="visually-hidden">
          {{ 'products.product.price.sale_price' | t }}
        </span>
        <span class="sale-price">
          {{ money_price }}
        </span>
      </div>
      {%- if product.compare_at_price_varies or product.compare_at_price_max > product.price %}
        {% comment %}On sale - Regular price{% endcomment %}
        <div class="price__regular">
          <span class="visually-hidden">
            {{ 'products.product.price.regular_price' | t }}
          </span>
          {%- if be_uvp_scope -%}<span class="be-uvp-label" style="display:inline-block;text-decoration:none;font-size:.72em;line-height:1.4;letter-spacing:.06em;padding:0 4px;margin-right:5px;border:1px solid currentColor;border-radius:2px;vertical-align:middle">UVP</span>{%- endif -%}
          <s class="regular-price {% if settings.dim_text %} dim{% endif %}">{%- unless be_uvp_scope -%}<span class="regular-price-label" style="display:inline-block;text-decoration:none">{% case request.locale.iso_code %}{% when 'de' %}UVP{% when 'fr' %}Prix conseillé{% when 'it' %}Prezzo consigliato{% when 'da' %}Vejl. pris{% when 'ar' %}السعر الموصى به{% else %}RRP{% endcase %}</span>{%- endunless -%}
            {% if settings.currency_code_enabled %}
              {{ compare_at_price | money_with_currency }}
            {% else %}
              {{ compare_at_price | money }}
            {% endif %}
          </s>
          <div class="card__badges card__badges--product price-badges--{{ settings.typography_preset }} {% unless show_badges %}visually-hidden{% endunless %} {% if price_settings.badge_size != 'default' %}{{ price_settings.badge_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_label %} uppercase{% else %} none-uppercase{% endif %}{% if settings.bolder_font_label %} bolder-font{% else %} none-bolder-font{% endif %}{% endif %}{% endif %}">
            {%- liquid
              assign badge_name_1 = settings.badge_name_1 | downcase
              assign badge_name_2 = settings.badge_name_2 | downcase
              assign badge_name_3 = settings.badge_name_3 | downcase
              assign badge_name_4 = settings.badge_name_4 | downcase
            -%}
            {%- if product.available and product.selected_or_first_available_variant.metafields.custom.badge != blank -%}
              {% for badge in product.selected_or_first_available_variant.metafields.custom.badge.value %}
                {% assign badge_name = badge | downcase %}
                <span class="card__badges-item card__badges-item--metafield" 
                  {% if badge_name == badge_name_1 %}style="background-color: rgb(var(--badge-background-1)); color: rgb(var(--badge-text-1));"
                  {% elsif badge_name == badge_name_2 %}style="background-color: rgb(var(--badge-background-2)); color: rgb(var(--badge-text-2));"
                  {% elsif badge_name == badge_name_3 %}style="background-color: rgb(var(--badge-background-3)); color: rgb(var(--badge-text-3));"
                  {% elsif badge_name == badge_name_4 %}style="background-color: rgb(var(--badge-background-4)); color: rgb(var(--badge-text-4));"
                  {% elsif badge_name != badge_name_1 and badge_name != badge_name_2 and badge_name != badge_name_3 and badge_name != badge_name_4 %}style="background-color: rgb(var(--layout-text-color));"{% endif %}>
                  {{ badge }}
                </span>
              {% endfor %}
            {%- endif -%}
            {%- if product.available and product.metafields.custom.badge != blank -%}
              {% for badge in product.metafields.custom.badge.value %}
                {% assign badge_name = badge | downcase %}
                <span class="card__badges-item card__badges-item--metafield" 
                  {% if badge_name == badge_name_1 %}style="background-color: rgb(var(--badge-background-1)); color: rgb(var(--badge-text-1));"
                  {% elsif badge_name == badge_name_2 %}style="background-color: rgb(var(--badge-background-2)); color: rgb(var(--badge-text-2));"
                  {% elsif badge_name == badge_name_3 %}style="background-color: rgb(var(--badge-background-3)); color: rgb(var(--badge-text-3));"
                  {% elsif badge_name == badge_name_4 %}style="background-color: rgb(var(--badge-background-4)); color: rgb(var(--badge-text-4));"
                  {% elsif badge_name != badge_name_1 and badge_name != badge_name_2 and badge_name != badge_name_3 and badge_name != badge_name_4 %}style="background-color: rgb(var(--layout-text-color));"{% endif %}>
                  {{ badge }}
                </span>
              {% endfor %}
            {%- endif -%}
            {%- if be_show_uvp and product.available and target.compare_at_price > target.price -%}
              {%- if be_uvp_scope and be_echter_sale == false -%}<span class="card__badges-item card__badges-item--sale be-uvp-badge" style="background-color:rgb(var(--layout-text-color));">Unter UVP</span>{%- else -%}<span class="card__badges-item card__badges-item--sale">{{ 'products.product.on_sale' | t }}
              </span>{%- endif -%}
            {%- endif -%}
            {%- if product.available == false and product.selected_or_first_available_variant != 'continue' -%}
              <span class="card__badges-item card__badges-item--sold">{{ 'products.product.sold_out' | t }}
              </span>
            {%- endif -%}
            {%  if settings.show_pre_order_badge and product.template_suffix == 'preorder' %}
                <span class="card__badges-item card__badges-item--preorder">{{ 'products.product.pre_order' | t }}
                </span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

    {%- else -%}
      {% comment %}Regular price{% endcomment %}
      <div class="price__regular">
        <span class="visually-hidden">
          {{ 'products.product.price.regular_price' | t }}
        </span>
        <span class="regular-price">
          {{ money_price }}
        </span>
        {%- if be_gift_show_note -%}
          <span class="be-gift-price-note" data-be-gift-price="note">gratis ab 59&nbsp;€</span>
        {%- endif -%}
        <div class="card__badges card__badges--product price-badges--{{ settings.typography_preset }} {% unless show_badges %}visually-hidden{% endunless %}  {% if price_settings.badge_size != 'default' %}{{ price_settings.badge_size }}{% else %}{% if settings.typography_preset == 'custom' %}{% if settings.uppercase_label %} uppercase{% else %} none-uppercase{% endif %}{% if settings.bolder_font_label %} bolder-font{% else %} none-bolder-font{% endif %}{% endif %}{% endif %}">
          {%- liquid
            assign badge_name_1 = settings.badge_name_1 | downcase
            assign badge_name_2 = settings.badge_name_2 | downcase
            assign badge_name_3 = settings.badge_name_3 | downcase
            assign badge_name_4 = settings.badge_name_4 | downcase
          -%}
          {%- if product.available and product.selected_or_first_available_variant.metafields.custom.badge != blank -%}
            {% for badge in product.selected_or_first_available_variant.metafields.custom.badge.value %}
              {% assign badge_name = badge | downcase %}
              <span class="card__badges-item card__badges-item--metafield" 
                {% if badge_name == badge_name_1 %}style="background-color: rgb(var(--badge-background-1)); color: rgb(var(--badge-text-1));"
                {% elsif badge_name == badge_name_2 %}style="background-color: rgb(var(--badge-background-2)); color: rgb(var(--badge-text-2));"
                {% elsif badge_name == badge_name_3 %}style="background-color: rgb(var(--badge-background-3)); color: rgb(var(--badge-text-3));"
                {% elsif badge_name == badge_name_4 %}style="background-color: rgb(var(--badge-background-4)); color: rgb(var(--badge-text-4));"
                {% elsif badge_name != badge_name_1 and badge_name != badge_name_2 and badge_name != badge_name_3 and badge_name != badge_name_4 %}style="background-color: rgb(var(--layout-text-color));"{% endif %}>
                {{ badge }}
              </span>
            {% endfor %}
          {%- endif -%}
          {%- if product.available and product.metafields.custom.badge != blank -%}
            {% for badge in product.metafields.custom.badge.value %}
              {% assign badge_name = badge | downcase %}
              <span class="card__badges-item card__badges-item--metafield" 
                {% if badge_name == badge_name_1 %}style="background-color: rgb(var(--badge-background-1)); color: rgb(var(--badge-text-1));"
                {% elsif badge_name == badge_name_2 %}style="background-color: rgb(var(--badge-background-2)); color: rgb(var(--badge-text-2));"
                {% elsif badge_name == badge_name_3 %}style="background-color: rgb(var(--badge-background-3)); color: rgb(var(--badge-text-3));"
                {% elsif badge_name == badge_name_4 %}style="background-color: rgb(var(--badge-background-4)); color: rgb(var(--badge-text-4));"
                {% elsif badge_name != badge_name_1 and badge_name != badge_name_2 and badge_name != badge_name_3 and badge_name != badge_name_4 %}style="background-color: rgb(var(--layout-text-color));"{% endif %}>
                {{ badge }}
              </span>
            {% endfor %}
          {%- endif -%}
          {%- if be_show_uvp and product.available and target.compare_at_price > target.price -%}
            {%- if be_uvp_scope and be_echter_sale == false -%}<span class="card__badges-item card__badges-item--sale be-uvp-badge" style="background-color:rgb(var(--layout-text-color));">Unter UVP</span>{%- else -%}<span class="card__badges-item card__badges-item--sale">{{ 'products.product.on_sale' | t }}
            </span>{%- endif -%}
          {%- endif -%}
          {%- if product.available == false and product.selected_or_first_available_variant != 'continue' -%}
            <span class="card__badges-item card__badges-item--sold">{{ 'products.product.sold_out' | t }}
            </span>
          {%- endif -%}
          {%-  if settings.show_pre_order_badge and product.template_suffix == 'preorder' -%}
              <span class="card__badges-item card__badges-item--preorder">{{ 'products.product.pre_order' | t }}
              </span>
            {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%}Grundpreis (PAngV) – rendered outside the price container as plain text so it is not parsed as a competing price (GMC fix 21.10.2026). Class "unit-price" kept for theme CSS hooks; hidden inside the add-to-cart button.{%- endcomment -%}
{%- unless type == 'buy_buttons' -%}
  {%- assign unit_price_variant = product.selected_or_first_available_variant -%}
  {%- if unit_price_variant.unit_price_measurement -%}
    {%- liquid
      assign be_up_amount = unit_price_variant.unit_price
      assign be_up_suffix = ''
      assign be_up_ref = unit_price_variant.unit_price_measurement.reference_value
      assign be_up_unit = unit_price_variant.unit_price_measurement.reference_unit
      comment
        BE 12.11.2026: Fragrance Library zeigt den Grundpreis je 100 ml (wie auf der Library-Seite, claude-home-library/fl-books gp()).
        Rechnung aus den echten Variantendaten: unit_price (je Bezugsmenge) / (Bezugswert x Faktor ml) x 100; nur auf ganze Cent gerundet.
      endcomment
      if product.vendor == 'Fragrance Library'
        assign be_up_f = 0
        assign be_up_u = be_up_unit | downcase
        if be_up_u == 'ml'
          assign be_up_f = 1
        elsif be_up_u == 'cl'
          assign be_up_f = 10
        elsif be_up_u == 'l'
          assign be_up_f = 1000
        endif
        if be_up_f > 0 and be_up_amount > 0
          assign be_up_div = be_up_ref | times: be_up_f
          assign be_up_amount = be_up_amount | times: 100.0 | divided_by: be_up_div | round
          assign be_up_suffix = '100&nbsp;ml'
        endif
      endif
      if be_up_suffix == ''
        if be_up_ref != 1
          assign be_up_suffix = be_up_ref | append: '&nbsp;' | append: be_up_unit
        else
          assign be_up_suffix = be_up_unit
        endif
      endif
    -%}
    <div class="unit-price unit-price--line dim" data-nosnippet><span class="unit-price__text">{% if request.locale.iso_code == 'de' %}Grundpreis{% else %}{{ 'products.product.price.unit_price' | t }}{% endif %}: <span class="unit-price__amount">{{ be_up_amount | money | strip_html }}</span> /&nbsp;{{ be_up_suffix }}</span></div>
  {%- endif -%}
{%- endunless -%}
