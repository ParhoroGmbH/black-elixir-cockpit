        "custom_liquid_jT9DMm": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign be_gw_url = 'eu-gewaehrleistungslabel-de.jpg' | file_url -%}\n<div class=\"eu-gewaehrleistungslabel be-gw\">\n<style>\n.be-gw{margin:6px 0;font-size:13px;line-height:1.4}\n.be-gw__link{display:inline-flex;align-items:center;gap:6px;color:inherit;text-decoration:underline;text-underline-offset:2px;cursor:pointer}\n.be-gw__link svg{flex:0 0 auto;width:16px;height:16px}\n.be-gw__dialog{position:fixed;inset:0;margin:auto!important;padding:0;border:0;background:transparent;width:fit-content;height:fit-content;max-width:min(620px,94vw);max-height:94vh;overflow:visible}\n.be-gw__dialog::backdrop{background:rgba(0,0,0,.7)}\n.be-gw__dialog img{display:block;width:auto;max-width:100%;height:auto;max-height:90vh;margin:0 auto;background:#fff}\n.be-gw__close{position:absolute;top:-14px;right:-14px;width:36px;height:36px;border-radius:50%;border:0;background:#fff;color:#000;font-size:22px;line-height:36px;text-align:center;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.35);padding:0}\n@media (max-width:480px){.be-gw__close{top:6px;right:6px}}\n</style>\n<a class=\"be-gw__link\" href=\"{{ be_gw_url }}\" target=\"_blank\" rel=\"noopener\" aria-haspopup=\"dialog\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2.5l8 3.5v5.5c0 5-3.4 9.1-8 10.5-4.6-1.4-8-5.5-8-10.5V6l8-3.5z\"/><path d=\"M8.5 12l2.5 2.5 4.5-4.5\"/></svg><span>{{ 'claude.pdp.gw_link_html' | t }}</span></a>\n<dialog class=\"be-gw__dialog\" aria-label=\"{{ 'claude.pdp.gw_html' | t }}\"><button type=\"button\" class=\"be-gw__close\" aria-label=\"{{ 'claude.pdp.close_html' | t }}\">&times;</button><img data-src=\"{{ be_gw_url }}\" alt=\"Gesetzliche Gewährleistung: Mindestens zwei Jahre gesetzliche Gewährleistung für Waren, die in der Europäischen Union verkauft werden\" width=\"620\" height=\"877\"></dialog>\n</div>\n<script>\n(function(){if(window.__beGwInit)return;window.__beGwInit=true;\ndocument.addEventListener('click',function(e){\nvar t=e.target;if(!t||!t.closest)return;\nvar a=t.closest('.be-gw__link');\nif(a){var d=a.parentNode.querySelector('.be-gw__dialog');if(!d||typeof d.showModal!=='function')return;\ne.preventDefault();var i=d.querySelector('img');if(i&&!i.getAttribute('src'))i.setAttribute('src',i.getAttribute('data-src'));\ntry{d.showModal();}catch(x){window.open(a.href,'_blank','noopener');}return;}\nif(t.closest('.be-gw__close')||(t.classList&&t.classList.contains('be-gw__dialog'))){var dd=t.closest('.be-gw__dialog');if(dd&&dd.open)dd.close();}\n});})();\n</script>",
            "top_spacing": 1,
            "mobile_top_spacing": 1
          }
        },
