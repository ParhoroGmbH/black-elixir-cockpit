{%- liquid
  assign s = sec.settings
  assign c_soap = collections[s.col_soaps]
  assign bg_lounge = images['be-videolounge-bg-2026-11-12.jpg']
  assign bg_marmor = images['be-geschenk-marmor-bg-2026-11-12.jpg']
  assign img_bow = images['be-schleife-gold-2026-11-12.png']
  assign img_box = images['be-geschenkbox-seifen-2026-11-12.jpg']
-%}
{%- if part == 'gifts' -%}
<style>
  /* Video-Lounge: neuer Premium-Hintergrund */
  .ch .cv-sec.cv-sec{background:linear-gradient(180deg,rgba(5,4,3,.82),rgba(5,4,3,.42) 38%,rgba(5,4,3,.55) 70%,rgba(5,4,3,.9)),url({{ bg_lounge | image_url: width: 2200 }}) 50% 50%/cover no-repeat,#070504!important}
  .cv-sec .ch-lead{color:#e9dfc8}
  .ch .cv-sec .ch-vid{border:1px solid rgba(200,164,92,.45);box-shadow:0 30px 60px rgba(0,0,0,.55),inset 0 0 0 1px rgba(255,255,255,.06)}
