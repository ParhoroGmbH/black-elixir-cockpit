{%- comment -%} Video-Szene: Video laeuft von selbst in Schleife (sobald sichtbar), Scrollen steuert nur Text/Emotion. Poster verkleinert (width=1800), Video laedt erst Metadaten. Parameter: sid, vid, poster, title, sub, vh {%- endcomment -%}
{%- assign h = vh | default: 300 | times: 0.6 | round -%}
{%- if poster contains '?' -%}{%- assign ps = poster | append: '&width=1800' -%}{%- else -%}{%- assign ps = poster | append: '?width=1800' -%}{%- endif -%}
<style>
.dv{position:relative;background:#0b0907;--p:0}
.dv-st{position:sticky;top:0;height:100vh;overflow:hidden;background:#0b0907}
.dv video,.dv .dv-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.dv video{transform:scale(calc(1.08 - var(--p)*.08))}
.dv-shade{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 55%,rgba(11,9,7,0) 35%,rgba(11,9,7,.7) 100%),linear-gradient(180deg,rgba(11,9,7,.6),rgba(11,9,7,0) 28%,rgba(11,9,7,0) 55%,rgba(11,9,7,.88))}
.dv-tx{position:absolute;left:0;right:0;bottom:11vh;text-align:center;padding:0 20px;color:#f3e8d0}
.dv-tx h2{margin:0 auto;max-width:980px;font-family:Cinzel,serif;font-weight:700;font-size:clamp(28px,4.6vw,66px);line-height:1.12;letter-spacing:.04em;color:#f3e8d0;opacity:clamp(0,calc((var(--p) - .1)*4),1);transform:translateY(calc((1 - clamp(0,(var(--p) - .1)*4,1))*30px))}
.dv-tx p{margin:14px 0 0;font:400 clamp(13px,1.6vw,18px) Jost,system-ui,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#cbb88f;opacity:clamp(0,calc((var(--p) - .25)*4),1)}
@media (prefers-reduced-motion:reduce){.dv{height:100vh!important}.dv video{display:none}.dv-tx h2,.dv-tx p{opacity:1;transform:none}}
.dm-arena,.dm-cav{display:none}
</style>
<div class="dv" id="dv-{{ sid }}" style="height:{{ h }}vh"><div class="dv-st">
<img class="dv-poster" src="{{ ps }}" alt="" loading="lazy" decoding="async">
<video muted playsinline loop preload="none" poster="{{ ps }}" aria-hidden="true"><source src="{{ vid }}" type="video/mp4"></video>
<div class="dv-shade"></div>
<div class="dv-tx"><h2>{{ title }}</h2>{%- if sub != blank -%}<p>{{ sub }}</p>{%- endif -%}</div>
</div></div>
<script>
(function(){var w=document.getElementById('dv-{{ sid }}');if(!w)return;var v=w.querySelector('video');if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
new IntersectionObserver(function(e){if(e[0].isIntersecting){var q=v.play();if(q&&q.catch)q.catch(function(){})}else v.pause()},{rootMargin:'400px 0px'}).observe(w);
function upd(){var r=w.getBoundingClientRect(),t=r.height-innerHeight,p=Math.min(1,Math.max(0,-r.top/t));w.style.setProperty('--p',p.toFixed(4))}
addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd);upd();})();
</script>
