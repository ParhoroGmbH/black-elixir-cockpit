{%- comment -%} DUMO Kapitel. Eigenes 3D-Modell je Duft (be6-dumo-*, gleiche Form, Farben nach Original-Flakon, ca. 4,5 MB). Vorderseite = 0deg. Claude 12.11.2026. Auftritt: kommt aus der Tiefe, dreht 360 Grad, endet frontal; grosser Name im Hintergrund wandert mit. Erstes Modell wird kurz nach dem Seitenladen geladen, jedes weitere, sobald sein Kapitel naeher als 2,5 Bildschirmhoehen ist (statt alle auf einmal, ca. 13 MB), damit es beim Hinscrollen schon da ist. {%- endcomment -%}
{%- assign low = name | downcase -%}{%- if low == 'spartacus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/047518974017eb47/be6-dumo-spartacus.glb' -%}{%- elsif low == 'commodus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/61da2d04a7777b4a/be6-dumo-commodus.glb' -%}{%- elsif low == 'crixus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/7cc23c0d5f6caf4f/be6-dumo-crixus.glb' -%}{%- elsif low == 'marcus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/93cab1590bc3d47f/be6-dumo-marcus.glb' -%}{%- elsif low == 'rexor' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/ac06e8a8d2318792/be6-dumo-rexor.glb' -%}{%- elsif low == 'priscus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/4ba273098301cc2a/be6-dumo-priscus.glb' -%}{%- elsif low == 'verus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/f62e89f263d62df5/be6-dumo-verus.glb' -%}{%- else -%}{%- assign glb = '' -%}{%- endif -%}
<section class="dm-ch dm-cp" data-n="{{ name }}" style="--a:{{ color }}"><div class="dm-st">
{%- if glb != '' -%}<div class="dm-ghost" aria-hidden="true">{{ name | upcase }}</div>{%- endif -%}
<div class="dm-grid">
<div class="dm-tx"><div class="dm-lab">{{ role }}</div><h2>{{ name | upcase }}</h2><div class="dm-tag">{{ tag }}</div>
<p class="dm-story">{{ story }}</p>
<div class="dm-notes"><div><span>Kopf</span>{{ top }}</div><div><span>Herz</span>{{ heart }}</div><div><span>Basis</span>{{ base }}</div></div>
{%- if pr -%}<div class="dm-buy">{%- if pr.available -%}<button class="dm-btn" type="button" data-add="{{ pr.selected_or_first_available_variant.id }}">In den Warenkorb · {{ pr.price | money }}</button>{%- else -%}<button class="dm-btn" type="button" disabled>Ausverkauft</button>{%- endif -%}<a class="dm-sm" href="{{ pr.url }}">Zum Produkt · 100 ml · Eau de Parfum</a></div>{%- endif -%}</div>
<div class="dm-vis">{%- if glb != '' -%}
<script type="module" src="https://cdn.jsdelivr.net/npm/@google/model-viewer@3.5.0/dist/model-viewer.min.js"></script>
<style>
.dm-ghost{position:absolute;left:0;right:0;top:50%;transform:translate(calc(18% - var(--p)*36%),-50%);font:700 clamp(90px,19vw,300px)/1 Cinzel,serif;letter-spacing:.06em;white-space:nowrap;color:transparent;-webkit-text-stroke:1px #e4e4e4;text-align:center;pointer-events:none;user-select:none}
.dm-cp .dm-grid{position:relative;z-index:1}
.dm-stage{position:relative;width:min(46vh,100%);height:66vh;display:flex;align-items:flex-end;justify-content:center}
.dm-3d{width:100%;height:62vh;--poster-color:transparent;background:transparent;will-change:transform}
.dm-plinth{position:absolute;bottom:2vh;left:50%;width:70%;height:22px;transform:translateX(-50%) scaleX(var(--r,0));border-radius:50%;background:radial-gradient(ellipse at center,rgba(0,0,0,.22),rgba(0,0,0,0) 70%)}
.dm-ring{position:absolute;bottom:calc(2vh + 10px);left:50%;width:56%;height:1px;background:var(--a);transform:translateX(-50%) scaleX(var(--r,0));opacity:.8}
@media (prefers-reduced-motion:reduce){.dm-ghost{transform:translate(0,-50%)}}
</style>
<div class="dm-stage" id="dms-{{ name | handleize }}"><div class="dm-plinth"></div><div class="dm-ring"></div>
<model-viewer class="dm-3d" src="{{ glb }}" alt="DUMO {{ name }} Flakon in 3D" camera-orbit="0deg 80deg auto" environment-image="neutral" disable-zoom interaction-prompt="none" shadow-intensity="0.8" shadow-softness="1" exposure="1.1" crossorigin="anonymous"></model-viewer></div>
<script>(function(){var st=document.getElementById('dms-{{ name | handleize }}'),m=st.querySelector('model-viewer'),s=st.closest('.dm-ch');
if(!window.__dmPre){window.__dmPre=1;var go=function(){setTimeout(function(){var all=[].slice.call(document.querySelectorAll('.dm-3d'));if(!all.length)return;all[0].loading='eager';if(!('IntersectionObserver' in window)){all.forEach(function(x){x.loading='eager'});return}var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){var x=e.target.querySelector('.dm-3d');if(x)x.loading='eager';io.unobserve(e.target)}})},{rootMargin:'250% 0px'});all.forEach(function(x){var c=x.closest('.dm-ch');if(c)io.observe(c)})},600)};if(document.readyState==='complete')go();else addEventListener('load',go)}
function c(x){return Math.min(1,Math.max(0,x))}
function t(){var r=s.getBoundingClientRect(),h=r.height-innerHeight,p=h>0?c(-r.top/h):1,rise=c(p/0.3),turn=c(p/0.8),e=1-Math.pow(1-rise,3);
m.cameraOrbit=(turn*360)+'deg '+(96-turn*16)+'deg auto';
m.style.transform='translateY('+((1-e)*140)+'px) scale('+(0.6+e*0.4)+')';m.style.opacity=e;st.style.setProperty('--r',e.toFixed(3));}
addEventListener('scroll',t,{passive:true});addEventListener('resize',t);t();})();</script>
{%- else -%}<div class="dm-bust">{%- if pr and pr.featured_image -%}<img src="{{ pr.featured_image | image_url: width: 700 }}" alt="{{ pr.featured_image.alt | default: pr.title | escape }}" width="350" height="{{ 350 | divided_by: pr.featured_image.aspect_ratio | round }}" loading="lazy">{%- else -%}<b>{{ name | upcase }}</b>{%- endif -%}</div>{%- endif -%}</div>
</div></div></section>
{%- if name == 'Rexor' -%}{%- render 'dumo-scene', sid: 'ritt', vid: 'https://cdn.shopify.com/s/files/1/0762/4949/7942/files/dumo-reiter.mp4', poster: 'https://cdn.shopify.com/s/files/1/0762/4949/7942/files/dumo-reiter.png', title: 'Sieben Reiter. Ein Ziel.', sub: '', vh: 320 -%}{%- endif -%}
