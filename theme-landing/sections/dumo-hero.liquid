{%- liquid
  assign vid = section.settings.video_url | default: 'https://cdn.shopify.com/s/files/1/0762/4949/7942/files/dumo-gladiator-hero.mp4?v=1793472583'
  assign poster = section.settings.poster_url | default: 'https://cdn.shopify.com/s/files/1/0762/4949/7942/files/dumo-gladiator-hero.png?v=1793472575&width=1800'
-%}
<link rel="preload" as="image" href="{{ poster }}" fetchpriority="high">
<style>
.dh{position:relative;height:320vh;background:#0b0907;--p:0}
.dh-st{position:sticky;top:0;height:100vh;overflow:hidden;background:#0b0907}
.dh video,.dh .dh-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.dh-shade{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 55%,rgba(11,9,7,0) 30%,rgba(11,9,7,.78) 100%),linear-gradient(180deg,rgba(11,9,7,.55),rgba(11,9,7,0) 30%,rgba(11,9,7,.2) 60%,rgba(11,9,7,.85))}
.dh-tx{position:absolute;left:0;right:0;bottom:12vh;text-align:center;padding:0 16px;font-family:Cinzel,serif;color:#f3e8d0}
.dh-be{font:400 clamp(11px,1.2vw,14px) Jost,system-ui,sans-serif;letter-spacing:.42em;text-transform:uppercase;color:#fff;margin:0 0 18px;opacity:clamp(0,calc(.3 + var(--p)*5),1)}
.dh-be b{font-weight:500}
.dh-tx h1{margin:0;font-weight:700;font-size:clamp(56px,13vw,170px);line-height:1;letter-spacing:calc(.5em - var(--p)*.42em);opacity:clamp(0,calc(var(--p)*4),1)}
.dh-tx p{margin:14px 0 0;font-family:Jost,system-ui,sans-serif;font-size:clamp(14px,1.8vw,20px);letter-spacing:.22em;text-transform:uppercase;color:#cbb88f;opacity:clamp(0,calc((var(--p) - .25)*4),1)}
.dh-hint{position:absolute;bottom:26px;left:0;right:0;text-align:center;font:400 12px Jost,system-ui,sans-serif;letter-spacing:.3em;text-transform:uppercase;color:#a89572;opacity:calc(1 - var(--p)*4)}
@media (prefers-reduced-motion:reduce){.dh{height:100vh}.dh-tx h1,.dh-tx p,.dh-be{opacity:1;letter-spacing:.08em}.dh video{display:none}}
.dm-gate{display:none}
</style>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Jost:wght@300;400;500&display=swap">
<div class="dh" id="dh-{{ section.id }}"><div class="dh-st">
<img class="dh-poster" src="{{ poster }}" alt="Gladiator mit Bronzehelm" width="1344" height="752" fetchpriority="high">
<video muted playsinline loop autoplay preload="auto" poster="{{ poster }}" aria-hidden="true"><source src="{{ vid }}" type="video/mp4"></video>
<div class="dh-shade"></div>
<div class="dh-tx"><div class="dh-be"><b>Black Elixir</b> · Maison de Parfum präsentiert</div><h1>DUMO</h1><p>{{ section.settings.subtitle }}</p></div>
<div class="dh-hint">Scrolle nach unten</div>
</div></div>
<script>
(function(){var w=document.getElementById('dh-{{ section.id }}');if(!w)return;var v=w.querySelector('video');if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
var pl=v.play();if(pl&&pl.catch)pl.catch(function(){});
new IntersectionObserver(function(e){if(e[0].isIntersecting){var q=v.play();if(q&&q.catch)q.catch(function(){})}else v.pause()}).observe(w);
function upd(){var r=w.getBoundingClientRect(),t=r.height-innerHeight,p=Math.min(1,Math.max(0,-r.top/t));w.style.setProperty('--p',p.toFixed(4))}
addEventListener('scroll',upd,{passive:true});addEventListener('resize',upd);upd();})();
</script>
{% schema %}
{"name":"DUMO Hero","settings":[
{"type":"text","id":"subtitle","label":"Untertitel","default":"Sieben Namen. Sieben Kämpfer."},
{"type":"url","id":"video_url","label":"Video-URL (leer = Standard)"},
{"type":"url","id":"poster_url","label":"Poster-URL (leer = Standard)"}],
"presets":[{"name":"DUMO Hero"}]}
{% endschema %}
