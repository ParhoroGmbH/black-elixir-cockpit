  .cg .ch-arch:hover .cg-bow{transform:translateY(-6px) scale(1.12) rotate(-6deg)}
  .cg-tw{position:absolute;width:6px;height:6px;border-radius:50%;background:#fff6d8;box-shadow:0 0 12px 3px rgba(241,222,168,.8);animation:fxTw 3.2s ease-in-out infinite;pointer-events:none}
  /* Geschenk statt Rabatt: Marmor, Goldfluss, Box öffnet sich */
  .cr{background:radial-gradient(ellipse at 15% 0%,#fff 0,transparent 55%),repeating-linear-gradient(115deg,rgba(200,164,92,.07) 0 1px,transparent 1px 46px),repeating-linear-gradient(35deg,rgba(0,0,0,.025) 0 1px,transparent 1px 70px),var(--light)!important}
  .cr .ch-bar{height:12px;border-radius:6px;background:#e6dfd2;box-shadow:inset 0 1px 3px rgba(0,0,0,.15)}
  .cr .ch-bar span{border-radius:6px;background:linear-gradient(90deg,var(--accD),var(--accL),var(--acc),var(--accL)) 0 0/200% 100%;animation:fxFoil 3s linear infinite;box-shadow:0 0 16px rgba(200,164,92,.7)}
