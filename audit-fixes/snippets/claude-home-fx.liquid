  .cr-glow{position:absolute;left:50%;top:6px;width:220px;height:120px;margin-left:-110px;border-radius:50%;background:radial-gradient(ellipse,rgba(255,226,150,.85),transparent 70%);filter:blur(8px);opacity:0;transition:opacity 1s;pointer-events:none}
  .cr[data-level="1"] .cr-glow{opacity:.6}.cr[data-level="2"] .cr-glow{opacity:1}
