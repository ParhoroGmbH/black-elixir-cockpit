{%- comment -%} Teil der Section claude-home – Effekte: Geschenke nach Budget, Geschenk statt Rabatt, Footer (Inhalt bleibt, nur Effekte). Claude · 11.11.2026 – nicht anfassen {%- endcomment -%}
<style>
  @keyframes fxFoil{from{background-position:-150% 0}to{background-position:150% 0}}
  @keyframes fxTw{0%,100%{opacity:0;transform:scale(.4)}50%{opacity:1;transform:scale(1)}}
  /* Geschenke nach Budget: dunkles Geschenkpapier mit Goldband */
  .cg{background:linear-gradient(90deg,transparent calc(50% - 22px),rgba(125,95,37,.9) calc(50% - 22px),#f1dea8 50%,rgba(125,95,37,.9) calc(50% + 22px),transparent calc(50% + 22px)),linear-gradient(0deg,transparent calc(50% - 22px),rgba(125,95,37,.9) calc(50% - 22px),#f1dea8 50%,rgba(125,95,37,.9) calc(50% + 22px),transparent calc(50% + 22px)),repeating-linear-gradient(45deg,rgba(200,164,92,.07) 0 2px,transparent 2px 24px),radial-gradient(ellipse at 50% 40%,#21180c,#060403 75%)!important;color:#fff}
  .cg .ch-h2{color:#fff}
  .cg .ch-eyebrow{color:var(--acc)}
