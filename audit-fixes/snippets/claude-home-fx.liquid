  .cg .ch-arch::before{content:"";position:absolute;top:0;bottom:0;left:50%;width:16px;margin-left:-8px;z-index:-1;background:linear-gradient(90deg,var(--accD),var(--accL),var(--accD));opacity:.55}
  .cg .ch-arch:hover{box-shadow:0 0 0 1px var(--accL),0 30px 70px rgba(200,164,92,.35)}
  .cg .ch-arch__t{background:linear-gradient(100deg,#7d5f25,#c8a45c 30%,#fff3cf 45%,#c8a45c 60%,#7d5f25) 0 0/250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:fxFoil 7s linear infinite;font-family:"Bodoni Moda",Georgia,serif}
  .cg-bow{position:relative;width:64px;height:30px;margin-top:-20px;transition:transform .6s}
  .cg-bow::before,.cg-bow::after{content:"";position:absolute;top:0;width:30px;height:24px;border:4px solid var(--acc);border-radius:50% 50% 50% 50%/60% 60% 40% 40%;background:rgba(241,222,168,.25)}
  .cg-bow::before{left:0;transform:rotate(-24deg)}
