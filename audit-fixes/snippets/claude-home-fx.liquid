  .cr .ch-soap{transition:transform .7s cubic-bezier(.2,.8,.2,1),opacity .6s,filter .6s,box-shadow .6s}
  .cr .ch-soaps[data-level="0"] .ch-soap,.cr .ch-soaps[data-level="1"] .ch-soap:nth-child(n+2){filter:grayscale(.85);opacity:.5}
  .cr .ch-soaps[data-level="1"] .ch-soap:first-child,.cr .ch-soaps[data-level="2"] .ch-soap:nth-child(-n+2){box-shadow:0 0 0 2px var(--acc),0 20px 50px rgba(200,164,92,.45);transform:translateY(-8px)}
  .cr-stage{position:relative;height:190px;perspective:900px;display:flex;align-items:center;justify-content:center;margin-bottom:6px}
  .cr-box{position:relative;width:140px;height:140px;transform-style:preserve-3d;animation:crSpin 16s linear infinite}
