  @keyframes crConf{from{transform:translate(0,0) rotate(0);opacity:1}to{transform:translate(var(--x),var(--y)) rotate(540deg);opacity:0}}
  /* Footer: Inhalt wie live, nur Effekte */
  .shopify-section-footer .footer.color-custom{background:radial-gradient(ellipse 40% 30% at 0% 0%,rgba(200,164,92,.16),transparent 70%),radial-gradient(ellipse 30% 25% at 100% 100%,rgba(200,164,92,.1),transparent 70%),#0b0b0b!important}
  .be-foilwrap{filter:drop-shadow(0 1px 0 rgba(255,255,255,.5)) drop-shadow(0 3px 4px rgba(0,0,0,.8)) drop-shadow(0 0 18px rgba(255,255,255,.12))}
  .be-foil{-webkit-mask:var(--be-logo) center/contain no-repeat;mask:var(--be-logo) center/contain no-repeat;background:linear-gradient(105deg,#8d8d8d 0%,#fff 14%,#c9c9c9 26%,#fff 38%,#f3e6c4 46%,#8a8a8a 58%,#f5f5f5 72%,#b9b9b9 86%,#fff 100%) 0 0/260% 100%;animation:beFoil 8s ease-in-out infinite}
  .be-foil img{opacity:0}
  @keyframes beFoil{0%,100%{background-position:0% 0}50%{background-position:100% 0}}
  .shopify-section-footer .newsletter__form{display:flex;align-items:center;gap:8px;padding:5px 5px 5px 20px;border-radius:999px;background:linear-gradient(145deg,rgba(255,255,255,.13),rgba(255,255,255,.03));backdrop-filter:blur(16px) saturate(150%);-webkit-backdrop-filter:blur(16px) saturate(150%);border:1px solid rgba(255,255,255,.22);box-shadow:inset 0 1px 0 rgba(255,255,255,.25)}
  .shopify-section-footer .newsletter__field{flex:1;min-width:0;min-height:44px;border:0!important;background:transparent!important;color:#fff}
  .shopify-section-footer .newsletter__field-icon{position:static!important;flex:0 0 46px;width:46px;height:46px;border-radius:50%;background:var(--acc,#C8A45C)!important;display:grid;place-items:center;transition:transform .3s}
  .shopify-section-footer .newsletter__field-icon:hover svg{transform:translateX(3px)}
  .shopify-section-footer .newsletter__field-icon svg{fill:#000;transition:transform .3s}
  .shopify-section-footer .newsletter__title{letter-spacing:.2em;color:#C8A45C}
  .shopify-section-footer .menu__item-link-title{transition:color .3s,padding .3s}
  .shopify-section-footer a:hover .menu__item-link-title{color:#C8A45C;padding-left:6px}
</style>
<script>
  (function () {
    var root = document.currentScript.closest('.claude-home-section') || document;
    // Funkeln im Geschenkpapier
    var cg = document.querySelector('.cg');
    if (cg) for (var i = 0; i < 14; i++) { var t = document.createElement('span'); t.className = 'cg-tw'; t.setAttribute('aria-hidden', 'true'); t.style.left = (7 + (i * 53) % 86) + '%'; t.style.top = (8 + (i * 37) % 84) + '%'; t.style.animationDelay = (-(i * .41)).toFixed(2) + 's'; cg.appendChild(t); }
    // Geschenk statt Rabatt: Box + Konfetti je Stufe
    var cr = document.querySelector('[data-cr]'), r = cr && cr.querySelector('[data-ch-basket]'), lv = -1;
    function lvl() { var v = +r.value, l = v >= 99 ? 2 : (v >= 59 ? 1 : 0); cr.setAttribute('data-level', l); if (lv >= 0 && l > lv) burst(); lv = l; }
    function burst() { var st = cr.querySelector('.cr-stage'); if (!st || matchMedia('(prefers-reduced-motion:reduce)').matches) return; var cols = ['#C8A45C', '#F1DEA8', '#7D5F25', '#fff']; for (var i = 0; i < 26; i++) { var c = document.createElement('span'); c.className = 'cr-conf'; c.style.left = '50%'; c.style.top = '40%'; c.style.background = cols[i % 4]; c.style.setProperty('--x', (Math.cos(i) * (80 + i * 6)).toFixed(0) + 'px'); c.style.setProperty('--y', (-60 - (i * 13) % 140).toFixed(0) + 'px'); st.appendChild(c); setTimeout(function (x) { x.remove(); }.bind(null, c), 1700); } }
    if (r) { r.addEventListener('input', lvl); lvl(); }
    // Footer-Logo: gravierter Metallglanz über dem Original-Logo (hochaufgelöste Maske)
    function foil() { var img = document.querySelector('.shopify-section-footer img.image__item'); if (!img) return; var src = img.currentSrc; if (!src || src.indexOf('data:') === 0) src = (img.getAttribute('data-srcset') || img.getAttribute('srcset') || '').split(' ')[0] || img.getAttribute('data-src') || img.src; if (!src || src.indexOf('data:') === 0) return; src = src.replace(/width=[0-9]+/, 'width=1200'); var a = img.closest('a') || img.parentElement; a.style.setProperty('--be-logo', 'url("' + src + '")'); a.classList.add('be-foil'); a.parentElement.classList.add('be-foilwrap'); }
    if (document.readyState === 'complete') foil(); else window.addEventListener('load', foil);
  })();
</script>