  .cr-f,.cr-lid{position:absolute;inset:0;border:1px solid var(--acc);background:linear-gradient(90deg,transparent 43%,var(--acc) 43% 57%,transparent 57%),linear-gradient(160deg,#fffdf8,#efe6d4)}
  .cr-lid{left:-8px;top:-8px;width:156px;height:156px;transform:rotateX(90deg) translateZ(78px);transition:transform 1.1s cubic-bezier(.2,.8,.2,1);background:linear-gradient(90deg,transparent 43%,var(--acc) 43% 57%,transparent 57%),linear-gradient(0deg,transparent 43%,var(--acc) 43% 57%,transparent 57%),linear-gradient(160deg,#fff,#efe6d4)}
  .cr[data-level="1"] .cr-lid{transform:rotateX(90deg) translateZ(118px)}
