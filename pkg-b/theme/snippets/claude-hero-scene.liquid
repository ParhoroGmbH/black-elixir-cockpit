{%- comment -%}
  claude-hero-scene — Prototyp Paket B (12.11.2026): Produkt steht fest auf dem Tisch, die KAMERA bewegt sich um das Produkt durch einen echten 360°-Ort.
  Ein Ort = ein equirektangulares Panorama (Shopify-Datei), dient als Umgebung, Tischfläche (bodenprojiziert) und Licht. Produkt = vorhandenes echtes GLB, unverändert.
  Selbstständig: eigenes CSS (.hsc-), eigenes Modul-Skript, three.js per CDN erst wenn der Hero sichtbar wird; Poster zuerst, Canvas blendet erst ein, wenn das Produkt steht.
  Aufruf: {% render 'claude-hero-scene' %}  (optional: link: '/collections/…')
{%- endcomment -%}
{%- liquid
  assign hsc_env = images['be-scene-advent-babor.jpg']
  assign hsc_models = 'BABOR|eab800eba079cdeb/be-cal-babor.glb,ARTDECO|7f0bc976655f8fa4/be-cal-artdeco.glb,Molton Brown|5c65f193dc68588a/be-cal-mb3.glb,Wir für Sie|8c572b0420074443/be-cal-wfs.glb' | split: ','
  assign hsc_link = link | default: '/collections/luxus-adventskalender'
  assign hsc_title = 'claude.hero.t1_html' | t
  assign hsc_last = hsc_title | split: ' ' | last
  assign hsc_first = hsc_title | remove_last: hsc_last
  case request.locale.iso_code
    when 'en'
      assign hsc_hint = 'Drag to look around'
    when 'fr'
      assign hsc_hint = 'Faites glisser pour regarder autour'
    when 'it'
      assign hsc_hint = 'Trascina per guardarti intorno'
    when 'da'
      assign hsc_hint = 'Træk for at se dig omkring'
    when 'ar'
      assign hsc_hint = 'اسحب لتنظر حولك'
    else
      assign hsc_hint = 'Ziehen und umsehen'
  endcase
-%}
<style>.hsc{position:relative;overflow:hidden;background:#07060a;color:#fff;height:clamp(540px,calc(100vh - var(--hsc-top,154px)),900px);isolation:isolate;-webkit-font-smoothing:antialiased}
.hsc *{box-sizing:border-box}
.hsc-poster,.hsc-canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.hsc-poster{object-fit:cover;object-position:62% 50%}
.hsc-canvas{opacity:0;transition:opacity .7s ease;cursor:grab;outline:0;-webkit-user-select:none;user-select:none}
.hsc-canvas:active{cursor:grabbing}
.hsc-canvas:focus-visible{outline:2px solid #e9cf8f;outline-offset:-4px}
.hsc-live .hsc-canvas{opacity:1}
.hsc-shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(4,3,6,.86) 0%,rgba(4,3,6,.62) 26%,rgba(4,3,6,.18) 50%,rgba(4,3,6,0) 64%),linear-gradient(0deg,rgba(4,3,6,.5) 0%,rgba(4,3,6,0) 22%)}
.hsc-text{position:absolute;z-index:2;left:clamp(20px,5vw,80px);top:50%;transform:translateY(-50%);width:min(520px,42vw);display:flex;flex-direction:column;align-items:flex-start;gap:clamp(8px,1.9vh,18px);pointer-events:none}
.hsc-text a{pointer-events:auto}
.hsc-pill{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;border:1px solid rgba(233,207,143,.45);background:rgba(10,8,12,.5);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:#fff;font-size:12px;font-weight:600;letter-spacing:.02em;text-decoration:none;white-space:nowrap}
.hsc-pill i{width:7px;height:7px;border-radius:50%;background:#e9cf8f}
.hsc-eyebrow{margin:0;font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:#e9cf8f;font-weight:600}
.hsc-title{margin:0;font-family:"Bodoni Moda","Bodoni 72","Didot",Georgia,serif;font-weight:500;line-height:1.06;font-size:clamp(30px,min(4.2vw,6vh),64px);color:#fff;text-wrap:balance;text-shadow:0 2px 24px rgba(0,0,0,.55)}
.hsc-title em{font-style:italic;color:#e9cf8f}
.hsc-d{margin:0;font-size:clamp(14px,2vh,17px);line-height:1.5;color:rgba(255,255,255,.9);max-width:44ch;text-shadow:0 1px 12px rgba(0,0,0,.7)}
.hsc-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 28px;border-radius:999px;background:linear-gradient(180deg,#f1dca4,#d9b866);color:#17120a;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;white-space:nowrap;box-shadow:0 10px 30px rgba(0,0,0,.45);transition:transform .2s ease,filter .2s ease}
.hsc-btn:hover{transform:translateY(-1px);filter:brightness(1.06)}
.hsc-btn:focus-visible,.hsc-pill:focus-visible,.hsc-chip:focus-visible{outline:2px solid #fff;outline-offset:3px}
.hsc-ui{position:absolute;z-index:2;left:66%;bottom:clamp(18px,4vh,40px);transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:10px;pointer-events:none;width:max-content;max-width:calc(100% - 24px)}
.hsc-chips{display:flex;gap:6px;pointer-events:auto;max-width:100%;overflow-x:auto;scrollbar-width:none;padding:2px}
.hsc-chips::-webkit-scrollbar{display:none}
.hsc-chip{flex:0 0 auto;appearance:none;-webkit-appearance:none;min-height:34px;padding:0 14px;border-radius:999px;border:1px solid rgba(255,255,255,.4);background:rgba(10,8,12,.55);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:#fff;font:600 11px/1 inherit;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.hsc-chip:hover{border-color:#e9cf8f}
.hsc-chip.is-on{background:#e9cf8f;border-color:#e9cf8f;color:#17120a}
.hsc-hint{display:inline-flex;align-items:center;gap:8px;margin:0;font-size:12px;letter-spacing:.06em;color:rgba(255,255,255,.82);text-shadow:0 1px 8px rgba(0,0,0,.8);opacity:0;transition:opacity .6s ease}
.hsc-hint svg{width:22px;height:22px;flex:none}
.hsc-live .hsc-hint{opacity:1}
.hsc-used .hsc-hint{opacity:0}
.hsc-fail .hsc-hint{display:none}
@media (max-width:749px){
  .hsc{height:clamp(640px,calc(100svh - var(--hsc-top,36px)),820px)}
  .hsc-poster{object-position:50% 50%}
  .hsc-shade{background:linear-gradient(180deg,rgba(4,3,6,.86) 0%,rgba(4,3,6,.55) 28%,rgba(4,3,6,0) 48%),linear-gradient(0deg,rgba(4,3,6,.6) 0%,rgba(4,3,6,0) 20%)}
  .hsc-text{left:16px;right:16px;top:20px;transform:none;width:auto;gap:9px}
  .hsc-title{font-size:clamp(28px,8.4vw,36px)}
  .hsc-d{font-size:14px}
  .hsc-btn{min-height:46px;padding:0 22px;font-size:12px}
  .hsc-ui{left:50%;bottom:14px}
  .hsc-chips{gap:5px}
  .hsc-chip{min-height:38px;font-size:10.5px;padding:0 10px;letter-spacing:.06em}
  .hsc-hint{font-size:11px}
}
@media (prefers-reduced-motion:reduce){.hsc-canvas,.hsc-hint,.hsc-btn{transition:none}}</style>
<div class="hsc" data-hsc>
  <picture><source media="(max-width:749px)" srcset="{{ images['be-scene-advent-babor-poster-m.jpg'] | image_url: width: 780 }}"><img class="hsc-poster" src="{{ images['be-scene-advent-babor-poster.jpg'] | image_url: width: 1920 }}" alt="" width="1920" height="900" fetchpriority="high" decoding="async"></picture>
  <canvas class="hsc-canvas" tabindex="0" role="img" aria-label="{{ 'claude.hero.alt_3d_html' | t: name: 'Adventskalender' | strip_html | escape }} – {{ hsc_hint | escape }}"></canvas>
  <span class="hsc-shade" aria-hidden="true"></span>
  <div class="hsc-text">
    <a class="hsc-pill" href="{{ routes.collections_url }}/geschenk-seifen"><i></i>{{ 'claude.hero.chip_html' | t }}</a>
    <p class="hsc-eyebrow">{{ 'claude.hero.e1_html' | t }}</p>
    <h1 class="hsc-title">{{ hsc_first }}<em>{{ hsc_last }}</em></h1>
    <p class="hsc-d">{{ 'claude.hero.x1_html' | t }}</p>
    <a class="hsc-btn" href="{{ hsc_link }}">{{ 'claude.hero.b1_html' | t }}</a>
  </div>
  <div class="hsc-ui">
    <p class="hsc-hint" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12c0-2.2 4-4 9-4s9 1.800 9 4-4 4-9 4"/><path d="M9 13.500 12 16l-3 2.500"/></svg>{{ hsc_hint }}</p>
    <div class="hsc-chips" role="group" aria-label="{{ 'claude.hero.aria_pick_html' | t | strip_html | escape }}">{%- for m in hsc_models -%}{%- assign m0 = m | split: '|' -%}<button type="button" class="hsc-chip{% if forloop.first %} is-on{% endif %}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ m0[0] }}</button>{%- endfor -%}</div>
  </div>
  <script type="application/json" data-hsc-cfg>{"fov": 36, "dist": 1.3, "distM": 1.62, "shiftX": 0.16, "shiftY": 0.05, "shiftYM": 0.15, "exposure": 1.12,"lib":{"three": "https://cdn.jsdelivr.net/npm/three@0.165.0/+esm", "orbit": "https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/controls/OrbitControls.js/+esm", "gltf": "https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/loaders/GLTFLoader.js/+esm"},"place":{"height": 1.1, "radius": 60, "envIntensity": 1.15, "rot": 1.15, "key": 2.2, "keyAz": -0.9, "fill": 1.5, "targetY": 0.19, "productH": 0.38, "reflect": 0.22, "polar": [1.05, 1.47, 1.53], "drift": 0.5, "startAz": -0.42,"env":{{ hsc_env | image_url: width: 3840 | json }},"envM":{{ hsc_env | image_url: width: 2048 | json }}},"models":[{%- for m in hsc_models -%}{%- assign m0 = m | split: '|' -%}{"name":{{ m0[0] | json }},"src":"https://cdn.shopify.com/3d/models/o/{{ m0[1] }}"}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}</script>
</div>
<script type="module">
/* claude-hero-scene: product stands still on the table, the camera orbits through a real 360° place. */
(function () {
  document.querySelectorAll('[data-hsc]:not([data-hsc-on])').forEach(function (el) {
    el.setAttribute('data-hsc-on', '');
    var io = new IntersectionObserver(function (en) {
      if (en[0].isIntersecting) { io.disconnect(); boot(el); }
    }, { rootMargin: '200px' });
    io.observe(el);
  });

  async function boot(el) {
    var cfg = JSON.parse(el.querySelector('[data-hsc-cfg]').textContent);
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var mobile = matchMedia('(max-width: 749px)').matches;
    var canvas = el.querySelector('.hsc-canvas');
    var THREE, OrbitControls, GLTFLoader;
    try {
      var m = await Promise.all([import(cfg.lib.three), import(cfg.lib.orbit), import(cfg.lib.gltf)]);
      THREE = m[0]; OrbitControls = m[1].OrbitControls; GLTFLoader = m[2].GLTFLoader;
    } catch (e) { el.classList.add('hsc-fail'); return; } // poster stays

    var renderer;
    try { renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, powerPreference: 'high-performance' }); }
    catch (e) { el.classList.add('hsc-fail'); return; }
    var dpr = Math.min(window.devicePixelRatio || 1, mobile ? 1.5 : 1.75);
    renderer.setPixelRatio(dpr);
    renderer.toneMapping = THREE.NeutralToneMapping; renderer.toneMappingExposure = cfg.exposure;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    var scene = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(cfg.fov, 2, 0.05, 400);
    var P = cfg.place;
    var target = new THREE.Vector3(0, P.targetY, 0);

    // --- the place: one equirectangular photo, used as surroundings, as the table top (ground-projected) and as light
    var tex = await new THREE.TextureLoader().loadAsync(mobile ? P.envM : P.env);
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.mapping = THREE.EquirectangularReflectionMapping;
    tex.anisotropy = Math.min(8, renderer.capabilities.getMaxAnisotropy());
    scene.environment = tex;
    scene.environmentIntensity = P.envIntensity;
    scene.environmentRotation.y = P.rot; // keep reflections aligned with the visible place

    var sky = new THREE.Mesh(groundedSphere(THREE, P.height, P.radius), new THREE.MeshBasicMaterial({ map: tex, depthWrite: false, toneMapped: false }));
    sky.position.y = P.height; sky.rotation.y = P.rot; sky.renderOrder = -10;
    scene.add(sky);

    // --- light: the photo lights the product; one warm key from the brightest side + a faint photographer's fill on the camera
    var key = new THREE.DirectionalLight(0xfff0dc, P.key);
    key.position.set(Math.sin(P.keyAz) * 3, 2.2, Math.cos(P.keyAz) * 3); scene.add(key);
    var fill = new THREE.DirectionalLight(0xfff4e6, P.fill); camera.add(fill); fill.position.set(-0.4, 0.5, 1); scene.add(camera);

    // --- product slot: real GLB, never moves
    var slot = new THREE.Group(); scene.add(slot);
    var shadow = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), new THREE.MeshBasicMaterial({ transparent: true, depthWrite: false, toneMapped: false, opacity: 0 }));
    shadow.rotation.x = -Math.PI / 2; shadow.position.y = 0.0015; shadow.renderOrder = -5; scene.add(shadow);
    var loader = new GLTFLoader(), cache = {}, current = -1, fadeT = 0;

    function load(i) { return cache[i] || (cache[i] = loader.loadAsync(cfg.models[i].src).then(function (g) { return prep(g.scene); })); }

    function prep(obj) {
      var box = new THREE.Box3().setFromObject(obj), size = box.getSize(new THREE.Vector3()), c = box.getCenter(new THREE.Vector3());
      var s = P.productH / size.y; // normalise height so every product sits the same in the frame
      var g = new THREE.Group(); obj.position.set(-c.x, -box.min.y, -c.z); g.add(obj); g.scale.setScalar(s);
      // faint mirror image in the polished marble: a flipped copy drawn straight onto the table
      var mir = obj.clone(true); mir.traverse(function (o) {
        if (o.isMesh) { o.material = o.material.clone(); o.material.transparent = true; o.material.opacity = P.reflect; o.material.depthWrite = false; o.renderOrder = -4; }
      });
      var mg = new THREE.Group(); mg.add(mir); mg.scale.set(s, -s, s); mg.userData.mirror = true;
      var w = new THREE.Group(); w.add(mg, g);
      w.userData.foot = [size.x * s, size.z * s];
      return w;
    }

    function shadowTex(fx, fz) { // soft contact shadow sized to the product's footprint
      var S = 256, pad = 0.34, W = fx + pad * 2, D = fz + pad * 2, cv = document.createElement('canvas'); cv.width = cv.height = S;
      var x = cv.getContext('2d'), sx = S / W, sz = S / D;
      x.filter = 'blur(' + (0.07 * sx) + 'px)'; x.fillStyle = 'rgba(0,0,0,.7)'; x.fillRect(pad * sx - 0.05 * sx, pad * sz - 0.05 * sz, (fx + 0.1) * sx, (fz + 0.1) * sz);
      x.filter = 'blur(' + (0.012 * sx) + 'px)'; x.fillStyle = 'rgba(0,0,0,.9)'; x.fillRect(pad * sx, pad * sz, fx * sx, fz * sz);
      var t = new THREE.CanvasTexture(cv); shadow.scale.set(W, D, 1); return t;
    }

    async function show(i) {
      if (i === current) return; current = i;
      el.querySelectorAll('.hsc-chip').forEach(function (b, k) { b.classList.toggle('is-on', k === i); b.setAttribute('aria-pressed', k === i); });
      var w = await load(i); if (current !== i) return;
      slot.clear(); slot.add(w);
      if (shadow.material.map) shadow.material.map.dispose();
      shadow.material.map = shadowTex(w.userData.foot[0], w.userData.foot[1]); shadow.material.opacity = 1; shadow.material.needsUpdate = true;
      fadeT = performance.now(); kick();
    }

    // --- camera: drag = walk around the product; released, it keeps drifting
    var controls = new OrbitControls(camera, canvas);
    controls.target.copy(target);
    controls.enableZoom = false; controls.enablePan = false; controls.enableDamping = true; controls.dampingFactor = 0.06; controls.rotateSpeed = 0.55;
    controls.minPolarAngle = P.polar[0]; controls.maxPolarAngle = P.polar[2]; // never below the table top
    controls.autoRotate = !reduce; controls.autoRotateSpeed = -P.drift;
    canvas.style.touchAction = 'pan-y'; // vertical swipes still scroll the page
    var resumeT;
    controls.addEventListener('start', function () { controls.autoRotate = false; clearTimeout(resumeT); el.classList.add('hsc-used'); kick(); });
    controls.addEventListener('end', function () { if (!reduce) resumeT = setTimeout(function () { controls.autoRotate = true; kick(); }, 1400); });
    controls.addEventListener('change', function () { dirty = true; });
    el.addEventListener('keydown', function (e) { // keyboard: arrows walk around
      if (e.target !== canvas || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
      e.preventDefault(); var sph = new THREE.Spherical().setFromVector3(camera.position.clone().sub(target));
      sph.theta += e.key === 'ArrowLeft' ? -0.2 : 0.2; camera.position.setFromSpherical(sph).add(target); el.classList.add('hsc-used'); kick();
    });

    function place(az) {
      camera.position.setFromSpherical(new THREE.Spherical(cfg.dist * (mobile ? cfg.distM : 1), P.polar[1], az)).add(target);
      controls.update();
    }
    function size() {
      var w = el.clientWidth, h = el.clientHeight; if (!w || !h) return;
      mobile = matchMedia('(max-width: 749px)').matches;
      renderer.setSize(w, h, false); camera.aspect = w / h;
      // keep the product's size tied to the hero height, and push it to the right half on desktop / lower half on phones
      camera.fov = cfg.fov; camera.zoom = 1;
      var ox = mobile ? 0 : -w * cfg.shiftX, oy = mobile ? -h * cfg.shiftYM : -h * cfg.shiftY;
      camera.setViewOffset(w, h, ox, oy, w, h); camera.updateProjectionMatrix(); dirty = true;
    }

    var running = false, visible = true, dirty = true, raf = 0, frames = 0;
    function kick() { dirty = true; if (!running && visible && !document.hidden) { running = true; raf = requestAnimationFrame(tick); } }
    function tick() {
      var moving = controls.update() || controls.autoRotate; // update() applies drift + damping
      var f = Math.min(1, (performance.now() - fadeT) / 500);
      if (f < 1) dirty = true;
      if (dirty || moving) { renderer.render(scene, camera); dirty = false; frames++; }
      if (frames === 2) el.classList.add('hsc-live'); // canvas only becomes visible once the product is placed and drawn
      el.__hsc.az = controls.getAzimuthalAngle();
      if ((moving || f < 1) && visible && !document.hidden) raf = requestAnimationFrame(tick); else running = false;
    }
    new IntersectionObserver(function (en) { visible = en[0].isIntersecting; if (visible) kick(); }).observe(el);
    document.addEventListener('visibilitychange', kick);
    new ResizeObserver(function () { size(); kick(); }).observe(el);

    el.__hsc = { camera: camera, controls: controls, renderer: renderer, scene: scene, az: 0, show: show, THREE: THREE };
    el.querySelectorAll('.hsc-chip').forEach(function (b, k) {
      b.addEventListener('click', function () { show(k); });
      b.addEventListener('pointerenter', function () { load(k); }); b.addEventListener('focus', function () { load(k); }); // other models load only when asked for
    });
    size(); place(P.startAz);
    await show(0);
  }

  // sphere whose lower half is flattened to a real ground plane (same idea as three's GroundedSkybox), ground at y = -height
  function groundedSphere(THREE, height, radius) {
    var g = new THREE.SphereGeometry(radius, 256, 128); g.scale(1, 1, -1);
    var pos = g.getAttribute('position'), v = new THREE.Vector3(), y1 = -height * 1.5;
    for (var i = 0; i < pos.count; i++) {
      v.fromBufferAttribute(pos, i);
      if (v.y < 0) { v.multiplyScalar(v.y < y1 ? -height / v.y : 1 - v.y * v.y / (3 * y1 * y1)); v.toArray(pos.array, 3 * i); }
    }
    return g;
  }
})();
</script>
