{%- comment -%} Teil der Section claude-home (Claude · Neue Homepage 11.11.2026 – nicht anfassen). 12.11.2026: Advent, Geschenke nach Budget und Geschenk statt Rabatt stehen jetzt vor DUMO; Kenner-Karte Parfums de Marly → Signature Royale. {%- endcomment -%}
{%- liquid
  assign s = sec.settings
  assign c_dumo = collections[s.col_dumo]
-%}
  {%- comment -%} 6a · ADVENT, GESCHENKE NACH BUDGET, GESCHENK STATT RABATT (aus claude-home-c, Teil 'gifts') {%- endcomment -%}
  {%- render 'claude-home-c', sec: sec, part: 'gifts' -%}

  {%- comment -%} 6 · DUMO – Turm der Gladiatoren {%- endcomment -%}
  {%- render 'claude-home-dumo', sec: sec -%}

  {%- comment -%} 7 · HAUTE PARFUMERIE {%- endcomment -%}
  <section class="ch-sec ch-dark" style="padding-top:0">
    <div class="ch-wrap">
      <div class="ch-head"><div><p class="ch-eyebrow">Haute Parfumerie</p><h2 class="ch-h2">Die Häuser der Kenner</h2><p class="ch-lead">Nischenparfums, die man nicht überall findet.</p></div><a class="ch-btn ch-btn--line" style="color:var(--acc)" href="{{ routes.collections_url }}/{{ s.col_nische }}">Alle Nischendüfte</a></div>
      <div class="ch-grid">
        {%- assign houses = 'parfums-marc-antoine-barrois:Marc-Antoine Barrois:PARIS,signature-royale:Signature Royale:,creed:Creed:LONDON · PARIS,initio:Initio:PARIS' | split: ',' -%}
        {%- for h in houses -%}
          {%- assign hp = h | split: ':' -%}{%- assign hc = collections[hp[0]] -%}
          <a class="ch-arch ch-glassD ch-sheen ch-tilt" href="{{ routes.collections_url }}/{{ hp[0] }}">
            {%- if hc.products.first.featured_image -%}{{ hc.products.first.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
            {%- if hp[2] != blank -%}<span class="ch-arch__k">{{ hp[2] }}</span>{%- else -%}<span class="ch-arch__k" aria-hidden="true">&nbsp;</span>{%- endif -%}
            <span class="ch-arch__t">{{ hp[1] }}</span>
            <span class="ch-arch__d">{% if hc.products_count > 0 %}{{ hc.products_count }} Düfte{% endif %} <span style="color:var(--acc)">→</span></span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} 8 · FÜR WEN {%- endcomment -%}
  <section class="ch-sec" style="padding-bottom:40px">
    <div class="ch-wrap">
      <div class="ch-head"><div><p class="ch-eyebrow">Luxus- und Nischenparfums bei Black Elixir</p><h2 class="ch-h2">Für wen suchst du?</h2></div></div>
      <style>
        .ch .ch-gender a{background:#0d0b09!important;isolation:isolate}
        .ch-gender .gw{position:absolute;inset:0;z-index:-1}
        .ch-gender .gw img,.ch-gender .gw video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.04);transition:transform 1.4s cubic-bezier(.2,.7,.2,1),opacity .8s}
        .ch-gender .gw video{opacity:0}
        .ch-gender a:hover .gw img,.ch-gender a:hover .gw video{transform:scale(1.12)}
        .ch-gender a.play .gw video{opacity:1}
        .ch-gender .gw::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05) 35%,rgba(0,0,0,.7))}
        .ch .ch-gender .num{top:auto;bottom:118px;left:22px;right:auto;text-align:left;font-size:44px;color:rgba(255,246,222,.55);text-shadow:0 4px 24px rgba(0,0,0,.5);font-family:"Bodoni Moda",Georgia,serif}
        .ch .ch-gender .cap b{white-space:nowrap;font-size:clamp(15px,1.3vw,24px)}
        .ch .ch-gender a:hover .cap b{font-size:clamp(20px,1.9vw,28px)}
        @media (max-width:860px){.ch .ch-gender .num{font-size:34px;bottom:84px;left:16px}.ch .ch-gender .cap{padding:12px 14px}.ch .ch-gender .cap b{font-size:17px}}
      </style>
      <div class="ch-gender">
        {%- assign gd = 'damenparfum:Damendüfte:Für sie:ch-damen-glass-floral,herrenduefte:Herrendüfte:Für ihn:ch-herren-rose-figure,unisex-parfums:Unisexdüfte:Für alle:ch-unisex-hands,nischenduefte:Nischendüfte:Für Kenner:ch-nische-statue' | split: ',' -%}
        {%- for g in gd -%}{%- assign gp = g | split: ':' -%}{%- assign gimg = gp[3] | append: '.webp' -%}
          <a href="{{ routes.collections_url }}/{{ gp[0] }}" class="ch-sheen" data-gv="https://cdn.shopify.com/s/files/1/0762/4949/7942/files/{{ gp[3] }}.mp4"><span class="gw" aria-hidden="true">{{ images[gimg] | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '', sizes: '(max-width: 860px) 50vw, 40vw', widths: '400,700,1000,1200' }}</span><span class="num" aria-hidden="true">0{{ forloop.index }}</span><span class="cap ch-glassD"><small>{{ gp[2] | upcase }}</small><b>{{ gp[1] }}</b></span></a>
        {%- endfor -%}
      </div>
      <script>
        (function () {
          if (!matchMedia('(hover:hover)').matches || matchMedia('(prefers-reduced-motion:reduce)').matches) return;
          document.currentScript.previousElementSibling.querySelectorAll('a[data-gv]').forEach(function (a) {
            a.addEventListener('mouseenter', function () {
              var v = a.querySelector('video');
              if (!v) { v = document.createElement('video'); v.muted = true; v.loop = true; v.playsInline = true; v.preload = 'auto'; v.src = a.dataset.gv; v.addEventListener('error', function () { v.remove(); a.removeAttribute('data-gv'); }); a.querySelector('.gw').appendChild(v); v.addEventListener('playing', function () { a.classList.add('play'); }); }
              v.play().catch(function () {});
            });
            a.addEventListener('mouseleave', function () { var v = a.querySelector('video'); if (v) v.pause(); a.classList.remove('play'); });
          });
        })();
      </script>
    </div>
  </section>

  {%- comment -%} 9 · DUFT-FINDER – mit Stimmungsvideo je Duftrichtung (Bilder/Videos be-mood-*, Claude 12.11.2026) {%- endcomment -%}
  <style>
    #ch-finder{background:var(--mood,#fff);transition:background-color 1.2s ease}
    .ch-mv{position:relative;margin-top:34px;width:100%;max-width:580px;aspect-ratio:4/3;border-radius:28px;overflow:hidden;background:#111;box-shadow:0 30px 60px rgba(0,0,0,.18);isolation:isolate}
    .ch-mvi{position:absolute;inset:0;margin:0;opacity:0;transition:opacity 1.1s ease}
    .ch-mvi.on{opacity:1}
    .ch-mvi img,.ch-mvi video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
    .ch-mvi video{opacity:0;transition:opacity .7s ease}
    .ch-mvi video.go{opacity:1}
    .ch-mv-sheen{position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(115deg,transparent 38%,rgba(255,255,255,.42) 50%,transparent 62%);mix-blend-mode:soft-light;transform:translateX(-130%);animation:chMvSheen 7s ease-in-out infinite}
    @keyframes chMvSheen{0%,55%{transform:translateX(-130%)}85%,100%{transform:translateX(130%)}}
    .ch-mv::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;box-shadow:inset 0 0 80px rgba(0,0,0,.25)}
    @media (max-width:860px){.ch-mv{margin-top:22px;border-radius:22px}}
    @media (prefers-reduced-motion:reduce){.ch-mv-sheen{display:none}}
  </style>
  <section class="ch-sec" id="ch-finder">
    <span class="ch-blob" style="width:460px;height:460px;right:4%;top:60px;background:var(--acc)"></span>
    <div class="ch-wrap ch-finder">
      <div><p class="ch-eyebrow">Duft-Finder in 10 Sekunden</p><h2 class="ch-h2">Welche Stimmung trägst du heute?</h2><p class="ch-lead">Wähle ein Gefühl – wir zeigen dir die passende Welt.</p>
        <div class="ch-mv" data-ch-mv>
          {%- assign mimgs = 'be-mood-dunkel.png|#ece5dc|Oud-Holz, Leder und Rauch|eeb4c7367f6f4a0282b17850e8e2ec70/eeb4c7367f6f4a0282b17850e8e2ec70.HD-720p-4.5Mbps-100941396;be-mood-warm.png|#f6eadb|Ambra, Vanille und Tonka im Kerzenlicht|4e898982126b4350b32d6d4d44b1f469/4e898982126b4350b32d6d4d44b1f469.HD-720p-4.5Mbps-100941397;be-mood-frisch.png|#e6f0f5|Bergamotte, Zitrone und Meer|305fb4da296f4528a34931d9beae8783/305fb4da296f4528a34931d9beae8783.HD-720p-3.0Mbps-100941398;be-mood-pudrig.png|#f3e8ef|Iris, Rose und Puder|02e32a89213c40a69cbbc77399840279/02e32a89213c40a69cbbc77399840279.HD-720p-4.5Mbps-100941399' | split: ';' -%}
          {%- for mi in mimgs -%}{%- assign mq = mi | split: '|' -%}
            <figure class="ch-mvi{% if forloop.first %} on{% endif %}" data-bg="{{ mq[1] }}" data-v="https://cdn.shopify.com/videos/c/vp/{{ mq[3] }}.mp4">{{ images[mq[0]] | image_url: width: 1200 | image_tag: loading: 'lazy', alt: mq[2], sizes: '(max-width: 860px) 92vw, 580px', widths: '600,900,1200' }}</figure>
          {%- endfor -%}
          <span class="ch-mv-sheen" aria-hidden="true"></span>
        </div>
      </div>
      <div>
        <div class="ch-moods" data-ch-moods>
          {%- assign moods = 'Dunkel & mächtig|Oud, Leder, Rauch|DUMO – die Gladiatoren|' | append: s.col_dumo | append: ';Warm & verführerisch|Ambra, Vanille, Tonka|Nischendüfte|' | append: s.col_nische | append: ';Frisch & klar|Bergamotte, Zitrus, Meer|Herrendüfte|herrenduefte;Pudrig & poetisch|Iris, Rose, Moschus|Fragrance Library|' | append: s.col_library | split: ';' -%}
          {%- for m in moods -%}{%- assign mp = m | split: '|' -%}
            <button type="button" class="ch-mood{% if forloop.first %} is-on{% endif %}" data-t="{{ mp[2] }}" data-u="{{ routes.collections_url }}/{{ mp[3] }}"><span><b>{{ mp[0] }}</b><small>{{ mp[1] }}</small></span><span aria-hidden="true">{% if forloop.first %}●{% else %}○{% endif %}</span></button>
          {%- endfor -%}
        </div>
        <div class="ch-result"><span><small style="font-size:12px;letter-spacing:.3em;color:var(--acc)">DEINE WELT</small><b data-ch-rt>DUMO – die Gladiatoren</b></span><a class="ch-btn ch-btn--gold" data-ch-ru href="{{ c_dumo.url }}">Düfte ansehen</a></div>
      </div>
    </div>
  </section>
  <script>
    (function () {
      var s = document.getElementById('ch-finder'); if (!s) return;
      var f = s.querySelectorAll('.ch-mvi'), b = s.querySelectorAll('.ch-mood'), cur = 0, seen = false;
      var still = matchMedia('(prefers-reduced-motion:reduce)').matches;
      function vid(fig) {
        var v = fig.querySelector('video');
        if (!v && !still && fig.dataset.v) {
          v = document.createElement('video'); v.muted = true; v.playsInline = true; v.preload = 'auto'; v.setAttribute('aria-hidden', 'true'); v.src = fig.dataset.v;
          v.addEventListener('playing', function () { v.classList.add('go'); });
          v.addEventListener('timeupdate', function () { if (v.duration && v.currentTime > v.duration - 0.8) v.classList.remove('go'); });
          v.addEventListener('ended', function () { v.currentTime = 0; if (fig.classList.contains('on')) v.play().catch(function () {}); });
          v.addEventListener('error', function () { v.remove(); });
          fig.appendChild(v);
        }
        return v;
      }
      function on(i) {
        cur = i;
        f.forEach(function (y, k) { y.classList.toggle('on', k === i); var v = y.querySelector('video'); if (v && k !== i) { v.pause(); v.classList.remove('go'); } });
        if (f[i]) { s.style.setProperty('--mood', f[i].dataset.bg); if (seen) { var v = vid(f[i]); if (v) { v.currentTime = 0; v.play().catch(function () {}); } } }
      }
      b.forEach(function (x, i) { x.addEventListener('click', function () { on(i); }); });
      f.forEach(function (y) { var im = y.querySelector('img'); if (im) im.loading = 'eager'; });
      on(0);
      if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { es.forEach(function (e) { var v; if (e.isIntersecting) { seen = true; v = vid(f[cur]); if (v) v.play().catch(function () {}); } else { v = f[cur].querySelector('video'); if (v) v.pause(); } }); }, { threshold: .2 }).observe(s);
    })();
  </script>

  {%- comment -%} 10 · FRAGRANCE LIBRARY – Bücherregal {%- endcomment -%}
  {%- render 'claude-home-library', sec: sec -%}