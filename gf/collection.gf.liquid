{%- layout none -%}
{%- comment -%} Geschenk-Finder Datenquelle: JSON der aktuell gefilterten/sortierten Kollektion (?view=gf). Claude 21.11.2026 {%- endcomment -%}
{%- paginate collection.products by 48 -%}
{"items":[
{%- for p in collection.products -%}
{%- assign av = p.variants | where: 'available' -%}
{%- if av.size > 0 -%}
{%- unless first_done == nil -%},{%- endunless -%}{%- assign first_done = true -%}
{"h":{{ p.handle | json }},"t":{{ p.title | json }},"v":{{ p.vendor | json }},"i":{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 520 | json }}{%- else -%}""{%- endif -%},"c":{{ p.collections | map: 'handle' | json }},"r":{{ forloop.index }},"x":[{%- for v in av -%}[{{ v.id }},{{ v.price | divided_by: 100.0 }},{{ v.title | json }}]{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
{%- endif -%}
{%- endfor -%}
]}
{%- endpaginate -%}
