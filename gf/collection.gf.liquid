{%- layout none -%}
{%- comment -%} Geschenk-Finder Datenquelle: JSON der aktuell gefilterten/sortierten Kollektion (?view=gf). Claude 21.11.2026 {%- endcomment -%}
{%- paginate collection.products by 48 -%}
{"items":[
{%- for p in collection.products -%}
{%- assign mp = nil -%}
{%- for v in p.variants -%}{%- if v.available -%}{%- if mp == nil or v.price < mp -%}{%- assign mp = v.price -%}{%- endif -%}{%- endif -%}{%- endfor -%}
{%- if mp != nil -%}
{%- unless first_done == nil -%},{%- endunless -%}{%- assign first_done = true -%}
{"h":{{ p.handle | json }},"t":{{ p.title | json }},"v":{{ p.vendor | json }},"p":{{ mp | divided_by: 100.0 | json }},"i":{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 520 | json }}{%- else -%}""{%- endif -%},"u":{{ p.url | json }},"c":{{ p.collections | map: 'handle' | json }},"r":{{ forloop.index }}}
{%- endif -%}
{%- endfor -%}
]}
{%- endpaginate -%}
