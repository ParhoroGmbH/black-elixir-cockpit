function has(p,c){return p.c.indexOf(c)>-1}
function pool(kind,who,b){
  var g=G[who];
  if(kind==='klassik')return list(g,b).then(function(l){return l.filter(function(p){return !has(p,'nischenduefte')&&!has(p,'arabische-duefte')})});
