async function pick(){
  var who=A.who,b=+A.bud,k=A.kind==='duft'?A.char:A.kind,kinds=[k];if(k!=='klassik')kinds.push('klassik');
  var out=[],seen={};
  for(var ki=0;ki<kinds.length;ki++){for(var bb=b;bb>=0;bb--){var l=await pool(kinds[ki],who,bb);l.forEach(function(p){if(!seen[p.h]){seen[p.h]=1;p.k=kinds[ki];out.push(p)}});if(out.filter(function(p){return p.k===k}).length>=8)break}if(out.length>=3)break}
  if(A.when){var want=A.when==='abend'?/(eau de parfum|extrait|parfum$)/i:/eau de toilette|cologne/i;var head=out.slice(0,10);head.sort(function(x,y){return (want.test(y.t)?1:0)-(want.test(x.t)?1:0)});out=head.concat(out.slice(10))}
  var res=[],vs={},own=out.filter(function(p){return p.k===k});
  own.forEach(function(p){if(res.length<3&&!vs[p.v]){vs[p.v]=1;res.push(p)}});
