var IMGS={paper:{{ images['gf-paper.webp'] | image_url: width: 1100 | json }},seal:{{ images['gf-seal.webp'] | image_url: width: 300 | json }},bg:{{ images['gf-bg.jpg'] | image_url: width: 1200 | json }},logo:{{ images['BLACK_ELIXIR_LOGO_Transp._White_2.png'] | image_url: width: 600 | json }}};
function code(){var S=steps();return S.map(function(x){return A[x.id]}).join('-')}
function shareURL(){return location.origin+location.pathname+'?w='+code()}
function loadImg(u){return new Promise(function(ok,no){var i=new Image();i.crossOrigin='anonymous';i.onload=function(){ok(i)};i.onerror=no;i.src=u})}
function wrap(ctx,t,max){var w=t.split(' '),out=[],cur='';w.forEach(function(x){var tt=cur?cur+' '+x:x;if(ctx.measureText(tt).width>max&&cur){out.push(cur);cur=x}else cur=tt});if(cur)out.push(cur);return out}
async function cardBlob(){
  var W=1080,H=1350,c=document.createElement('canvas');c.width=W;c.height=H;var x=c.getContext('2d');
  var im=await Promise.all([loadImg(IMGS.bg),loadImg(IMGS.paper),loadImg(IMGS.seal),loadImg(IMGS.logo)]);
  var bg=im[0],s=Math.max(W/bg.width,H/bg.height);x.drawImage(bg,(W-bg.width*s)/2,(H-bg.height*s)/2,bg.width*s,bg.height*s);x.fillStyle='rgba(10,20,16,.45)';x.fillRect(0,0,W,H);
  var lg=im[3],lw=300;x.drawImage(lg,(W-lw)/2,52,lw,lw*lg.height/lg.width);
  var px=110,py=200,pw=W-220,ph=980;x.save();x.shadowColor='rgba(0,0,0,.55)';x.shadowBlur=40;x.shadowOffsetY=22;x.translate(W/2,py+ph/2);x.rotate(0.012);x.drawImage(im[1],-pw/2,-ph/2,pw,ph);x.restore();
  var rtl=document.documentElement.dir==='rtl',ff=getComputedStyle(document.querySelector('.lines')).fontFamily;
  x.fillStyle='#1d2436';x.direction=rtl?'rtl':'ltr';x.textAlign=rtl?'right':'left';var tx=rtl?px+pw-80:px+80,ty=py+130,fs=46;x.font=fs+'px '+ff;
  try{await document.fonts.load(fs+'px '+ff)}catch(e){}
  var lines=[].map.call(document.querySelectorAll('#lines li'),function(l){return l.textContent});lines.push($('sig').textContent);
  var all=[];lines.forEach(function(l){all=all.concat(wrap(x,l,pw-160))});var lh=Math.min(64,(ph-230)/all.length);all.forEach(function(l,i){x.fillText(l,tx,ty+i*lh)});
  var sl=im[2],sw=170;x.drawImage(sl,rtl?px+50:px+pw-sw-50,py+ph-sw+40,sw,sw*sl.height/sl.width);
  x.direction='ltr';x.textAlign='center';x.fillStyle='rgba(244,237,224,.85)';x.font='500 30px Jost, Arial, sans-serif';x.fillText('black-elixir.com',W/2,H-56);
  return await new Promise(function(r){c.toBlob(r,'image/jpeg',.9)});
}
$('share').onclick=async function(){
  var url=shareURL(),text=q('share_text');
  $('wa').href='https://wa.me/?text='+encodeURIComponent(text+' '+url);
  try{
    var b=await cardBlob(),f=new File([b],'wunschbrief-black-elixir.jpg',{type:'image/jpeg'});window._gfBlob=b;
    if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f],text:text+' '+url});return}
    if(navigator.share){await navigator.share({title:document.title,text:text,url:url});return}
  }catch(e){if(e&&e.name==='AbortError')return}
  $('sharealt').hidden=false;
};
$('copy').onclick=function(){var u=shareURL(),b=this;(navigator.clipboard?navigator.clipboard.writeText(u):Promise.reject()).then(function(){b.textContent=q('copied')}).catch(function(){prompt('',u)})};
$('saveimg').onclick=async function(){var b=window._gfBlob||await cardBlob(),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='wunschbrief-black-elixir.jpg';document.body.appendChild(a);a.click();a.remove()};
/* deep link: ?w=sie-1-duft-orient-abend */
(function(){var w=new URLSearchParams(location.search).get('w');if(!w)return;var p=w.split('-'),ok=true;
  var kind=p[2],i=0;Q.forEach(function(x){if(x.only&&kind!==x.only)return;var v=p[i++];if(!x.o.some(function(o){return o[0]===v}))ok=false;else A[x.id]=v});
  if(!ok){A={};return}step=steps().length;drawLines();$('lines').querySelectorAll('li').forEach(function(l){l.className='done'});finish()})();
$('start').onclick=function(){renderQ();var f=document.querySelector('.opt');f&&f.focus()};
