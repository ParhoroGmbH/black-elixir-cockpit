  if(kind==='pflege'){if(who==='alle')return Promise.all([list('koerperpflege-fuer-damen',b),list('herren-koerperpflege',b)]).then(function(r){return r[0].concat(r[1])});
    return list(who==='sie'?'koerperpflege-fuer-damen':'herren-koerperpflege',b)}
