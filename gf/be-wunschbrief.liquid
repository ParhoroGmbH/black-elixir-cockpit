{%- comment -%} Startseite: kompakter Hinweis auf den Geschenk-Finder. Öffnet den Geschenk-Finder als eigene Seite (?from=home zeigt dort ein Schließen-Kreuz). Wird per Script unter das Marken-Laufband (.ch-marq) verschoben. Claude 21.11.2026 {%- endcomment -%}
{%- assign wb_l = request.locale.iso_code | slice: 0, 2 -%}
{%- assign wb_root = routes.root_url -%}{%- if wb_root == '/' -%}{%- assign wb_root = '' -%}{%- endif -%}
{%- assign wb_url = wb_root | append: '/pages/geschenk-finder' -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap">
<section class="wb"{% if wb_l == 'ar' or wb_l == 'he' %} dir="rtl"{% endif %}>
  <div class="wb-in">
    <img class="wb-seal" src="{{ images['gf-seal.webp'] | image_url: width: 180 }}" alt="" width="90" height="93" loading="lazy">
    <div class="wb-txt"><strong>{% case wb_l -%}{%- when 'en' -%}Still looking for the right gift?{%- when 'fr' -%}Toujours à la recherche du bon cadeau ?{%- when 'it' -%}Ancora alla ricerca del regalo giusto?{%- when 'da' -%}Leder du stadig efter den rigtige gave?{%- when 'ar' -%}ما زلت تبحث عن الهدية المناسبة؟{%- when 'he' -%}עדיין מחפשים את המתנה המתאימה?{%- else -%}Noch auf der Suche nach dem richtigen Geschenk?{%- endcase %}</strong><span>{% case wb_l -%}{%- when 'en' -%}Write us your wish letter – we'll find it in five short questions.{%- when 'fr' -%}Écris-nous ta lettre de souhaits – nous le trouvons en cinq petites questions.{%- when 'it' -%}Scrivici la tua lettera dei desideri: lo troviamo in cinque brevi domande.{%- when 'da' -%}Skriv dit ønskebrev til os – vi finder den med fem korte spørgsmål.{%- when 'ar' -%}اكتب لنا رسالة أمنياتك، وسنجدها لك في خمسة أسئلة قصيرة.{%- when 'he' -%}כתבו לנו מכתב משאלות – נמצא אותה בחמש שאלות קצרות.{%- else -%}Schreib uns deinen Wunschbrief – wir finden es in fünf kurzen Fragen.{%- endcase %}</span></div>
    <a class="wb-btn" id="wb-open" href="{{ wb_url }}?from=home">{% case wb_l -%}{%- when 'en' -%}Write my wish letter{%- when 'fr' -%}Écrire ma lettre{%- when 'it' -%}Scrivi la lettera{%- when 'da' -%}Skriv ønskebrev{%- when 'ar' -%}اكتب رسالتك{%- when 'he' -%}לכתוב מכתב משאלות{%- else -%}Wunschbrief schreiben{%- endcase %}</a>
  </div>
</section>
<style>
.wb{background:linear-gradient(rgba(10,20,16,.55),rgba(10,20,16,.7)),url({{ images['gf-bg.jpg'] | image_url: width: 1600 }}) center/cover,#0f1c18;color:#f4ede0;padding:22px 16px}
.wb-in{max-width:1080px;margin:0 auto;padding-inline:16px;box-sizing:border-box;display:flex;align-items:center;gap:22px;flex-wrap:wrap;justify-content:center}
.wb-seal{width:64px;height:auto;flex:none;transform:rotate(-8deg);filter:drop-shadow(0 6px 8px rgba(0,0,0,.45))}
.wb-txt{flex:1 1 320px;display:grid;gap:4px;min-width:0}
.wb-txt strong{font:400 clamp(24px,2.4vw,32px)/1.15 'Cormorant Garamond',Didot,serif;color:#f4ede0}
.wb-txt span{font:400 15px/1.5 Jost,'Helvetica Neue',Arial,sans-serif;color:#d9d2c4}
.wb-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 28px;background:#bf9a55;color:#17120a;text-decoration:none;font:500 13px/1 Jost,Arial,sans-serif;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;transition:background .2s}
[dir=rtl] .wb-btn{letter-spacing:0}
.wb-btn:hover{background:#e2c88f}.wb-btn:focus-visible{outline:2px solid #f4ede0;outline-offset:3px}
@media (max-width:640px){.wb-in{gap:14px}.wb-seal{width:50px}.wb-txt{flex-basis:calc(100% - 70px)}.wb-btn{width:100%}}
</style>
<script>(function(){
var w=document.currentScript.previousElementSibling;while(w&&!(w.classList&&w.classList.contains('wb')))w=w.previousElementSibling;
var m=document.querySelector('.ch .ch-marq');if(w&&m&&m.parentNode){var box=w.closest('.shopify-section');m.parentNode.insertBefore(w,m.nextSibling)}
})();</script>
{% schema %}
{"name":"Wunschbrief Hinweis","settings":[],"presets":[{"name":"Wunschbrief Hinweis"}]}
{% endschema %}
