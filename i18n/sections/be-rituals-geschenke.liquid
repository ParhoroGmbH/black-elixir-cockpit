{%- comment -%}
  BE Rituals-Geschenke (CEO 04.11.2026 11:25 – NUR Vorschau in Kopie 213152825735, live erst nach separatem CEO-OK).
  layout 'guide'   = Geschenkeguide nach Budget (templates/page.rituals-geschenke.json): Stufen unter 30 € / bis 40 € / bis 65 €.
  layout 'teaser'  = Startseiten-Kachel mit den drei Budgetstufen, verlinkt auf den Guide (templates/index.json).
  layout 'grid'    = Produktraster + S+M-Kombinationen (Blöcke 'combo') für die Black-Week-Seite (templates/page.black-week.json).
  Stufe wird LIVE aus dem aktuellen Preis berechnet; nur vorrätige Produkte (product.available) werden gezeigt.
  Bewusst KEIN Streichpreis/compare_at, kein Rabatt, kein Code (UVP-Regel be-uvp-ausnahme bleibt unberührt; Rituals ist keine Ausnahme-Marke).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign t1 = s.tier1_max | times: 100
  assign t2 = s.tier2_max | times: 100
  assign t3 = s.tier3_max | times: 100
  assign c1 = 0
  assign c2 = 0
  assign c3 = 0
  assign img1 = nil
  assign img2 = nil
  assign img3 = nil
  for p in s.products
    unless p.available
      continue
    endunless
    if p.price < t1
      assign c1 = c1 | plus: 1
      if img1 == nil
        assign img1 = p.featured_image
      endif
    elsif p.price <= t2
      assign c2 = c2 | plus: 1
      if img2 == nil
        assign img2 = p.featured_image
      endif
    elsif p.price <= t3
      assign c3 = c3 | plus: 1
      if img3 == nil
        assign img3 = p.featured_image
      endif
    endif
  endfor
  assign tier_labels = s.tier1_label | append: '|' | append: s.tier2_label | append: '|' | append: s.tier3_label | split: '|'
  assign tier_ids = 'unter-30|bis-40|bis-65' | split: '|'
-%}
<div class="be-rit be-rit--{{ s.layout }} page-width" id="be-rit-{{ section.id }}">
  <div class="be-rit__head">
    {%- if s.eyebrow != blank -%}<p class="be-rit__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    {%- if s.heading != blank -%}
      {%- if s.layout == 'guide' and s.heading_h1 -%}<h1 class="be-rit__h heading--{{ settings.typography_preset }}">{{ s.heading | escape }}</h1>
      {%- else -%}<h2 class="be-rit__h heading--{{ settings.typography_preset }}">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- endif -%}
    {%- if s.intro != blank -%}<p class="be-rit__intro">{{ s.intro | escape }}</p>{%- endif -%}
  </div>

  {%- if s.layout == 'teaser' -%}
    <ul class="be-rit__tiles" role="list">
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign c = c1
              assign im = img1
            when 2
              assign c = c2
              assign im = img2
            else
              assign c = c3
              assign im = img3
          endcase
          assign idx = i | minus: 1
        -%}
        {%- if c > 0 -%}
        <li class="be-rit__tile">
          <a href="{{ s.link | default: '#' }}#{{ tier_ids[idx] }}" class="be-rit__tile-link">
            {%- if im -%}<img src="{{ im | image_url: width: 500 }}" srcset="{{ im | image_url: width: 300 }} 300w, {{ im | image_url: width: 500 }} 500w" sizes="(max-width: 749px) 33vw, 300px" alt="" width="300" height="300" loading="lazy">{%- endif -%}
            <span class="be-rit__tile-label">{{ tier_labels[idx] | escape }}</span>
            <span class="be-rit__tile-count">{{ c }} {% if c == 1 %}Set{% else %}Sets{% endif %}</span>
          </a>
        </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if s.link != blank and s.link_label != blank -%}<p class="be-rit__cta"><a class="be-rit__btn-link" href="{{ s.link }}">{{ s.link_label | escape }}</a></p>{%- endif -%}

  {%- elsif s.layout == 'guide' -%}
    <nav class="be-rit__jump" aria-label="{{ 'claude.r.budget_html' | t }}">
      {%- if c1 > 0 -%}<a href="#{{ tier_ids[0] }}">{{ tier_labels[0] | escape }}</a>{%- endif -%}
      {%- if c2 > 0 -%}<a href="#{{ tier_ids[1] }}">{{ tier_labels[1] | escape }}</a>{%- endif -%}
      {%- if c3 > 0 -%}<a href="#{{ tier_ids[2] }}">{{ tier_labels[2] | escape }}</a>{%- endif -%}
    </nav>
    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign c = c1
            assign lo = 0
            assign hi = t1
          when 2
            assign c = c2
            assign lo = t1
            assign hi = t2 | plus: 1
          else
            assign c = c3
            assign lo = t2 | plus: 1
            assign hi = t3 | plus: 1
        endcase
        assign idx = i | minus: 1
      -%}
      {%- if c > 0 -%}
      <section class="be-rit__tier" id="{{ tier_ids[idx] }}" aria-labelledby="be-rit-t{{ i }}-{{ section.id }}">
        <h2 class="be-rit__tier-h" id="be-rit-t{{ i }}-{{ section.id }}">{{ tier_labels[idx] | escape }}</h2>
        <ul class="be-rit__grid" role="list">
          {%- for p in s.products -%}
            {%- if p.available and p.price >= lo and p.price < hi -%}
              <li>{%- render 'be-rituals-karte', p: p -%}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </section>
      {%- endif -%}
    {%- endfor -%}

  {%- else -%}
    {%- assign shown = 0 -%}
    <ul class="be-rit__grid" role="list">
      {%- for p in s.products -%}
        {%- if p.available -%}{%- assign shown = shown | plus: 1 -%}<li>{%- render 'be-rituals-karte', p: p -%}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
    {%- assign combo_html = '' -%}
    {%- capture combo_html -%}
      {%- for block in section.blocks -%}
        {%- assign a = block.settings.product_a -%}
        {%- assign b = block.settings.product_b -%}
        {%- if a != blank and b != blank and a.available and b.available -%}
          {%- assign va = a.selected_or_first_available_variant -%}
          {%- assign vb = b.selected_or_first_available_variant -%}
          {%- assign sum = va.price | plus: vb.price -%}
          <li class="be-rit-combo" {{ block.shopify_attributes }}>
            <div class="be-rit-combo__media">
              {%- if a.featured_image -%}<img src="{{ a.featured_image | image_url: width: 400 }}" alt="{{ a.title | escape }}" width="200" height="200" loading="lazy">{%- endif -%}
              <span aria-hidden="true">+</span>
              {%- if b.featured_image -%}<img src="{{ b.featured_image | image_url: width: 400 }}" alt="{{ b.title | escape }}" width="200" height="200" loading="lazy">{%- endif -%}
            </div>
            <p class="be-rit-card__vendor">Rituals</p>
            <p class="be-rit-card__title">{{ block.settings.label | escape }}</p>
            <p class="be-rit-combo__parts"><a href="{{ a.url }}">{{ a.title | remove_first: 'Rituals...' | remove: ' 2026' | strip | escape }}</a> {{ va.price | money }}<br><a href="{{ b.url }}">{{ b.title | remove_first: 'Rituals...' | remove: ' 2026' | strip | escape }}</a> {{ vb.price | money }}</p>
            <p class="be-rit-card__price">{{ 'claude.r.together_html' | t }} {{ sum | money }}</p>
            <form action="{{ routes.cart_add_url }}" method="post" class="be-rit-atc" data-variants="{{ va.id }},{{ vb.id }}">
              <input type="hidden" name="items[0][id]" value="{{ va.id }}"><input type="hidden" name="items[0][quantity]" value="1">
              <input type="hidden" name="items[1][id]" value="{{ vb.id }}"><input type="hidden" name="items[1][quantity]" value="1">
              <button type="submit" class="be-rit-btn">{{ 'claude.r.both_html' | t }}</button>
            </form>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if combo_html != blank -%}
      {%- if s.combo_heading != blank -%}<h3 class="be-rit__tier-h">{{ s.combo_heading | escape }}</h3>{%- endif -%}
      <ul class="be-rit__grid be-rit__grid--combo" role="list">{{ combo_html }}</ul>
    {%- endif -%}
  {%- endif -%}

  {%- if s.note != blank and s.layout != 'teaser' -%}<p class="be-rit__note">{{ s.note | escape }}</p>{%- endif -%}
</div>
{%- render 'be-rituals-upsell', ctx: 'js' -%}
<style>
  #be-rit-{{ section.id }}{padding-top:{{ s.pad_top }}px;padding-bottom:{{ s.pad_bottom }}px}
  @media (max-width:749px){#be-rit-{{ section.id }}{padding-top:{{ s.pad_top_mobile }}px;padding-bottom:40px}}
  .be-rit__head{max-width:720px;margin:0 auto 24px;text-align:center}
  .be-rit__eyebrow{margin:0 0 8px;font-size:.75em;letter-spacing:.16em;text-transform:uppercase;opacity:.7}
  .be-rit__h{margin:0 0 12px;line-height:1.25}
  .be-rit__intro{margin:0;line-height:1.6}
  .be-rit__tiles{list-style:none;margin:0 auto;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;max-width:1100px}
  .be-rit__tile-link{display:flex;flex-direction:column;align-items:center;gap:6px;padding:16px 10px;border:1px solid rgba(var(--color-foreground,0,0,0),.2);color:inherit;text-decoration:none;height:100%;text-align:center}
  .be-rit__tile-link:hover{border-color:rgb(var(--color-foreground,0,0,0))}
  .be-rit__tile img{width:100%;max-width:220px;aspect-ratio:1;object-fit:contain}
  .be-rit__tile-label{font-weight:600;text-transform:uppercase;letter-spacing:.08em}
  .be-rit__tile-count{font-size:.85em;opacity:.7}
  .be-rit__cta{text-align:center;margin:24px 0 0}
  .be-rit__btn-link{display:inline-block;padding:12px 26px;border:1px solid rgb(var(--color-foreground,0,0,0));color:inherit;text-decoration:none;text-transform:uppercase;letter-spacing:.08em;font-size:.85em}
  .be-rit__btn-link:hover{background:rgb(var(--color-foreground,0,0,0));color:rgb(var(--color-background,255,255,255))}
  .be-rit__jump{display:flex;justify-content:center;flex-wrap:wrap;gap:10px;margin:0 0 28px}
  .be-rit__jump a{padding:8px 16px;border:1px solid rgba(var(--color-foreground,0,0,0),.35);border-radius:999px;color:inherit;text-decoration:none;font-size:.88em}
  .be-rit__tier{margin:0 0 40px;scroll-margin-top:120px}
  .be-rit__tier-h{margin:0 0 16px;font-size:1.15em;text-transform:uppercase;letter-spacing:.08em;text-align:center}
  .be-rit__grid{list-style:none;margin:0 0 28px;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
  .be-rit__grid--combo{grid-template-columns:repeat(3,minmax(0,1fr))}
  .be-rit-card,.be-rit-combo{display:flex;flex-direction:column;gap:6px;height:100%;text-align:center}
  .be-rit-card__img{display:block;aspect-ratio:1;background:rgba(var(--color-foreground,0,0,0),.03)}
  .be-rit-card__img img{width:100%;height:100%;object-fit:contain}
  .be-rit-combo__media{display:flex;align-items:center;justify-content:center;gap:6px;background:rgba(var(--color-foreground,0,0,0),.03);aspect-ratio:2/1}
  .be-rit-combo__media img{width:44%;height:auto;aspect-ratio:1;object-fit:contain}
  .be-rit-combo__parts{margin:0;font-size:.82em;line-height:1.5;opacity:.85}
  .be-rit-combo__parts a{color:inherit}
  .be-rit-card__vendor{margin:4px 0 0;font-size:.72em;letter-spacing:.14em;text-transform:uppercase;opacity:.7}
  .be-rit-card__title{margin:0;font-size:.92em;line-height:1.35;flex:1}
  .be-rit-card__title a{color:inherit;text-decoration:none}
  .be-rit-card__price{margin:0;font-weight:600}
  .be-rit-atc{margin:4px 0 0}
  .be-rit__note{max-width:720px;margin:8px auto 0;text-align:center;font-size:.88em;line-height:1.5;opacity:.85}
  @media (max-width:989px){.be-rit__grid{grid-template-columns:repeat(3,minmax(0,1fr))}.be-rit__grid--combo{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:749px){.be-rit__grid,.be-rit__grid--combo{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.be-rit__tiles{gap:8px}.be-rit__tile-link{padding:10px 4px}.be-rit__tile-label{font-size:.78em;letter-spacing:.04em}}
</style>
{% schema %}
{
  "name": "BE Rituals-Geschenke",
  "class": "be-rituals-geschenke",
  "settings": [
    {"type":"select","id":"layout","label":"Layout","default":"guide","options":[{"value":"guide","label":"Geschenkeguide nach Budget"},{"value":"teaser","label":"Startseiten-Teaser (Budgetstufen)"},{"value":"grid","label":"Produktraster + Kombinationen"}]},
    {"type":"text","id":"eyebrow","label":"Überzeile"},
    {"type":"text","id":"heading","label":"Überschrift"},
    {"type":"checkbox","id":"heading_h1","label":"Überschrift als H1 (nur Guide-Seite)","default":false},
    {"type":"textarea","id":"intro","label":"Einleitung"},
    {"type":"product_list","id":"products","label":"Produkte (nur vorrätige werden angezeigt)","limit":50},
    {"type":"number","id":"tier1_max","label":"Stufe 1: unter (€)","default":30},
    {"type":"number","id":"tier2_max","label":"Stufe 2: bis (€)","default":40},
    {"type":"number","id":"tier3_max","label":"Stufe 3: bis (€)","default":65},
    {"type":"text","id":"tier1_label","label":"Stufe 1 Name","default":"Unter 30 €"},
    {"type":"text","id":"tier2_label","label":"Stufe 2 Name","default":"Bis 40 €"},
    {"type":"text","id":"tier3_label","label":"Stufe 3 Name","default":"Bis 65 €"},
    {"type":"url","id":"link","label":"Link (Teaser)"},
    {"type":"text","id":"link_label","label":"Button-Text (Teaser)"},
    {"type":"text","id":"combo_heading","label":"Überschrift Kombinationen"},
    {"type":"text","id":"note","label":"Hinweis unten"},
    {"type":"range","id":"pad_top","label":"Abstand oben (Desktop)","min":0,"max":200,"step":4,"unit":"px","default":48},
    {"type":"range","id":"pad_top_mobile","label":"Abstand oben (Mobil)","min":0,"max":200,"step":4,"unit":"px","default":32},
    {"type":"range","id":"pad_bottom","label":"Abstand unten (Desktop)","min":0,"max":200,"step":4,"unit":"px","default":48}
  ],
  "blocks": [
    {"type":"combo","name":"Kombination (2 Produkte)","settings":[
      {"type":"text","id":"label","label":"Titel","default":"Geschenkset S + M"},
      {"type":"product","id":"product_a","label":"Produkt 1"},
      {"type":"product","id":"product_b","label":"Produkt 2"}
    ]}
  ],
  "presets": [{"name":"BE Rituals-Geschenke"}]
}
{% endschema %}
