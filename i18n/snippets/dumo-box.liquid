{%- comment -%} Kauf-Bereich: jeder Flakon (freigestelltes Foto, alle auf gleiche Hoehe zugeschnitten) steckt in seiner DUMO-Klappbox. Alle Boxen gleich gross: Zuschnitt aus Produktfotos nach gemessenen Kanten, echtes Seitenverhaeltnis 0.654. Hover (Desktop) bzw. Sichtbarkeit (Touch) oeffnet die Box; Wappen bleibt an der linken Klappe. Reihenfolge nach Farbe: Gold, Hell, Schwarz, Hell, Schwarz, Hell, Gold. Spartacus nutzt die goldene Commodus-Box (eigenes Box-Foto fehlt). {%- endcomment -%}
<style>
html body .dm-card .im{height:auto}
html body .dm-card .im>img{display:none}
.bx{position:relative;width:min(183px,100%);aspect-ratio:.654;margin:0 auto;perspective:900px;cursor:pointer;box-shadow:0 18px 26px -14px rgba(0,0,0,.45)}
.bx-in{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 35%,#3b2d1d,#0d0a07 78%);box-shadow:inset 0 0 28px rgba(0,0,0,.85);overflow:hidden;display:flex;align-items:flex-end;justify-content:center;padding-bottom:7%}
.bt{height:78%;background-repeat:no-repeat;filter:drop-shadow(0 10px 12px rgba(0,0,0,.6));transform:scale(.9);transform-origin:50% 100%;transition:transform .7s .2s cubic-bezier(.2,.7,.2,1)}
.dm-card:hover .bt,.bx.open .bt{transform:scale(1)}
.bx-d{position:absolute;inset:0;background-repeat:no-repeat;backface-visibility:hidden;transition:transform .9s cubic-bezier(.2,.7,.2,1)}
.bx-l{clip-path:polygon(0 0,50% 0,50% 17%,62% 17%,62% 51%,50% 51%,50% 100%,0 100%);transform-origin:0 50%;z-index:2}
.bx-r{clip-path:polygon(50% 0,100% 0,100% 100%,50% 100%);transform-origin:100% 50%;z-index:1}
.dm-card:hover .bx-l,.bx.open .bx-l{transform:rotateY(-105deg)}
.dm-card:hover .bx-r,.bx.open .bx-r{transform:rotateY(105deg)}
html body .dm-cards::after{display:none}
@media (prefers-reduced-motion:reduce){.bx-d,.bt{transition:none}}
@media (max-width:640px){.bx{width:min(150px,100%)}}
</style>
<script>document.addEventListener('DOMContentLoaded',function(){
var F='https://cdn.shopify.com/s/files/1/0762/4949/7942/files/',C='DUMO_COMMODUS_The_Scent_of_War_Eau_de_Parfum2_Flatlay_-Photoroom.jpg';
var BOX={
COMMODUS:[C,'253.6% 165.9%','49% 49.7%','dumo-cut-commodus.png',[136,59,356,444],1],
PRISCUS:['DUMO_PRISCUS_The_Scent_of_Victory_Eau_de_Parfum_2_Flatlay_-Photoroom.jpg','254.9% 166.7%','48.5% 49.3%','dumo-flasche-priscus.png',[105,0,393,499],2],
MARCUS:['DUMO_MARCUS_The_Scent_of_Honor_Eau_de_Parfum1_Flatlay_-Photoroom.jpg','284.6% 184.3%','48.6% 50.2%','dumo-cut-marcus.png',[131,44,366,463],3],
CRIXUS:['DUMO_CRIXUS_The_Scent_of_Braveheart_Eau_de_Parfum2_Flatlay_-Photoroom.jpg','232.9% 152.3%','48.1% 51.9%','dumo-cut-crixus.png',[135,58,361,457],4],
VERUS:['DUMO_VERUS_The_Scent_of_Darkness_Eau_de_Parfum_box_2_Flatlay_-Photoroom.jpg','225.2% 148.5%','48.7% 51.2%','dumo-flasche-verus.png',[105,0,393,499],5],
REXOR:['DUMO_REXOR_The_Scent_of_Power_Eau_de_Parfum2_Flatlay_-Photoroom.jpg','246.3% 161.1%','47.8% 49%','dumo-cut-rexor.png',[130,43,367,446],6],
SPARTACUS:[C,'253.6% 165.9%','49% 49.7%','dumo-cut-spartacus.png',[137,55,354,435],7]};
function crop(bb){var w=bb[2]-bb[0],h=bb[3]-bb[1],sx=500-w,sy=500-h;return 'aspect-ratio:'+(w/h).toFixed(3)+';background-size:'+(50000/w).toFixed(1)+'% '+(50000/h).toFixed(1)+'%;background-position:'+(sx?bb[0]/sx*100:50).toFixed(1)+'% '+(sy?bb[1]/sy*100:50).toFixed(1)+'%'}
var touch=matchMedia('(hover:none)').matches;
document.querySelectorAll('.dm-card').forEach(function(c){
 var b=c.querySelector('b'),d=b&&BOX[b.textContent.trim().toUpperCase()],im=c.querySelector('.im');if(!d||!im||im.querySelector('.bx'))return;
 c.style.order=d[5];
 var bx=document.createElement('div');bx.className='bx';
 var st='background-image:url('+F+d[0]+'?width=800);background-size:'+d[1]+';background-position:'+d[2];
 bx.innerHTML='<div class="bx-in"><div class="bt" role="img" aria-label="'+{{ 'claude.d.fig_js_html' | t | json }}.replace('{n}',b.textContent.trim())+'" style="background-image:url('+F+d[3]+'?width=500);'+crop(d[4])+'"></div></div><div class="bx-d bx-r" style="'+st+'"></div><div class="bx-d bx-l" style="'+st+'"></div>';
 im.appendChild(bx);
 if(touch){new IntersectionObserver(function(e){bx.classList.toggle('open',e[0].isIntersecting)},{threshold:.75}).observe(bx)}
});});</script>
