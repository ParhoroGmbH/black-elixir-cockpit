  #shopify-section-secondary-header[data-bx-tone="dark"] :is(.menu__list--header>.menu__item>.menu__item-title,.miscellaneous__subblock) :is(svg,path){fill:#fff!important}
  #shopify-section-secondary-header[data-bx-tone="dark"] .menu-container--header .menu__item-link:hover *{color:var(--bx-gold-l)!important}
