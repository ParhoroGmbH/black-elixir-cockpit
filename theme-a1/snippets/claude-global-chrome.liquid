<script>
(function () {
  var RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function srcOf(img) {
    var s = img.currentSrc || '';
    if (!s || s.indexOf('data:') === 0) s = (img.getAttribute('data-srcset') || img.getAttribute('srcset') || '').split(' ')[0] || img.getAttribute('data-src') || img.src;
    return s && s.indexOf('data:') !== 0 ? s : '';
  }

  /* Footer-Logo: Gravur + Neon */
  function engrave() {
    var img = document.querySelector('.shopify-section-footer a.image img, .shopify-section-footer img.image__item');
    if (!img) return;
    var src = srcOf(img); if (!src) return;
    var a = img.closest('a') || img.parentElement;
    if (a.querySelector('.bx-neon')) return;
    a.classList.add('bx-engrave');
    a.style.setProperty('--bx-logo', 'url("' + src.replace(/width=[0-9]+/, 'width=1200') + '")');
    a.insertAdjacentHTML('beforeend', '<span class="bx-neon" aria-hidden="true"><b></b><i></i></span><span class="bx-neon bx-neon--core" aria-hidden="true"><i></i></span>');
  }

  /* Header-Logo: Goldglanz-Maske */
  function glint() {
    document.querySelectorAll('sticky-secondary-header .logo__image').forEach(function (a) {
      var img = [].slice.call(a.querySelectorAll('img')).filter(function (i) { return i.offsetWidth; })[0];
      if (!img) return; var src = srcOf(img); if (!src) return;
      a.style.setProperty('--bx-hlogo', 'url("' + src + '")');
      a.classList.add('bx-glint');
    });
  }

  /* Rechte Sidebar: Links leuchten auf, wenn die Maus in die Nähe kommt */
  function proximity() {
    var bar = document.querySelector('.secondary-sidebar'); if (!bar) return;
    var links = [].slice.call(bar.querySelectorAll('.menu__item-link'));
    var raf = 0, mx = 0, my = 0;
    function upd() {
      raf = 0;
      links.forEach(function (l) {
        var r = l.getBoundingClientRect();
        var dx = Math.max(r.left - mx, 0, mx - r.right), dy = Math.max(r.top - my, 0, my - r.bottom);
        l.classList.toggle('bx-near', dx * dx + dy * dy < 1600);
      });
    }
    window.addEventListener('pointermove', function (e) {
      if (e.clientX < innerWidth - 220) { if (bar.dataset.bxN) { bar.dataset.bxN = ''; links.forEach(function (l) { l.classList.remove('bx-near'); }); } return; }
      bar.dataset.bxN = '1'; mx = e.clientX; my = e.clientY; if (!raf) raf = requestAnimationFrame(upd);
    }, { passive: true });
  }

  /* Footer-Wasser: leichte 2D-Wellensimulation auf kleinem Canvas (hochskaliert), pausiert außerhalb des Sichtbereichs */
  function water() {
    var host = document.querySelector('.shopify-section-footer .overlapping-container-js') || document.querySelector('.shopify-section-footer .footer');
    if (!host || RM || host.querySelector('.bx-water')) return;
    var cv = document.createElement('canvas'); cv.className = 'bx-water'; cv.setAttribute('aria-hidden', 'true');
    var ctx = cv.getContext && cv.getContext('2d'); if (!ctx) return;
    if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
    host.insertBefore(cv, host.firstChild);
    var coarse = matchMedia('(pointer: coarse)').matches || innerWidth < 861;
    var S = coarse ? 8 : 5, W, H, A, B, img, vis = false, run = false, lastX = -99, lastY = -99, timer;
    function size() {
      var r = host.getBoundingClientRect();
      W = Math.max(4, Math.ceil(r.width / S)); H = Math.max(4, Math.ceil(r.height / S));
      cv.width = W; cv.height = H; A = new Float32Array(W * H); B = new Float32Array(W * H); img = ctx.createImageData(W, H);
    }
    function drop(x, y, rad, s) {
      x = x | 0; y = y | 0;
      for (var j = -rad; j <= rad; j++) for (var i = -rad; i <= rad; i++) {
        if (i * i + j * j > rad * rad) continue;
        var X = x + i, Y = y + j;
        if (X > 0 && Y > 0 && X < W - 1 && Y < H - 1) A[Y * W + X] += s;
      }
      if (!run && vis) { run = true; requestAnimationFrame(loop); }
    }
    function loop() {
      var e = 0, d = img.data, y, x, i, v, s, p;
      for (y = 1; y < H - 1; y++) for (x = 1, i = y * W + 1; x < W - 1; x++, i++) {
        v = ((A[i - 1] + A[i + 1] + A[i - W] + A[i + W]) * 0.5 - B[i]) * 0.968;
        B[i] = v; e += v < 0 ? -v : v;
      }
      var t = A; A = B; B = t;
      for (y = 1; y < H - 1; y++) for (x = 1, i = y * W + 1; x < W - 1; x++, i++) {
        s = (A[i - 1] - A[i + 1]) + (A[i - W] - A[i + W]) * 0.7; p = i << 2;
        if (s > 0) { d[p] = d[p + 1] = d[p + 2] = 255; d[p + 3] = s * 3 > 140 ? 140 : s * 3; }
        else { d[p] = d[p + 1] = d[p + 2] = 0; d[p + 3] = -s * 1.6 > 60 ? 60 : -s * 1.6; }
      }
      ctx.putImageData(img, 0, 0);
      if (vis && e > W * H * 0.004) requestAnimationFrame(loop);
      else { run = false; if (!vis || e <= W * H * 0.004) { A.fill(0); B.fill(0); ctx.clearRect(0, 0, W, H); } }
    }
    size();
    if ('ResizeObserver' in window) new ResizeObserver(function () { var r = host.getBoundingClientRect(); if (Math.ceil(r.width / S) !== W || Math.ceil(r.height / S) !== H) size(); }).observe(host);
    new IntersectionObserver(function (en) {
      vis = en[0].isIntersecting; (host.closest('.shopify-section-footer') || host).classList.toggle('bx-off', !vis);
      clearInterval(timer);
      if (vis) timer = setInterval(function () { drop(Math.random() * W, Math.random() * H, 3, 16); }, coarse ? 1300 : 2600);
    }).observe(host);
    window.addEventListener('pointermove', function (e) {
      if (!vis) return;
      var r = host.getBoundingClientRect(), x = (e.clientX - r.left) / S, y = (e.clientY - r.top) / S;
      if (x < 0 || y < 0 || x >= W || y >= H) return;
      if (Math.abs(x - lastX) + Math.abs(y - lastY) < 1.5) return;
      lastX = x; lastY = y; drop(x, y, 2, 12);
    }, { passive: true });
    window.addEventListener('pointerdown', function (e) {
      if (!vis) return; var r = host.getBoundingClientRect();
      drop((e.clientX - r.left) / S, (e.clientY - r.top) / S, 3, 26);
    }, { passive: true });
  }

  /* Footer-Spaltentitel: Einstellung lautet "MITGLIEDE" (Tippfehler in footer-group.json) – Anzeige korrigieren */
  function titles() {
    document.querySelectorAll('.shopify-section-footer .menus__item-title').forEach(function (t) {
      if (t.textContent.trim() === 'MITGLIEDE') t.textContent = 'MITGLIEDER';
    });
  }

  /* Ein Ton-System für linke Leiste + Kopfzeile (Desktop und Mobil), 12.11.2026: liegt ein Teil über einer dunklen Fläche, bekommt er klares Glas + helle Schrift – pro Scroll.
     Dunkle Flächen: Footer, Fragrance-Library-Landing (.fl-land), DUMO-Szenen (.dh/.dv/.dg), [data-bx-dark] und auf der Startseite jede Sektion von .ch mit dunklem Grund (automatisch erkannt).
     Helle Inseln darin (weiße Produktflächen der Fragrance-Library-Geschichte .fls-prod/.fls-end, [data-bx-light]) werden wieder abgezogen. Gezählt wird nur, was wirklich unter dem Teil durchläuft.
     Linke Leiste: Verlauf (--bx-sbg) + .bx-ondark je Element. Kopfzeile: data-bx-tone="dark|light" an der Sektion (Mitte der Kopfzeile entscheidet), --bx-hh = Höhe der Desktop-Kopfzeile. */
  function sidebarTone() {
    var de = document.documentElement, bar = document.querySelector('.main-sidebar');
    var heads = [].slice.call(document.querySelectorAll('#shopify-section-secondary-header,#shopify-section-mobile-header'));
    if (!bar && !heads.length) return;
    var L = 'rgba(255,255,255,.3)', D = 'rgba(12,13,16,.1)', zones = [], lights = [], last = '', hh = -1, mh = -1;
    var els = bar ? [].slice.call(bar.querySelectorAll('a,button,summary,p,h2,h3,h4')) : [];
    function lum(c) { var m = /rgba?\(([\d.]+)[, ]+([\d.]+)[, ]+([\d.]+)(?:[,/ ]+([\d.]+))?/.exec(c || ''); return !m || +m[4] === 0 ? -1 : (.2126 * m[1] + .7152 * m[2] + .0722 * m[3]) / 255; }
    function scan() {
      zones = [].slice.call(document.querySelectorAll('.shopify-section-footer .footer,.shopify-section-footer .overlapping-container-js,.fl-land,.dh,.dv,.dg,[data-bx-dark]'));
      lights = [].slice.call(document.querySelectorAll('.fls-prod,.fls-end,[data-bx-light]'));
      if (!document.querySelector('.shopify-section-footer .footer')) { var f = document.querySelector('.shopify-section-footer'); if (f) zones.push(f); }
      [].forEach.call(document.querySelectorAll('.ch>div,.ch>section'), function (e) { var c = getComputedStyle(e), b = lum(c.backgroundColor); if (b < 0 ? lum(c.color) > .6 : b < .25) zones.push(e); });
    }
    /* dunkle Abschnitte (y-Intervalle relativ zur Oberkante) unter dem Rechteck top/height/left/right */
    function dark(top, height, left, right) {
      var iv = [], m = [];
      zones.forEach(function (z) {
        var r = z.getBoundingClientRect();
        if (!r.height || r.bottom <= top || r.top >= top + height || r.right <= left + 1 || r.left >= right - 1) return;
        iv.push([Math.max(0, r.top - top), Math.min(height, r.bottom - top)]);
      });
      iv.sort(function (x, y) { return x[0] - y[0]; });
      iv.forEach(function (v) { var l = m[m.length - 1]; if (l && v[0] <= l[1] + 1) l[1] = Math.max(l[1], v[1]); else m.push(v); });
      lights.forEach(function (z) {
        var r = z.getBoundingClientRect(), a = r.top - top, e = r.bottom - top - (z.classList.contains('fls-end') ? innerHeight * .27 : 0), n = [];
        if (!r.height || e <= 0 || a >= height || e <= a || r.right <= left + 1 || r.left >= right - 1) return;
        m.forEach(function (v) { if (v[1] <= a || v[0] >= e) n.push(v); else { if (v[0] < a) n.push([v[0], a]); if (v[1] > e) n.push([e, v[1]]); } });
        m = n;
      });
      return m;
    }
    function upd() {
      heads.forEach(function (h) {
        var r = h.getBoundingClientRect(); if (!r.width || !r.height) return;
        if (h.id === 'shopify-section-secondary-header') { if (Math.abs(r.height - hh) > .5) { hh = r.height; de.style.setProperty('--bx-hh', hh.toFixed(1) + 'px'); } }
        else if (Math.abs(r.height - mh) > .5) { mh = r.height; de.style.setProperty('--ch-mh', Math.round(mh) + 'px'); } /* Startseite mobil: Hero schiebt sich um genau die Kopfzeilenhöhe darunter (claude-home-fix) */
        var t = Math.max(0, r.top), y = r.height / 2; /* eingefahrene (versteckte) Kopfzeile: Ton für die Position, an der sie wieder erscheint */
        var d = dark(t, r.height, r.left, r.right).some(function (v) { return y > v[0] && y < v[1]; }) ? 'dark' : 'light';
        if (h.getAttribute('data-bx-tone') !== d) h.setAttribute('data-bx-tone', d);
      });
      if (!bar) return;
      var b = bar.getBoundingClientRect(); if (!b.width || !b.height) return;
      var m = dark(b.top, b.height, b.left, b.right), g = [], p = 0;
      m.forEach(function (v) { if (v[0] > p) g.push(L + ' ' + p.toFixed(0) + 'px ' + v[0].toFixed(0) + 'px'); g.push(D + ' ' + v[0].toFixed(0) + 'px ' + v[1].toFixed(0) + 'px'); p = v[1]; });
      if (m.length && p < b.height) g.push(L + ' ' + p.toFixed(0) + 'px 100%');
      var s = m.length ? 'linear-gradient(180deg,' + g.join(',') + ')' : '';
      if (s !== last) { last = s; if (s) bar.style.setProperty('--bx-sbg', s); else bar.style.removeProperty('--bx-sbg'); }
      els.forEach(function (e) {
        var r = e.getBoundingClientRect(), y = (r.top + r.bottom) / 2 - b.top;
        e.classList.toggle('bx-ondark', r.height > 0 && m.some(function (v) { return y > v[0] && y < v[1]; }));
      });
    }
    var q = upd; /* direkt im Scroll-Ereignis (ohnehin einmal pro Bild) – kein rAF, damit die Farbe nie hinterherhinkt */
    scan(); upd();
    window.addEventListener('scroll', q, { passive: true }); window.addEventListener('resize', q);
    window.addEventListener('load', function () { scan(); q(); });
    if ('ResizeObserver' in window) new ResizeObserver(q).observe(document.body);
    /* die Kopfzeile fährt per Klasse ein/aus (Theme) – danach Ton neu bestimmen */
    if ('MutationObserver' in window) heads.forEach(function (h) { new MutationObserver(q).observe(h, { attributes: true, attributeFilter: ['class'] }); });
  }

  /* 12.11.2026: Menüpunkt der Wunschlisten-App heißt "My wishlist" – im deutschen Shop als "Wunschliste" anzeigen (Navigation selbst unverändert) */
  function wishlist() {
    {% if true -%}
    document.querySelectorAll('a[href*="/pages/joy-wishlist"]').forEach(function (a) {
      a.querySelectorAll('*').forEach(function (n) { if (!n.children.length && /^my wishlist$/i.test(n.textContent.trim())) n.textContent = {{ 'claude.ch.wishlist_html' | t | json }}; });
    });
    {%- endif %}
  }

  function init() { engrave(); glint(); proximity(); water(); titles(); }
  wishlist(); sidebarTone();
  if (document.readyState === 'complete') init(); else window.addEventListener('load', init);
})();
</script>
