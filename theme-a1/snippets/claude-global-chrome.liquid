    #shopify-section-mobile-header::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:rgba(14,15,18,.8);backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%);box-shadow:inset 0 -1px 0 rgba(241,222,168,.45);transition:background-color .35s ease}
    #shopify-section-mobile-header[data-bx-tone="dark"]::before{background:linear-gradient(180deg,rgba(8,9,12,.48),rgba(8,9,12,.3))}
    #shopify-section-mobile-header.shopify-section-mobile-header-sticky[data-bx-tone="dark"]::before{background:rgba(8,9,12,.62)}
    html body #shopify-section-mobile-header :is(.mobile-header-section,.mobile-header){background:transparent!important}
    html body #shopify-section-mobile-header .mobile-header__content{position:relative;height:56px;padding:0 4px!important;gap:0;flex-wrap:nowrap}
