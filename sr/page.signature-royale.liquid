<link rel="preload" as="image" href="{{ images['sr-palais-sunset-vibes.png'] | image_url: width: 1600 }}" imagesrcset="{{ images['sr-palais-sunset-vibes.png'] | image_url: width: 900 }} 900w, {{ images['sr-palais-sunset-vibes.png'] | image_url: width: 1600 }} 1600w" imagesizes="100vw">
