"card":{"d":{{ sr_card | image_url: width: 1600 | json }}},
"img":{"sunset-vibes":{"d":{{ images['sr-palais-sunset-vibes.png'] | image_url: width: 1600 | json }},"m":{{ images['sr-palais-sunset-vibes.png'] | image_url: width: 900 | json }},"s":{{ images['sr-palais-sunset-vibes.png'] | image_url: width: 120 | json }}},"sweet-cherry":{"d":{{ images['sr-palais-sweet-cherry.png'] | image_url: width: 1600 | json }},"m":{{ images['sr-palais-sweet-cherry.png'] | image_url: width: 900 | json }},"s":{{ images['sr-palais-sweet-cherry.png'] | image_url: width: 120 | json }}},"souffle-de-safran":{"d":{{ images['sr-palais-souffle-de-safran.png'] | image_url: width: 1600 | json }},"m":{{ images['sr-palais-souffle-de-safran.png'] | image_url: width: 900 | json }},"s":{{ images['sr-palais-souffle-de-safran.png'] | image_url: width: 120 | json }}},"vertigo":{"d":{{ images['sr-palais-vertigo.png'] | image_url: width: 1600 | json }},"m":{{ images['sr-palais-vertigo.png'] | image_url: width: 900 | json }},"s":{{ images['sr-palais-vertigo.png'] | image_url: width: 120 | json }}},"tropical-crush":{"d":{{ images['sr-palais-tropical-crush.png'] | image_url: width: 1600 | json }},"m":{{ images['sr-palais-tropical-crush.png'] | image_url: width: 900 | json }},"s":{{ images['sr-palais-tropical-crush.png'] | image_url: width: 120 | json }}},"skin-on-fire":{"d":{{ images['sr-palais-skin-on-fire.png'] | image_url: width: 1600 | json }},"m":{{ images['sr-palais-skin-on-fire.png'] | image_url: width: 900 | json }},"s":{{ images['sr-palais-skin-on-fire.png'] | image_url: width: 120 | json }}},"sunset-pop":{"d":{{ images['sr-palais-sunset-pop.png'] | image_url: width: 1600 | json }},"m":{{ images['sr-palais-sunset-pop.png'] | image_url: width: 900 | json }},"s":{{ images['sr-palais-sunset-pop.png'] | image_url: width: 120 | json }}},"sugar-milk":{"d":{{ images['sr-palais-sugar-milk.png'] | image_url: width: 1600 | json }},"m":{{ images['sr-palais-sugar-milk.png'] | image_url: width: 900 | json }},"s":{{ images['sr-palais-sugar-milk.png'] | image_url: width: 120 | json }}}},
"lurl":{ {%- for l in localization.available_languages -%}{%- assign lr = l.root_url -%}{%- if lr == '/' -%}{%- assign lr = '' -%}{%- endif -%}{{ l.iso_code | slice: 0, 2 | json }}:{{ lr | append: page.url | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} },
"prd":{ {%- for p in sr_col.products limit: 50 -%}{{ p.handle | json }}:{"p":{{ p.price | money_without_currency | append: ' €' | json }},"a":{{ p.available | json }},"i":{{ p.featured_image | image_url: width: 360, height: 360, crop: 'center' | json }},"c":{{ p.featured_image | image_url: width: 700, height: 700, crop: 'center' | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }}{%- endcapture -%}
<!doctype html>
