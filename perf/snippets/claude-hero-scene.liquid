    }

    // --- Layout: Produktgruppe wie bisher positionieren (Desktop ~63,5 % der freien Breite, nie im Text; Chips mind. 16 px über Pfeilen), Produkt genau darüber
    function txr(sl, rtl) { var m = rtl ? 1e9 : 0; [].forEach.call(sl.querySelectorAll('.h3-text > *'), function (e) { var g = document.createRange(); g.selectNodeContents(e); var q = g.getBoundingClientRect(); if (q.width) m = rtl ? Math.min(m, q.left) : Math.max(m, q.right); }); return m; }
    function layout(force) {
