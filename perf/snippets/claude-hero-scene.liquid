<style>.ch .hsc .h3-bgl{background-image:var(--bg)}@media (max-width:860px){.ch .hsc .h3-bgl{background-image:var(--bgm)}}</style>
<script>
(function () {
  var h = document.currentScript.previousElementSibling.previousElementSibling;
  if (!h || !h.hasAttribute('data-hsc')) h = document.querySelector('[data-hsc]');
  var cfg = JSON.parse(h.querySelector('[data-hsc-cfg]').textContent);
  // Adventskalender: Tage bis zum ersten Türchen (wie bisher)
  var cn = h.querySelector('[data-h3-count]'), now = new Date(), y = now.getFullYear(), d1 = new Date(y, 11, 1), days = Math.ceil((d1 - now) / 864e5);
  if (cn) cn.innerHTML = days > 0 ? '<b>' + days + '</b>' + (days === 1 ? {{ 'claude.hero.day1_html' | t | json }} : {{ 'claude.hero.dayn_html' | t | json }}) : (now.getMonth() === 11 && now.getDate() <= 24 ? '<b>' + now.getDate() + '</b>' + {{ 'claude.hero.today_html' | t | json }}.replace('{n}', now.getDate()) : '');

  var still = matchMedia('(prefers-reduced-motion:reduce)').matches;
  var slides = h.querySelectorAll('[data-h3-slide]'), dots = h.querySelectorAll('[data-h3-dot]'), ctl = h.querySelector('.ch-ctrl');
  var si = 0, el = 0, sw = 0, stop = 0, hov = 0, last = Date.now(), DUR = 20000, SWT = 10000, want = 0, vis = 1;
  var boxes = [].map.call(slides, function (sl, k) {
    return { k: k, sl: sl, box: sl.querySelector('[data-m3]'), bs: sl.querySelectorAll('[data-m3-go]'), tag: sl.querySelector('.sp3-tag'), tabs: sl.querySelector('.m3-tabs'), i: 0, touched: 0 };
  });
  function hold() { stop = 1; }
  var S = null; // 3D-Szene, sobald geladen; ohne Szene (kein WebGL) wechseln nur Text + Poster

  function dotsOn(j) { dots.forEach(function (x, k) { x.classList.toggle('is-on', k === j); }); }
  function activate(j) { // Text, Chips, Badge und Punkte wechseln nur hier, im selben Schritt wie die Szene (swap)
    dotsOn(j);
    slides.forEach(function (x, k) { x.classList.toggle('is-on', k === j); });
    slides[(j + 1) % slides.length].classList.add('bg-ok');
  }
  function show(i, u) { // u = per Hand bedient: Punkt sofort als Rueckmeldung; beim Auto-Wechsel erst mit der Szene
    si = (i + slides.length) % slides.length; el = 0; sw = 0; var j = si; want = j;
    if (u) dotsOn(j);
    if (!S || S.dead) { activate(j); return; }
    S.go(j, boxes[j].i);
  }
  function pick(o, j) {
    o.i = (j + o.bs.length) % o.bs.length; var b = o.bs[o.i];
    o.bs.forEach(function (x, k) { x.classList.toggle('on', k === o.i); });
    var tb = b.parentNode; if (tb.scrollWidth > tb.clientWidth + 1) tb.scrollTo({ left: b.offsetLeft - (tb.clientWidth - b.offsetWidth) / 2, behavior: still ? 'auto' : 'smooth' });
    if (S && !S.dead) S.go(o.k, o.i);
  }
  boxes.forEach(function (o) { o.bs.forEach(function (b, j) { b.addEventListener('click', function () { hold(); pick(o, j); }); b.addEventListener('pointerenter', function () { if (S && !S.dead) S.warm(o.k, j); }); }); });
  var pv = h.querySelector('[data-h3-prev]'), nx = h.querySelector('[data-h3-next]');
  if (pv) pv.addEventListener('click', function () { hold(); show(si - 1, 1); });
  if (nx) nx.addEventListener('click', function () { hold(); show(si + 1, 1); });
  dots.forEach(function (x, k) { x.addEventListener('click', function () { hold(); show(k, 1); }); });
  h.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') hov = 1; });
  h.addEventListener('pointerleave', function () { hov = 0; });
  // 20 s je Motiv, bei 10 s ein Produktwechsel im Motiv; jede Bedienung (Pfeil, Punkt, Chip, Ziehen) stoppt den Automatismus für diesen Besuch; Maus über dem Hero pausiert.
  setInterval(function () {
    var t = Date.now(), dt = t - last; last = t;
    if (stop || hov || !vis || document.hidden || slides.length < 2 || !S || S.busy) return; // !S: Szene noch nicht bereit, Timer wartet
    el += dt; var o = boxes[si];
    if (!sw && el >= SWT && el < DUR - 6000 && o.bs.length > 1) { sw = 1; pick(o, o.i + 1); }
    if (el >= DUR) show(si + 1);
  }, 250);
  if ('IntersectionObserver' in window) new IntersectionObserver(function (es) { vis = es[0].isIntersecting ? 1 : 0; if (S) S.kick(); }).observe(h);
  function bgAll() { setTimeout(function () { slides.forEach(function (x) { x.classList.add('bg-ok'); }); }, 2500); }
  if (document.readyState === 'complete') bgAll(); else addEventListener('load', bgAll);

  // ---------- 3D: ein Renderer, ein Ort + ein Produkt zur Zeit ----------
  boot();
  async function boot() {
    var canvas = h.querySelector('.hsc-canvas'), snap = h.querySelector('.hsc-snap');
    var THREE, OrbitControls, GLTFLoader, renderer;
    function fail() { h.classList.add('hsc-fail'); S = { dead: 1 }; activate(want); }
    try {
