      if (shadow.material.map) shadow.material.map.dispose();
      shadow.material.map = shadowTex(md.obj.userData.foot[0], md.obj.userData.foot[1], it.kind === 'bust' || it.kind === 'bottle'); shadow.material.opacity = 1; shadow.material.needsUpdate = true;
      curIt = { it: it, obj: md.obj, tex: pl.tex, K: K };
      // Kamera: Kalender nur ±70° um die Vorderseite (nie hochkant), Flakons/Büsten volle 360°
      flat = it.kind === 'flat'; az0 = 0; az = (it.az || 0) * Math.PI / 180; ph = flat ? Math.asin(Math.max(-1, Math.min(1, az / cfg.flatDrift))) : 0; dir = 1;
      controls.minAzimuthAngle = flat ? -cfg.flat : -Infinity; controls.maxAzimuthAngle = flat ? cfg.flat : Infinity;
      if (curSlide !== s) layoutN = 0; curSlide = s; layout(true);
