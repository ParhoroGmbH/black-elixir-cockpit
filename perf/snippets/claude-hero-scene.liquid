        camera.position.setFromSpherical(sp).add(target); dirty = 1;
      }
      if (controls.update()) dirty = 1;
      if (++layoutN < 90 || layoutN % 30 === 0) layout();
      else if (boxes[curSlide] && boxes[curSlide].tag) tagPos(boxes[curSlide], boxes[curSlide].box.getBoundingClientRect(), boxes[curSlide].box.getBoundingClientRect().height / boxes[curSlide].box.offsetHeight || 1);
      if (dirty) { renderer.render(scene, camera); dirty = 0; }
      var moving = drag || (!still && t > resumeT) || t - fadeT < 1500 || layoutN < 90;
      if (vis && !document.hidden && (moving || dirty)) requestAnimationFrame(tick); else running = 0;
      if (still && !drag) { /* bei reduzierter Bewegung nur bei Bedarf zeichnen */ }
    }
    document.addEventListener('visibilitychange', function () { if (!document.hidden) kick(); });
    if ('ResizeObserver' in window) new ResizeObserver(function () { size(); kick(); }).observe(h);
    addEventListener('resize', function () { h.style.minHeight = ''; });

    S = { go: go, warm: warm, kick: kick, busy: 0, THREE: THREE, renderer: renderer, scene: scene, camera: camera, controls: controls, info: function () { return { it: curIt && curIt.it, az: controls.getAzimuthalAngle(), polar: controls.getPolarAngle(), places: Object.keys(places).length, models: Object.keys(models).length, mem: renderer.info.memory, view: view }; } };
    h.__hsc = S;
    size();
    go(want, boxes[want].i);
  }

  // Kugel, deren untere Hälfte zu einer echten Bodenebene abgeflacht ist (wie three GroundedSkybox): Boden bei y = -height
  function groundedSphere(THREE, height, radius, crop) {
    var g = new THREE.SphereGeometry(radius, 192, 96); g.scale(1, 1, -1);
    var pos = g.getAttribute('position'), v = new THREE.Vector3(), y1 = -height * 1.5;
    for (var i = 0; i < pos.count; i++) {
      v.fromBufferAttribute(pos, i);
      if (v.y < 0) { v.multiplyScalar(v.y < y1 ? -height / v.y : 1 - v.y * v.y / (3 * y1 * y1)); v.toArray(pos.array, 3 * i); }
    }
    var uv = g.getAttribute('uv'); for (i = 0; i < uv.count; i++) uv.setY(i, Math.min(1, uv.getY(i) / (1 - (crop || 0)))); // Bild beginnt erst bei crop (obere Kappe = oberste Zeile)
    return g;
  }
})();
</script>
