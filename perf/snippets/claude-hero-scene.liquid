      else { x.filter = 'blur(' + (0.035 * sx) + 'px)'; x.fillStyle = 'rgba(0,0,0,.45)'; x.fillRect((pad - 0.02) * sx, (pad - 0.02) * sz, (fx + 0.04) * sx, (fz + 0.04) * sz);
        x.filter = 'blur(' + (0.008 * sx) + 'px)'; x.fillStyle = 'rgba(0,0,0,.6)'; x.fillRect(pad * sx, pad * sz, fx * sx, fz * sz); }
