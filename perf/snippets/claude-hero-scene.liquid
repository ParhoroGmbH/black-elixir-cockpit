        [].forEach.call(tx.querySelectorAll('.h3-btns a'), function (a) { var q = a.getBoundingClientRect(); xb = Math.max(xb, q.bottom - t0); xr = Math.max(xr, q.right); });
        var lift = xr > cr.left - 16 ? Math.max(0, Math.min(xb - (cr.top - 16), tx.getBoundingClientRect().top - t0 - r.top - 16)) : 0;
        if (Math.abs(lift + t0) > .5) tx.style.top = (-lift).toFixed(0) + 'px'; } else if (tx) tx.style.top = '';
      var th = o.tabs ? o.tabs.getBoundingClientRect().height : 0;
      var tmax = cr.top - 16 - 40 * k - th, ty = innerWidth <= 860 ? tmax : Math.min(r.top + r.height * .78, tmax);
      o.box.style.setProperty('--gy', ((ty - b.top) / k).toFixed(1) + 'px'); o.box.classList.add('is-set');
      var hh = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--bx-hh')) || 0;
      var top = innerWidth <= 860 ? (tx ? tx.getBoundingClientRect().bottom + 14 : r.top + 60) : Math.max(b.top + 10 * k, r.top + hh + 32);
      if (o.tag) top += 46;
      var hr = curIt.obj.userData.h / HW, want = curIt.K.px * k * (innerWidth <= 860 ? 1.1 : 1), P = Math.min(want, (ty - top) / hr); // P = längste Kante, Höhe = P·hr
      if (innerWidth <= 860 && P < want * .8 && !h.style.minHeight) { h.style.minHeight = Math.min(980, h.offsetHeight + Math.ceil(want * .8 - P)) + 'px'; return layout(force); }
      P = Math.max(P, 120);
      view.cx = b.left + b.width / 2 - r.left; view.cy = ty - P * hr * 0.5 - r.top; view.P = P;
      var W = canvas.clientWidth, Hc = canvas.clientHeight;
      camera.fov = innerWidth <= 860 ? cfg.fovM : cfg.fov; camera.aspect = W / Hc;
      camera.setViewOffset(W, Hc, W / 2 - view.cx, Hc / 2 - view.cy, W, Hc); camera.updateProjectionMatrix();
      var sp = new THREE.Spherical().setFromVector3(camera.position.clone().sub(target)); sp.radius = dist(); camera.position.setFromSpherical(sp).add(target);
      controls.minDistance = controls.maxDistance = sp.radius;
