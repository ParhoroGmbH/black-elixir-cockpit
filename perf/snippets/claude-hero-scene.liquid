        if (rtl) { var br = -1e9; [].forEach.call(bs, function (x) { br = Math.max(br, x.getBoundingClientRect().right - sh); });
          var dr = Math.max(br, c0 + 150 * k) - c0; wnt = Math.min(r.right - sbw - (r.width - sbw - rsw) * .635, txr(o.sl, 1) - 32 - dr);
