    var fill = new THREE.DirectionalLight(0xfff4e6, 1); camera.add(fill); fill.position.set(-0.4, 0.5, 1); scene.add(camera);
    var slot = new THREE.Group(); scene.add(slot);
    var shadow = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), new THREE.MeshBasicMaterial({ transparent: true, depthWrite: false, toneMapped: false, opacity: 0 }));
    shadow.rotation.x = -Math.PI / 2; shadow.position.y = 0.0015; shadow.renderOrder = -5; scene.add(shadow);
    var loader = new GLTFLoader();
    var controls = new OrbitControls(camera, canvas);
    controls.enableZoom = false; controls.enablePan = false; controls.enableDamping = true; controls.dampingFactor = 0.07; controls.rotateSpeed = 0.5;
    controls.minPolarAngle = cfg.polar[0]; controls.maxPolarAngle = cfg.polar[2];
    canvas.style.touchAction = 'pan-y'; // senkrechtes Wischen scrollt die Seite, waagrechtes Ziehen bewegt die Kamera

    // --- Caches: Orte (Textur + Umgebungslicht) und Modelle; nur das Nötige bleibt im Speicher
