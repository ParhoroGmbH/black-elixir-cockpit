      fadeT = performance.now(); trim();
      renderer.render(scene, camera);
      if (s === want) activate(s); // Text/Chips des Motivs erst zeigen, wenn sein Ort + Produkt stehen
      if (!live) { live = 1; h.classList.add('hsc-live'); try { performance.mark('hsc-live'); } catch (e) {} }
