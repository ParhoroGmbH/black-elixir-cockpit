    function itemOf(s, i) { var it = cfg.slides[s] && cfg.slides[s].items[i]; return it; }
    function placeOf(it) { return cfg.places[it.place] || cfg.places.romeo || cfg.places[Object.keys(cfg.places)[0]]; }
    function loadPlace(it) {
