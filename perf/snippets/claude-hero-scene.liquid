  "fov":40,"fovM":48,"crop":0.3,"polar":[1.22,1.42,1.53],"spin":0.17,"flat":1.22,"flatDrift":0.85,"resume":3000,"exposure":1.08,
  "kinds":{"flat":{"px":400,"key":2.0,"fill":1.3},"soap":{"px":330,"key":2.0,"fill":1.2},"bottle":{"px":370,"key":1.6,"fill":0.9},"bust":{"px":400,"key":2.2,"fill":1.2}},
  "places":{ {{- hsc_places | remove_last: ',' -}} },
  "slides":[{{ hsc_items }}]}</script>
