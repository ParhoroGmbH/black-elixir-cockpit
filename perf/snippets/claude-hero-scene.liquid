  {%- endfor -%}
  {%- capture hsc_items -%}
  {%- for n in (1..4) -%}
    {%- liquid
      assign btn2 = blank
      case n
        when 1
          assign eyebrow = 'claude.hero.e1_html' | t
          assign title = s.hero1_title
          if title == 'Die Adventszeit beginnt mit einem Türchen' or title == blank
            assign title = 'claude.hero.t1_html' | t
          endif
          assign text = s.hero1_text
          if text == 'Adventskalender von BABOR, ARTDECO, Molton Brown und Wir für Sie – Tür für Tür Pflege und Duft.' or text == blank
            assign text = 'claude.hero.x1_html' | t
          endif
          assign btn = s.hero1_btn
          if btn == 'Adventskalender entdecken' or btn == blank
            assign btn = 'claude.hero.b1_html' | t
          endif
          assign link = s.hero1_link | default: '/collections/luxus-adventskalender'
        when 2
          assign eyebrow = 'claude.c.only_until_html' | t
          assign title = 'claude.hero.t2_html' | t
          assign text = s.hero2_text
          if text == 'Ab 59 € eine italienische Seife deiner Wahl, ab 99 € zwei Seifen und eine Duftprobe – ganz ohne Code.' or text == blank
            assign text = 'claude.hero.x2_html' | t
          endif
          assign btn = s.hero2_btn
          if btn == 'Seife wählen' or btn == blank
            assign btn = 'claude.c.choose_soap_html' | t
          endif
          assign link = s.hero2_link | default: '/collections/geschenk-seifen'
          assign btn2 = 'claude.hero.b2b_html' | t
          assign link2 = '#ch-geschenk'
        when 3
          assign eyebrow = 'Fragrance Library · Extrait de Parfum'
          assign title = 'claude.hero.t3_html' | t
          assign text = 'claude.hero.x3_html' | t
          assign btn = 'claude.hero.b3_html' | t
          assign link = routes.collections_url | append: '/' | append: s.col_library
        else
          assign eyebrow = 'DUMO · Luxury Perfume'
          assign title = 'claude.hero.t4_html' | t
          assign text = 'claude.hero.x4_html' | t
          assign btn = 'claude.hero.b4_html' | t
          assign link = routes.collections_url | append: '/' | append: s.col_dumo
      endcase
      assign last = title | split: ' ' | last
      assign first = title | remove_last: last
      assign pn = 'be-hsc-poster-' | append: n | append: '.jpg'
      assign pm = 'be-hsc-poster-' | append: n | append: '-m.jpg'
      assign bgn = 'be-hero-bg-advent.png,be-hero-bg-seife.png,be-hero-bg-library.png,be-hero-bg-dumo.png' | split: ',' | slice: forloop.index0 | first
      assign poster = images[pn]
      unless poster.id != blank
        assign poster = images[bgn]
      endunless
      assign posterM = images[pm]
      unless posterM.id != blank
        assign posterM = poster
      endunless
      case n
        when 1
          assign mlist = 'BABOR|eab800eba079cdeb/be-cal-babor.glb|-24|babor|flat,ARTDECO|7f0bc976655f8fa4/be-cal-artdeco.glb|-24|artdeco|flat,Molton Brown|5c65f193dc68588a/be-cal-mb3.glb|-24|mb|flat,Wir für Sie|8c572b0420074443/be-cal-wfs.glb|-24|wfs|flat' | split: ','
        when 2
          assign mlist = 'Ambra & Vaniglia|66fa7df71ad55bd5/be2-soap-ambra.glb|-14|soap|soap,Bergamotto|9833b75849710d28/be2-soap-bergamotto.glb|-14|soap|soap,Fiori di Ciliegio|f65a5d777bb2cf87/be2-soap-ciliegio.glb|-14|soap|soap,Gelsomino|75befa81eadd0dfc/be2-soap-gelsomino.glb|-14|soap|soap,Lavanda|48fc8442dbc81963/be2-soap-lavanda.glb|-14|soap|soap,Orchidea Nera|9f0765b514b3ab27/be2-soap-orchidea.glb|-14|soap|soap' | split: ','
        when 3
          assign mlist = 'The Alchemist|726d6965c7f4d746/be4-fl-red.glb|20|alchemist|bottle,The House of Mirth|7a67b14fc1ffec9a/be4-fl-yellow.glb|20|mirth|bottle,Orlando|d4c849a1041ec3a7/be4-fl-orlando.glb|20|orlando|bottle,Invisible Cities|b4395c42ef329856/be4-fl-cities.glb|20|cities|bottle,Beloved|50b5261580d3bfd9/be4-fl-beloved.glb|20|beloved|bottle,Romeo and Juliet|ce3b708a28188d20/be4-fl-romeo.glb|20|romeo|bottle,Rebecca|13a61eafefe41e40/be4-fl-white.glb|20|rebecca|bottle' | split: ','
        else
          assign mlist = ''
          assign c_dumo = collections[s.col_dumo]
          for p in c_dumo.products limit: 7
            assign nm = p.title | remove: 'DUMO ' | split: ' ' | first
            assign low = nm | downcase
            case low
              when 'spartacus'
                assign g = '047518974017eb47/be6-dumo-spartacus.glb'
              when 'commodus'
                assign g = '61da2d04a7777b4a/be6-dumo-commodus.glb'
              when 'crixus'
                assign g = '7cc23c0d5f6caf4f/be6-dumo-crixus.glb'
              when 'marcus'
                assign g = '93cab1590bc3d47f/be6-dumo-marcus.glb'
              when 'rexor'
                assign g = 'ac06e8a8d2318792/be6-dumo-rexor.glb'
              when 'priscus'
                assign g = '4ba273098301cc2a/be6-dumo-priscus.glb'
              when 'verus'
                assign g = 'f62e89f263d62df5/be6-dumo-verus.glb'
              else
                assign g = ''
            endcase
            assign nmc = nm | capitalize
            if g != ''
              assign mlist = mlist | append: ',' | append: nmc | append: '|' | append: g | append: '|0|' | append: low | append: '|bust'
            endif
          endfor
          assign mlist = mlist | remove_first: ',' | split: ','
      endcase
    -%}
    {%- unless forloop.first -%},{%- endunless -%}{"items":[{%- for it in mlist -%}{%- assign ip = it | split: '|' -%}{"src":{{ cdn | append: ip[1] | json }},"az":{{ ip[2] }},"place":{{ ip[3] | json }},"kind":{{ ip[4] | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
    {%- capture slide_html -%}
    <div class="ch-slide h3-slide{% if forloop.first %} is-on{% endif %}" data-h3-slide style="--bg:url({{ poster | image_url: width: 2000 }});--bgm:url({{ posterM | image_url: width: 900 }})">
      <span class="h3-bgl" aria-hidden="true"></span><span class="h3-wipe" aria-hidden="true"></span>
      <div class="h3-text">
        <a href="{{ routes.collections_url }}/{{ s.col_soaps }}" class="h3-chip ch-glassD"><i></i>{{ 'claude.hero.chip_html' | t }}</a>
        <p class="h3-eyebrow">{{ eyebrow }}</p>
        {%- if forloop.first -%}<h1 class="h3-title">{{ first }}<em class="h3-shine">{{ last }}</em></h1>{%- else -%}<h2 class="h3-title">{{ first }}<em class="h3-shine">{{ last }}</em></h2>{%- endif -%}
        <p class="d">{{ text }}</p>
        {%- if n == 1 -%}<p class="h3-count" data-h3-count></p>{%- endif -%}
        <div class="h3-btns"><a class="ch-btn ch-btn--gold" href="{{ link }}">{{ btn }}</a>{%- if btn2 != blank -%}<a class="ch-btn ch-btn--line" href="{{ link2 }}">{{ btn2 }}</a>{%- endif -%}</div>
      </div>
      <div class="h3-stage">
        <div class="h3-par">
          <div class="m3{% if n == 2 %} m3-soap{% endif %}{% if n == 4 %} m3-dumo{% endif %}" data-m3>
            {%- if mlist.size > 1 -%}
            <div class="ca3-tabs m3-tabs" role="group" aria-label="{% if n == 4 %}{{ 'claude.hero.aria_warrior_html' | t }}{% else %}{{ 'claude.hero.aria_pick_html' | t }}{% endif %}">{%- for it in mlist -%}{%- assign ip = it | split: '|' -%}<button type="button" data-m3-go{% if forloop.first %} class="on"{% endif %}>{{ ip[0] }}</button>{%- endfor -%}</div>
            {%- endif -%}{%- if n == 2 -%}<span class="sp3-tag">{{ 'claude.hero.tag59_html' | t }}</span>{%- endif -%}
          </div>
        </div>
      </div>
    </div>
    {%- endcapture -%}
    {%- assign hsc_slides = hsc_slides | append: slide_html -%}
  {%- endfor -%}
  {%- endcapture -%}
  {{ hsc_slides }}
  <div class="ch-ctrl">
    <button type="button" data-h3-prev aria-label="{{ 'claude.hero.prev_html' | t }}">←</button>
    <div class="ch-dots">{%- for n in (1..4) -%}<button type="button" data-h3-dot="{{ forloop.index0 }}" aria-label="{{ 'claude.hero.dot_html' | t: n: n }}"{% if forloop.first %} class="is-on"{% endif %}></button>{%- endfor -%}</div>
    <button type="button" data-h3-next aria-label="{{ 'claude.hero.next_html' | t }}">→</button>
  </div>
