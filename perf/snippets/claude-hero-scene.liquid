    var sky = new THREE.Mesh(groundedSphere(THREE, 1, 60, cfg.crop), new THREE.MeshBasicMaterial({ depthWrite: false, toneMapped: false }));
    sky.renderOrder = -10; sky.visible = false; scene.add(sky);
