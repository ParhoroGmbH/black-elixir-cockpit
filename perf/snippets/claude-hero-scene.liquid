      o.tag.style.left = ((sx - b.left) / k).toFixed(1) + 'px'; o.tag.style.top = ((sy - b.top - 12) / k).toFixed(1) + 'px';
    }

    function size() {
      var W = h.clientWidth, Hc = h.clientHeight; if (!W || !Hc) return;
      renderer.setPixelRatio(Math.min(devicePixelRatio || 1, mob() ? 1.5 : 2));
      renderer.setSize(W, Hc, false); layout(true); dirty = 1;
    }

    // --- Ziehen = Kamera; losgelassen treibt sie nach ein paar Sekunden weiter
    controls.addEventListener('start', function () { drag = 1; hold(); boxes[curSlide] && (boxes[curSlide].touched = 1); kick(); });
    controls.addEventListener('end', function () { drag = 0; resumeT = performance.now() + cfg.resume;
      var a = controls.getAzimuthalAngle(); az = a; if (flat) { ph = Math.asin(Math.max(-1, Math.min(1, a / cfg.flatDrift))); } kick(); });
    controls.addEventListener('change', function () { dirty = 1; });
    canvas.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
