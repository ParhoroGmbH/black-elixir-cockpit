      var url = mob() ? P.envM : P.env, c = places[url];
      if (c) { c.u = ++use; return c.p; }
      c = places[url] = { u: ++use, p: null };
      c.p = new THREE.TextureLoader().loadAsync(url).then(function (tex) {
