        var ks = Object.keys(a[0]).filter(function (k) { return a[0][k].obj !== (curIt && curIt.obj) && a[0][k].tex !== (curIt && curIt.tex) && (a[0][k].obj || a[0][k].tex); }).sort(function (p, q) { return a[0][p].u - a[0][q].u; });
        while (ks.length > a[1] - 1) { var k = ks.shift(); a[2](a[0][k]); delete a[0][k]; }
      });
    }

    function shadowTex(fx, fz, round) { // weicher Kontaktschatten; Flakons/Büsten rund, Kalender/Seifen eckig
      var Sz = 256, pad = 0.12, W = fx + pad * 2, D = fz + pad * 2, cv = document.createElement('canvas'); cv.width = cv.height = Sz;
