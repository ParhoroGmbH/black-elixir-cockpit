    }

    // --- Wechsel: altes Bild bleibt stehen (Schnappschuss), bis Ort + Produkt fertig sind, dann Überblendung
    var tok = 0, live = 0, az = 0, az0 = 0, flat = 0, ph = 0, dir = 1, drag = 0, resumeT = 0, fadeT = 0, lt = 0, layoutN = 0;
    var view = { cx: 0, cy: 0, P: 300 };
    function go(s, i, done) {
      var it = itemOf(s, i); if (!it) return;
      var my = ++tok; S.busy = 1;
      Promise.all([loadPlace(it), loadModel(it)]).then(function (r) {
        if (my !== tok) return;
        swap(it, s, r[0], r[1]); if (done) done(); S.busy = 0;
        warmNext(s, i);
      }).catch(function () { if (my === tok) { S.busy = 0; live = 0; h.classList.remove('hsc-live'); if (s === want) activate(s); if (done) done(); } }); // Ladefehler: Poster des Motivs statt veralteter Szene
    }
    function warm(s, i) { var it = itemOf(s, i); if (it) { loadPlace(it).catch(function () {}); loadModel(it).catch(function () {}); } }
    function warmNext(s, i) { // nächstes Produkt im Motiv und erstes des nächsten Motivs vorladen
      setTimeout(function () {
        var n = cfg.slides[s].items.length; if (n > 1) warm(s, (i + 1) % n);
        var s2 = (s + 1) % cfg.slides.length; warm(s2, boxes[s2] ? boxes[s2].i : 0);
      }, 1200);
    }
    function swap(it, s, pl, md) {
      var K = cfg.kinds[it.kind] || cfg.kinds.bottle, P = placeOf(it);
      if (live) { // Schnappschuss des letzten Bildes über die Leinwand legen
        renderer.render(scene, camera);
        snap.width = canvas.width; snap.height = canvas.height; snap.getContext('2d').drawImage(canvas, 0, 0);
        snap.style.transition = 'none'; snap.style.opacity = 1;
      }
      sky.material.map = pl.tex; sky.material.needsUpdate = true; sky.visible = true;
      sky.geometry.dispose(); sky.geometry = groundedSphere(THREE, P.h, 60, cfg.crop); sky.position.y = P.h; sky.rotation.y = P.rot;
      scene.environment = pl.env.texture; scene.environmentIntensity = P.ei; scene.environmentRotation.y = P.rot;
      key.intensity = K.key; fill.intensity = K.fill; key.position.set(Math.sin(P.rot - 2.2) * 3, 2.4, Math.cos(P.rot - 2.2) * 3);
      slot.clear(); slot.add(md.obj);
