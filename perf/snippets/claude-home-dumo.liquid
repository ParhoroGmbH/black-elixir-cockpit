{%- comment -%} Teil der Section claude-home – DUMO im Museums-Stil: großer 3D-Flakon (eigenes Modell je Duft) nah im Vordergrund (dreht langsam), Goldring, echte Krieger-Szene (Videos der DUMO-Landingpage) fern im Hintergrund, Wechsel I–VII. Claude · 11.11.2026 – nicht anfassen {%- endcomment -%}
{%- assign c_dumo = collections[sec.settings.col_dumo] -%}
{%- if c_dumo.products.size > 0 -%}
{%- assign scenes = 'dumo-gladiator-hero,dumo-arena,dumo-duell,dumo-tor-krieger,dumo-reiter,dumo-schwerter,dumo-gladiator-hero' | split: ',' -%}
{%- assign roman = 'I,II,III,IV,V,VI,VII' | split: ',' -%}
{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0762/4949/7942/files/' -%}
<style>
  .cm{position:relative;background:#050403!important;color:#f3ead8;overflow:hidden;padding:0!important}
  .cm-stage{position:relative;height:min(860px,96vh);min-height:640px}
  .cm-bg{position:absolute;inset:0;opacity:0;transition:opacity 1.4s ease}
  .cm-bg.on{opacity:1}
  .cm-bg img,.cm-bg video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:blur(3px) saturate(.75) brightness(.55);transform:scale(1.18);transition:transform 9s linear}
  .cm-bg.on img,.cm-bg.on video{transform:scale(1.06)}
  .cm-stage::after{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 46% 56% at 50% 50%,rgba(5,4,3,.15),rgba(5,4,3,.82) 78%),linear-gradient(180deg,#050403 0,rgba(5,4,3,0) 18%,rgba(5,4,3,0) 78%,#050403 100%)}
  .cm-lines{position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(90deg,transparent calc(25% - .5px),rgba(255,255,255,.07) 25%,transparent calc(25% + .5px),transparent calc(75% - .5px),rgba(255,255,255,.07) 75%,transparent calc(75% + .5px))}
  .cm-ring{position:absolute;z-index:3;left:50%;top:50%;width:min(520px,62vh);aspect-ratio:1;transform:translate(-50%,-50%);pointer-events:none}
  .cm-ring circle{fill:none;stroke:#e6c77e;stroke-width:1.4;stroke-dasharray:1600;stroke-dashoffset:1600;filter:drop-shadow(0 0 10px rgba(240,205,130,.85)) drop-shadow(0 0 30px rgba(240,205,130,.45));transition:stroke-dashoffset 2.4s cubic-bezier(.6,0,.2,1)}
  .cm.go .cm-ring circle{stroke-dashoffset:0}
  .cm-model{position:absolute;z-index:4;left:50%;top:50%;width:min(560px,70vh);height:min(700px,84vh);transform:translate(-50%,-50%) scale(var(--z,1));filter:blur(var(--b,0));opacity:var(--o,1);transition:transform 1.8s cubic-bezier(.16,.84,.24,1),filter 1.4s ease,opacity 1.2s ease}
  .cm.swap .cm-model{--z:.55;--b:6px;--o:0;transition-duration:.55s}
  .cm-model model-viewer{width:100%;height:100%;--poster-color:transparent;background:transparent}
  .cm-model model-viewer::part(default-progress-bar){display:none}
  .cm-name{position:absolute;z-index:5;left:clamp(16px,6vw,96px);bottom:clamp(40px,9vh,110px);margin:0;font-family:"Bodoni Moda","Didot","Playfair Display",Georgia,serif;font-weight:400;font-size:clamp(64px,10vw,168px);line-height:.9;letter-spacing:-.01em;color:#f6efe2;text-shadow:0 10px 40px rgba(0,0,0,.6);overflow:hidden}
  .cm-name span{display:block;transform:translateY(0);transition:transform 1.1s cubic-bezier(.16,.84,.24,1) .25s,opacity .8s .25s}
  .cm.swap .cm-name span{transform:translateY(105%);opacity:0;transition-duration:.45s;transition-delay:0s}
  .cm-meta{position:absolute;z-index:5;left:clamp(16px,6vw,96px);top:clamp(40px,10vh,120px);max-width:260px;font-size:13px;line-height:1.6;color:#d8ccb4;transition:opacity .8s .4s}
  .cm.swap .cm-meta{opacity:0;transition-delay:0s;transition-duration:.3s}
  .cm-meta b{display:block;margin-bottom:10px;font-weight:400;font-size:11px;letter-spacing:.42em;color:#c8a45c}
  .cm-meta i{display:block;font-family:"Bodoni Moda",Georgia,serif;font-style:italic;font-size:20px;color:#f3ead8;margin-bottom:12px}
  .cm-meta a{display:inline-block;margin-top:16px;padding:12px 22px;border:1px solid #c8a45c;border-radius:999px;color:#f3ead8;text-decoration:none;font-size:12px;letter-spacing:.24em;text-transform:uppercase;transition:background .3s,color .3s}
  .cm-meta a:hover{background:#c8a45c;color:#050403}
  .cm-list{position:absolute;z-index:5;right:clamp(16px,5vw,80px);top:50%;transform:translateY(-50%);list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
  .cm-list button{display:flex;align-items:baseline;gap:14px;width:100%;min-height:36px;padding:4px 0;background:none;border:0;color:rgba(243,234,216,.42);font:inherit;font-size:12px;letter-spacing:.3em;text-transform:uppercase;cursor:pointer;text-align:left;transition:color .4s}
  .cm-list button em{font-style:normal;width:30px;color:inherit;font-family:"Bodoni Moda",Georgia,serif;letter-spacing:.1em}
  .cm-list button:hover,.cm-list button.on{color:#f3ead8}
  .cm-list button.on em{color:#c8a45c}
  .cm-bar{position:absolute;z-index:5;left:clamp(16px,6vw,96px);right:clamp(16px,6vw,96px);bottom:22px;height:1px;background:rgba(255,255,255,.12)}
  .cm-bar span{display:block;height:100%;width:0;background:#c8a45c}
  .cm.run .cm-bar span{width:100%;transition:width 8s linear}
  .cm-head{position:absolute;z-index:5;top:clamp(40px,10vh,120px);right:clamp(16px,5vw,80px);text-align:right;font-size:11px;letter-spacing:.42em;color:#c8a45c}
  @media (max-width:860px){
    .cm-stage{height:720px;min-height:0}
    .cm-model{width:96vw;height:500px;top:47%}
    .cm-ring{width:78vw;top:47%}
    .cm-name{font-size:clamp(46px,15vw,72px);bottom:96px}
    .cm-meta{top:28px;max-width:62vw;font-size:12px}
    .cm-meta i{font-size:16px;margin-bottom:6px}
    .cm-meta a{margin-top:8px;padding:10px 16px}
    .cm-head{top:28px}
    .cm-list{top:auto;bottom:40px;left:16px;right:16px;transform:none;flex-direction:row;justify-content:space-between;gap:0}
    .cm-list button{justify-content:center;min-width:40px;min-height:44px}
    .cm-list button span{display:none}
    .cm-list button em{width:auto}
    .cm-lines{display:none}
  }
  @media (prefers-reduced-motion:reduce){.cm-bg img,.cm-bg video{transition:none;transform:scale(1.06)}.cm-model,.cm-name span{transition:none}}
</style>
<section class="ch-sec cm" id="ch-dumo" data-cm aria-label="{{ 'claude.d.aria_html' | t }}">
  <div class="cm-stage">
    {%- for p in c_dumo.products limit: 7 -%}
      <div class="cm-bg{% if forloop.first %} on{% endif %}" data-v="{{ cdn }}{{ scenes[forloop.index0] }}.mp4">
        <img src="{{ cdn }}{{ scenes[forloop.index0] }}.png?width=1600" alt="" aria-hidden="true" loading="lazy" width="1344" height="752">
      </div>
    {%- endfor -%}
    <span class="cm-lines" aria-hidden="true"></span>
    <svg class="cm-ring" viewBox="0 0 520 520" aria-hidden="true"><circle cx="260" cy="260" r="250"/></svg>
    <div class="cm-model">
      <model-viewer alt="{{ 'claude.hero.alt_dumo_html' | t }}" camera-orbit="0deg 84deg 105%" auto-rotate auto-rotate-delay="0" rotation-per-second="14deg" interaction-prompt="none" disable-zoom disable-pan environment-image="neutral" shadow-intensity="0" exposure="1.25" loading="lazy" crossorigin="anonymous"></model-viewer>
    </div>
    <p class="cm-head">DUMO · <span data-cm-i>I</span> / VII</p>
    {%- for p in c_dumo.products limit: 7 -%}
      {%- assign nm = p.title | remove: 'DUMO ' | split: ' ' | first -%}
      {%- assign tag = p.title | remove: 'DUMO ' | remove_first: nm | remove: 'Eau de Parfum' | remove: '100 ml' | strip -%}
      {%- assign low = nm | downcase -%}
      {%- if low == 'spartacus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/047518974017eb47/be6-dumo-spartacus.glb' -%}{%- elsif low == 'commodus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/61da2d04a7777b4a/be6-dumo-commodus.glb' -%}{%- elsif low == 'crixus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/7cc23c0d5f6caf4f/be6-dumo-crixus.glb' -%}{%- elsif low == 'marcus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/93cab1590bc3d47f/be6-dumo-marcus.glb' -%}{%- elsif low == 'rexor' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/ac06e8a8d2318792/be6-dumo-rexor.glb' -%}{%- elsif low == 'priscus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/4ba273098301cc2a/be6-dumo-priscus.glb' -%}{%- elsif low == 'verus' -%}{%- assign glb = 'https://cdn.shopify.com/3d/models/o/f62e89f263d62df5/be6-dumo-verus.glb' -%}{%- else -%}{%- assign glb = '' -%}{%- endif -%}
      <template data-cm-item data-src="{{ glb }}" data-name="{{ nm | capitalize }}" data-roman="{{ roman[forloop.index0] }}">
        <b>DUMO · {{ roman[forloop.index0] }}</b><i>{{ tag | default: 'Eau de Parfum' }}</i>Eau de Parfum · {{ p.price | money }}<br><a href="{{ p.url }}">{{ 'claude.c.to_scent_html' | t }}</a>
      </template>
    {%- endfor -%}
    <div class="cm-meta" data-cm-meta aria-live="polite"></div>
    <h2 class="cm-name"><span data-cm-name>DUMO</span></h2>
    <ul class="cm-list">
      {%- for p in c_dumo.products limit: 7 -%}
        {%- assign nm = p.title | remove: 'DUMO ' | split: ' ' | first -%}
        <li><button type="button" data-cm-go="{{ forloop.index0 }}"><em>{{ roman[forloop.index0] }}</em><span>{{ nm }}</span></button></li>
      {%- endfor -%}
    </ul>
    <span class="cm-bar" aria-hidden="true"><span></span></span>
  </div>
</section>
<script>/* Perf 13.11.2026: model-viewer (200 KB) erst laden, wenn die DUMO-Sektion naht (900 px vorher) statt beim Seitenaufbau; gleiche Version 3.5.0, gleiche Quelle */(function(){var s=document.getElementById('ch-dumo');function ld(){if(window.__mvLoad||customElements.get('model-viewer'))return;window.__mvLoad=1;var m=document.createElement('script');m.type='module';m.src='https://cdn.jsdelivr.net/npm/@google/model-viewer@3.5.0/dist/model-viewer.min.js';document.head.appendChild(m)}if(!s||!('IntersectionObserver' in window))return ld();new IntersectionObserver(function(es,o){if(es[0].isIntersecting){o.disconnect();ld()}},{rootMargin:'900px 0px'}).observe(s)})();</script>
<script>
  (function () {
    var s = document.currentScript.previousElementSibling.previousElementSibling;
    var items = s.querySelectorAll('[data-cm-item]'), bgs = s.querySelectorAll('.cm-bg'), btns = s.querySelectorAll('[data-cm-go]');
    var mv = s.querySelector('model-viewer'), meta = s.querySelector('[data-cm-meta]'), nameEl = s.querySelector('[data-cm-name]'), num = s.querySelector('[data-cm-i]');
    var cur = -1, timer, seen = false, vis = true, rm = matchMedia('(prefers-reduced-motion:reduce)').matches;
    // 12.11.2026: außerhalb des Sichtbereichs kein Wechsel (kein Nachladen von 3D-Modellen/Videos), Hintergrundvideo pausiert
    function next(d) { clearTimeout(timer); timer = setTimeout(function tick() { if (vis) show((cur + 1) % items.length); else timer = setTimeout(tick, 1500); }, d); }
    function tint() { var it = items[cur]; if (it && it.dataset.src && mv.src !== it.dataset.src) mv.src = it.dataset.src; }
    if (items[0]) mv.src = items[0].dataset.src;
    function bgVideo(b) { if (rm || b.querySelector('video')) return; var v = document.createElement('video'); v.muted = true; v.loop = true; v.playsInline = true; v.setAttribute('aria-hidden', 'true'); v.src = b.dataset.v; b.appendChild(v); v.play().catch(function () {}); }
    function show(i) {
      if (i === cur) return; cur = i;
      s.classList.add('swap'); s.classList.remove('run');
      bgs.forEach(function (b, k) { b.classList.toggle('on', k === i); var v = b.querySelector('video'); if (v) { if (k === i) v.play().catch(function () {}); else v.pause(); } });
      bgVideo(bgs[i]);
      btns.forEach(function (b, k) { b.classList.toggle('on', k === i); b.setAttribute('aria-current', k === i ? 'true' : 'false'); });
      setTimeout(function () {
        var it = items[i]; nameEl.textContent = it.dataset.name; num.textContent = it.dataset.roman; meta.innerHTML = it.innerHTML; tint();
        if (mv.jumpCameraToGoal) { mv.cameraOrbit = '-40deg 84deg 105%'; mv.jumpCameraToGoal(); }
        setTimeout(function () { s.classList.remove('swap'); void s.offsetWidth; s.classList.add('run'); }, 40);
      }, 560);
      next(8600);
    }
    btns.forEach(function (b) { b.addEventListener('click', function () { show(+b.dataset.cmGo); }); });
    s.addEventListener('mouseenter', function () { clearTimeout(timer); s.classList.remove('run'); });
    s.addEventListener('mouseleave', function () { if (seen) next(4000); });
    function start() { if (seen) return; seen = true; s.classList.add('go'); show(0); }
    s.classList.add('swap');
    if (!('IntersectionObserver' in window)) return start();
    new IntersectionObserver(function (es, o) { if (es[0].isIntersecting) { o.disconnect(); start(); } }, { threshold: .35 }).observe(s);
    new IntersectionObserver(function (es) { vis = es[0].isIntersecting; var v = bgs[cur] && bgs[cur].querySelector('video'); if (v) { if (vis) v.play().catch(function () {}); else v.pause(); } }, { rootMargin: '150px 0px' }).observe(s);
  })();
</script>
{%- endif -%}