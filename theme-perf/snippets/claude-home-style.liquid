{%- comment -%} Teil der Section claude-home (Claude · Neue Homepage 11.11.2026 – nicht anfassen) {%- endcomment -%}
{%- assign s = sec.settings -%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300&display=swap">
<style>
  .ch{--acc:{{ s.acc }};--accL:{{ s.acc_light }};--accD:{{ s.acc_dark }};--dark:{{ s.dark }};--light:{{ s.light }};--mut:#c9c1b4;--ink:#0b0b0b;font-family:inherit;color:var(--ink);background:#fff;overflow:hidden}
  .be-hp-kuratiert{display:none!important}
  .ch *{box-sizing:border-box}
  .ch a{color:inherit;text-decoration:none}
  .ch-wrap{max-width:1240px;margin:0 auto;padding:0 clamp(16px,4vw,56px)}
  .ch-sec{position:relative;isolation:isolate;overflow:hidden;padding:clamp(64px,9vw,120px) 0}
  .ch-dark{background:var(--dark);color:#fff}
  .ch-light{background:var(--light)}
  .ch-eyebrow{margin:0 0 14px;font-size:12px;letter-spacing:.3em;text-transform:uppercase;color:var(--accD)}
  .ch-dark .ch-eyebrow{color:var(--acc)}
  .ch-h2{margin:0;font-family:"Cormorant Garamond","Bodoni Moda",Georgia,serif;font-weight:300;font-size:clamp(38px,5.4vw,66px);line-height:1.04;letter-spacing:.01em;text-wrap:balance}
  .cm .cm-name{font-family:"Cormorant Garamond",Georgia,serif;font-weight:300;letter-spacing:.02em;font-size:clamp(42px,5vw,96px);white-space:nowrap;padding:.08em .25em .08em 0;animation:cmFlick 7s infinite,cmShake 7s infinite}
  @keyframes cmFlick{0%,100%{opacity:1;text-shadow:0 0 14px rgba(240,205,130,.55),0 0 40px rgba(240,205,130,.28)}7%{opacity:1}8%{opacity:.35;text-shadow:none}9%{opacity:1;text-shadow:0 0 22px rgba(255,220,150,.8),0 0 60px rgba(240,205,130,.4)}10%{opacity:.5;text-shadow:none}11.5%{opacity:1;text-shadow:0 0 16px rgba(240,205,130,.6),0 0 44px rgba(240,205,130,.3)}45%{text-shadow:0 0 4px rgba(240,205,130,.15)}55%{opacity:.9}57%{opacity:.6}58%{opacity:1;text-shadow:0 0 20px rgba(255,220,150,.7),0 0 56px rgba(240,205,130,.35)}}
  @keyframes cmShake{0%,6.5%,12.5%,56%,60%,100%{transform:translate(0,0)}7%{transform:translate(-3px,1px)}8%{transform:translate(3px,-1px)}9%{transform:translate(-2px,0)}10%{transform:translate(2px,1px)}11%{transform:translate(-1px,-1px)}57%{transform:translate(2px,0)}58%{transform:translate(-2px,1px)}}
  @media (max-width:860px){.cm .cm-name{font-size:clamp(38px,11vw,60px)}}
  @media (prefers-reduced-motion:reduce){.cm .cm-name{animation:none}}
  .cm .cm-ring,.ch .dm3-ring{display:none!important}
  .ch-lead{margin:14px 0 0;font-size:16px;line-height:1.6;color:#55504a;max-width:620px}
  .ch-dark .ch-lead{color:var(--mut)}
  .ch-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:40px}
  .ch-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 28px;border-radius:999px;font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;transition:transform .3s,background .3s,color .3s;cursor:pointer;border:0;font-family:inherit}
  .ch-btn:hover{transform:translateY(-2px)}
  .ch-btn--gold{background:var(--acc);color:#000!important}
  .ch-btn--dark{background:var(--dark);color:#fff!important}
  .ch-btn--line{border:1px solid currentColor;background:transparent}
  .ch-glassL{background:linear-gradient(145deg,rgba(255,255,255,.66),rgba(255,255,255,.22));backdrop-filter:blur(18px) saturate(160%);-webkit-backdrop-filter:blur(18px) saturate(160%);border:1px solid rgba(255,255,255,.75);box-shadow:0 24px 50px rgba(0,0,0,.08),inset 0 1px 0 rgba(255,255,255,.95)}
  .ch-glassD{background:linear-gradient(145deg,rgba(255,255,255,.14),rgba(255,255,255,.03));backdrop-filter:blur(20px) saturate(150%);-webkit-backdrop-filter:blur(20px) saturate(150%);border:1px solid rgba(255,255,255,.2);box-shadow:inset 0 1px 0 rgba(255,255,255,.28),0 30px 60px rgba(0,0,0,.35)}
  .ch-sheen{position:relative;overflow:hidden}
  .ch-sheen::after{content:"";position:absolute;inset:-50%;background:linear-gradient(115deg,transparent 42%,rgba(255,255,255,.45) 50%,transparent 58%);transform:translateX(-70%);transition:transform 1.1s cubic-bezier(.2,.7,.2,1);pointer-events:none}
  .ch-sheen:hover::after{transform:translateX(70%)}
  .ch-blob{position:absolute;z-index:-1;border-radius:50%;filter:blur(80px);opacity:.45;pointer-events:none;animation:chDrift 18s ease-in-out infinite alternate}
  @keyframes chDrift{to{transform:translate(70px,-50px) scale(1.18)}}
  .ch-tilt{transition:transform .5s cubic-bezier(.2,.7,.2,1),box-shadow .5s}
  .ch-tilt:hover{transform:perspective(900px) rotateX(5deg) rotateY(-8deg) translateY(-6px);box-shadow:0 30px 50px rgba(0,0,0,.16)}
  .ch-scroll{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding:16px 4px 26px;scrollbar-width:thin}
  .ch-scroll>*{scroll-snap-align:start}

  /* Hero */
  .ch-hero{position:relative;height:clamp(560px,82vh,860px);background:#000;color:#fff;overflow:hidden}
  .ch-slide{position:absolute;inset:0;opacity:0;transition:opacity 1.1s ease;pointer-events:none}
  .ch-slide.is-on{opacity:1;pointer-events:auto}
  .ch-slide picture,.ch-slide img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .ch-slide img{transform:scale(1.06);transition:transform 8s linear}
  .ch-slide.is-on img{transform:scale(1)}
  .ch-slide::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.72),rgba(0,0,0,.15) 60%,transparent)}
  .ch-cap{position:absolute;z-index:2;left:clamp(16px,5vw,72px);bottom:clamp(80px,12vh,130px);max-width:560px;padding:30px 32px;border-radius:30px}
  .ch-cap h1,.ch-cap h2{margin:10px 0 12px;font-size:clamp(34px,5vw,64px);line-height:1.02;font-weight:400;text-wrap:balance}
  .ch-cap p{margin:0 0 22px;font-size:16px;line-height:1.6;color:#e9e4da}
  .ch-chip{display:inline-flex;align-items:center;gap:10px;padding:8px 14px;border-radius:999px;font-size:12px;letter-spacing:.1em;color:var(--accL)}
  .ch-chip i{width:8px;height:8px;border-radius:50%;background:var(--acc)}
  .ch-ctrl{position:absolute;z-index:3;right:clamp(16px,4vw,48px);bottom:34px;display:flex;align-items:center;gap:12px}
  .ch-ctrl button{width:48px;height:48px;border-radius:999px;border:1px solid rgba(255,255,255,.4);background:rgba(0,0,0,.25);color:#fff;cursor:pointer;font-size:18px}
  .ch-dots{display:flex;gap:8px}
  .ch-dots button{width:18px;height:4px;border-radius:2px;border:0;padding:0;background:rgba(255,255,255,.4);transition:width .4s}
  .ch-dots button.is-on{width:46px;background:var(--acc)}
  .ch-dust{position:absolute;z-index:1;bottom:-10px;border-radius:50%;background:var(--accL);box-shadow:0 0 10px var(--acc);animation:chDust 9s linear infinite;pointer-events:none}
  @keyframes chDust{0%{transform:translateY(0);opacity:0}15%{opacity:.9}100%{transform:translateY(-520px);opacity:0}}

  /* Trust */
  .ch-trust{border-bottom:1px solid #ece7de;padding:18px 0}
  .ch-trust .ch-wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 26px;font-size:13px}
  .ch-trust span{display:flex;align-items:center;gap:8px}
  .ch-trust i{width:8px;height:8px;border-radius:50%;background:var(--acc)}

  /* Stories */
  .ch-stories{padding:34px 0 26px;border-bottom:1px solid #ece7de}
  .ch-stories .ch-scroll{justify-content:center}
  .ch-story{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:10px;font-size:13px}
  .ch-story span.ring{width:92px;height:92px;border-radius:50%;padding:3px;background:conic-gradient(var(--acc),var(--accD),var(--accL),var(--acc));display:block}
  .ch-story img{width:100%;height:100%;border-radius:50%;border:3px solid #fff;object-fit:cover;display:block}

  /* Marken-Laufband */
  .ch-marq{overflow:hidden;padding:26px 0;border-bottom:1px solid #ece7de}
  .ch-marq div{display:flex;gap:64px;width:max-content;font-size:26px;letter-spacing:.12em;animation:chMarq 40s linear infinite}
  .ch-marq a:hover{color:var(--accD)}
  @keyframes chMarq{to{transform:translateX(-50%)}}

  /* Produktkarten */
  .ch-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
  .ch-tabs button{min-height:44px;padding:0 20px;border-radius:999px;border:1px solid rgba(255,255,255,.9);background:rgba(255,255,255,.55);cursor:pointer;font-family:inherit;font-size:13px;letter-spacing:.06em}
  .ch-tabs button.is-on{background:var(--dark);color:#fff;border-color:var(--dark)}
  .ch-panel{display:none}.ch-panel.is-on{display:flex}
  .ch-card{flex:0 0 280px;border-radius:150px 150px 28px 28px;display:flex;flex-direction:column}
  .ch-card__img{position:relative;height:320px;display:flex;align-items:center;justify-content:center;padding:58px 26px 10px}
  .ch-card__img img{max-width:100%;max-height:100%;object-fit:contain;mix-blend-mode:multiply}
  .ch-card__tag{position:absolute;top:30px;left:50%;transform:translateX(-50%);border-radius:999px;background:var(--dark);color:#fff;font-size:10px;letter-spacing:.2em;padding:6px 12px;white-space:nowrap}
  .ch-card__body{padding:16px 22px 22px;display:flex;flex-direction:column;gap:6px;flex:1}
  .ch-card__vendor{font-size:11px;letter-spacing:.2em;color:var(--accD);text-transform:uppercase}
  .ch-card__title{font-size:18px;line-height:1.25;min-height:45px}
  .ch-card__price{display:flex;gap:10px;align-items:baseline;margin-top:auto;padding-top:12px}
  .ch-card__price b{font-size:17px}
  .ch-card__price s{font-size:13px;color:#8a8278}
  .ch-card form{margin:10px 0 0}
  .ch-card form .ch-btn{width:100%}

</style>