{{ content_for_header }}
<style>
:root{
  --night:#0f131b; --night2:#161b25; --enamel:#1f3f8c; --edge:#2e6a4f; --ivory:#f4efe6; --mist:#a9b1c0; --brass:#c9a35e; --line:rgba(244,239,230,.15);
  --paper:#f3eee6; --paper-ink:#1b1f27;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{margin:0;background:var(--night);color:var(--ivory);font:400 17px/1.6 "Instrument Sans","Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased}
html[lang=ar] body{font-family:Amiri,"Noto Naskh Arabic",serif}
html[lang=he] body{font-family:"Frank Ruhl Libre",serif}
a{color:inherit}
.disp{font-family:"Bodoni Moda",Didot,"Times New Roman",serif}

.top{position:fixed;inset:0 0 auto 0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:calc(14px + env(safe-area-inset-top,0px)) 20px 14px;background:linear-gradient(var(--night),rgba(15,19,27,0));pointer-events:none;transition:background .3s,color .3s}
.top a{pointer-events:auto;text-decoration:none;letter-spacing:.18em;font-size:12px;font-weight:600}
.top .dot{font-size:13px;color:var(--mist)}
.brand{display:flex;align-items:center;gap:18px;flex-wrap:wrap;pointer-events:auto}
.langs{display:flex;gap:2px}
.langs a{padding:8px 6px;font-size:11px!important;letter-spacing:.1em!important;color:var(--mist);font-weight:400!important;border-bottom:1px solid transparent}
.langs a[aria-current]{color:var(--ivory);border-bottom-color:var(--brass)}
.langs a[lang=ar],.langs a[lang=he]{letter-spacing:0!important;font-size:13px!important}
.top.day{background:linear-gradient(rgba(243,238,230,.96),rgba(243,238,230,0));color:var(--paper-ink)}
.top.day .dot,.top.day .langs a{color:#6a6f7a}.top.day .langs a[aria-current]{color:var(--paper-ink)}

/* Straßenschild */
.hero{min-height:86vh;display:grid;place-items:center;text-align:center;padding:120px 20px 70px}
.sign{display:inline-block;background:var(--enamel);border-radius:12px;padding:10px;box-shadow:0 18px 40px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.25);transform:rotate(-1.5deg);direction:ltr}
.sign i{display:block;border:3px solid var(--edge);border-radius:7px;padding:4px}
.sign b{display:block;border:2px solid #f4f1ea;border-radius:5px;padding:12px clamp(18px,4vw,40px) 14px;color:#f4f1ea;font:600 clamp(40px,9vw,92px)/.95 "Barlow Condensed","Arial Narrow",sans-serif;letter-spacing:.02em}
.sign small{display:block;font:500 clamp(11px,1.6vw,15px)/1 "Barlow Condensed",sans-serif;letter-spacing:.24em;margin-bottom:8px;opacity:.9}
.hero h1{font:400 clamp(26px,4vw,44px)/1.15 "Bodoni Moda",Didot,serif;margin:1.1em 0 .3em;text-wrap:balance}
.hero p{max-width:34em;margin:0 auto;color:var(--mist)}
.hero .cue{display:inline-block;margin-top:34px;font-size:14px;color:var(--brass);text-decoration:none;border-bottom:1px solid currentColor}

/* Kapitel */
.ch{position:relative;height:220vh}
.stage{position:sticky;top:0;height:100vh;overflow:hidden}
.stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:70% 50%}
.stage .veil{position:absolute;inset:0;background:linear-gradient(90deg,rgba(15,19,27,.9) 0%,rgba(15,19,27,.6) 34%,rgba(15,19,27,0) 60%)}
.txt{position:absolute;left:clamp(20px,6vw,90px);top:50%;transform:translateY(-50%);width:min(420px,38vw)}
[dir=rtl] .txt{direction:rtl}
.plate{display:inline-flex;align-items:center;justify-content:center;min-width:112px;height:76px;background:var(--enamel);border-radius:9px;padding:5px;box-shadow:0 10px 24px rgba(0,0,0,.4);transform-origin:50% -40px;transform:rotate(-14deg);opacity:.0;transition:transform .9s cubic-bezier(.2,1.4,.4,1),opacity .4s;direction:ltr}
.plate span{display:flex;align-items:center;justify-content:center;width:100%;height:100%;border:2px solid #f4f1ea;outline:3px solid var(--edge);outline-offset:-1px;border-radius:6px;color:#f4f1ea;font:600 40px/1 "Barlow Condensed",sans-serif;padding:0 14px}
.on .plate{transform:rotate(0);opacity:1}
.place{font:italic 400 clamp(28px,3.2vw,40px)/1.1 "Bodoni Moda",Didot,serif;margin:18px 0 4px}
.time{font-size:13px;letter-spacing:.06em;color:var(--mist)}
.mean{margin:.8em 0 1.1em;font-size:18px;line-height:1.55}
.prod{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:14px}
.prod b{font-weight:600}.prod .pr{color:var(--mist);font-variant-numeric:tabular-nums}
.btn{display:inline-block;margin-top:14px;padding:11px 20px;border:1px solid var(--brass);color:var(--ivory);text-decoration:none;font-size:15px;transition:background .2s}
.btn:hover,.btn:focus-visible{background:var(--brass);color:var(--night)}
.fade{opacity:0;transform:translateY(8px);transition:opacity .6s,transform .6s}
.on .fade{opacity:1;transform:none}

/* Hausnummern-Leiste */
.street{position:fixed;z-index:15;right:16px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:6px;opacity:0;pointer-events:none;transition:opacity .4s}
.street.show{opacity:1;pointer-events:auto}
.street a{display:flex;align-items:center;justify-content:center;width:44px;height:30px;border-radius:5px;background:rgba(31,63,140,.55);border:1px solid rgba(244,241,234,.5);color:#f4f1ea;text-decoration:none;font:600 15px/1 "Barlow Condensed",sans-serif;transition:background .2s,transform .2s}
.street a[aria-current]{background:var(--enamel);transform:scale(1.12);border-color:#f4f1ea}

/* Shop */
.shop{background:var(--paper);color:var(--paper-ink);padding:90px 20px 100px}
.shop .in{max-width:1180px;margin:0 auto}
.shop h2{font:400 clamp(26px,3.6vw,38px)/1.2 "Bodoni Moda",Didot,serif;margin:0 0 .3em}
html[lang=ar] .shop h2,html[lang=ar] .hero h1,html[lang=ar] .place{font-family:Amiri,serif}
html[lang=he] .shop h2,html[lang=he] .hero h1,html[lang=he] .place{font-family:"Frank Ruhl Libre",serif}
.shop h3{font-weight:500;font-size:20px;margin:52px 0 18px;padding-bottom:10px;border-bottom:1px solid rgba(27,31,39,.18)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:28px 22px}
.card{text-decoration:none;display:block}
.card img{width:100%;aspect-ratio:1;display:block;mix-blend-mode:multiply;transition:transform .35s}
.card:hover img{transform:translateY(-4px)}
.card .n{display:block;margin-top:8px;font-size:15px;line-height:1.3}
.card .p{display:block;font-size:14px;color:#6a6f7a;font-variant-numeric:tabular-nums}
.foot{padding:50px 20px;text-align:center;font-size:14px;color:var(--mist)}
.foot a{color:var(--ivory);letter-spacing:.14em;font-weight:600;text-decoration:none}

@media (max-width:1000px),(orientation:portrait){
  .top .dot{display:none}
  .ch{height:auto}
  .stage{position:relative;height:auto;overflow:visible}
  .stage img{position:relative;height:auto;aspect-ratio:3/2;object-fit:contain}
  .stage .veil{display:none}
  .txt{position:relative;left:auto;top:auto;transform:none;width:auto;padding:22px 20px 60px}
  .fade{opacity:1;transform:none}
  .street{top:auto;bottom:calc(10px + env(safe-area-inset-bottom,0px));right:50%;transform:translateX(50%);flex-direction:row;gap:4px;background:rgba(15,19,27,.75);padding:6px;border-radius:10px;backdrop-filter:blur(6px)}
  .street a{width:34px;height:26px;font-size:13px}
}
@media (prefers-reduced-motion:reduce){
  .plate,.fade{transition:none;opacity:1;transform:none}
}
</style>

<style>/* Handy: kleinere Produktbilder, 3 Spalten (21.11.2026) */@media (max-width:600px){.grid{grid-template-columns:repeat(3,1fr)!important;gap:18px 10px!important}.card .n{font-size:12.5px!important}.card .p{font-size:12px!important}}</style>
</head>
<body>
{% case fa_l %}{% when "en" %}<header class="top"><div class="brand"><a href="{{ routes.root_url }}">BLACK ELIXIR</a><nav class="langs" id="langs" aria-label="Language">{%- for l in localization.available_languages -%}{%- assign lc = l.iso_code | slice: 0, 2 -%}{%- assign lr = l.root_url -%}{%- if lr == "/" -%}{%- assign lr = "" -%}{%- endif -%}<a href="{{ lr }}{{ page.url }}" lang="{{ lc }}" hreflang="{{ lc }}"{% if lc == fa_l %} aria-current="true"{% endif %}>{% case lc %}{% when "de" %}DE{% when "en" %}EN{% when "fr" %}FR{% when "it" %}IT{% when "da" %}DA{% when "ar" %}عربي{% when "he" %}עברית{% else %}{{ lc | upcase }}{% endcase %}</a>{%- endfor -%}</nav></div><span class="dot">Maison de Parfum</span></header>
<section class="hero"><div>
<div class="sign" role="img" aria-label="French Avenue"><i><b><small>PARFUMS · 2014</small>FRENCH AVENUE</b></i></div>
<h1 id="h1">French Avenue – one avenue, eight addresses</h1><p id="intro">French Avenue was founded in 2014, an idea born on trips to Paris. We walked the avenue once: eight house numbers, from morning until late at night.</p><a class="cue" id="cue" href="#n1">Start the walk</a>
</div></section>
<nav class="street" id="street" aria-label="House numbers"><a href="#n1">3</a><a href="#n2">7</a><a href="#n3">12</a><a href="#n4">21</a><a href="#n5">33</a><a href="#n6">40</a><a href="#n7">52</a><a href="#n8">88</a></nav>
<main id="chapters"><section class="ch" id="n1"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['fa-s-haydan.jpg'] | image_url: width: 900 }}"><img src="{{ images['fa-s-haydan.jpg'] | image_url: width: 1800 }}" alt="French Avenue An Equestrian Series Haydan – Morning · riding hall" width="1800" height="1195"></picture><div class="veil"></div><div class="txt"><div class="plate" aria-label="N° 3"><span>N° 3</span></div><div class="place" lang="fr">Manège</div><div class="time">Morning · riding hall</div><p class="mean fade">Morning light falls through the arched windows onto the sand. This is home to the green bottle of the Equestrian Series.</p><div class="prod fade"><b>French Avenue An Equestrian Series Haydan</b><span class="pr">{{ all_products['french-avenue-an-equestrian-series-haydan-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ fa_shop }}french-avenue-an-equestrian-series-haydan-eau-de-parfum">View fragrance</a></div></div></section><section class="ch" id="n2"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['fa-s-meringue.jpg'] | image_url: width: 900 }}"><img src="{{ images['fa-s-meringue.jpg'] | image_url: width: 1800 }}" alt="French Avenue Meringue – Noon · tea room" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="plate" aria-label="N° 7"><span>N° 7</span></div><div class="place" lang="fr">Salon de thé</div><div class="time">Noon · tea room</div><p class="mean fade">Marble, pastels and fine porcelain – and a bottle named after meringue.</p><div class="prod fade"><b>French Avenue Meringue</b><span class="pr">{{ all_products['french-avenue-meringue-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ fa_shop }}french-avenue-meringue-eau-de-parfum">View fragrance</a></div></div></section><section class="ch" id="n3"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['fa-s-paradise.jpg'] | image_url: width: 900 }}"><img src="{{ images['fa-s-paradise.jpg'] | image_url: width: 1800 }}" alt="French Avenue Sweet Paradise – Late afternoon · winter garden" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="plate" aria-label="N° 12"><span>N° 12</span></div><div class="place" lang="fr">Jardin d'hiver</div><div class="time">Late afternoon · winter garden</div><p class="mean fade">Under glass and palms, warm from the last sunlight of the day.</p><div class="prod fade"><b>French Avenue Sweet Paradise</b><span class="pr">{{ all_products['french-avenue-sweet-paradise-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ fa_shop }}french-avenue-sweet-paradise-eau-de-parfum">View fragrance</a></div></div></section><section class="ch" id="n4"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['fa-s-pierce.jpg'] | image_url: width: 900 }}"><img src="{{ images['fa-s-pierce.jpg'] | image_url: width: 1800 }}" alt="French Avenue An Equestrian Series Pierce – Evening · saddlery" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="plate" aria-label="N° 21"><span>N° 21</span></div><div class="place" lang="fr">Sellerie</div><div class="time">Evening · saddlery</div><p class="mean fade">Between saddles and brass buckles stands Pierce, the yellow bottle of the Equestrian Series.</p><div class="prod fade"><b>French Avenue An Equestrian Series Pierce</b><span class="pr">{{ all_products['french-avenue-an-equestrian-series-pierce-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ fa_shop }}french-avenue-an-equestrian-series-pierce-eau-de-parfum">View fragrance</a></div></div></section><section class="ch" id="n5"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['fa-s-pinnace.jpg'] | image_url: width: 900 }}"><img src="{{ images['fa-s-pinnace.jpg'] | image_url: width: 1800 }}" alt="French Avenue Pinnace Noir – Blue hour · boat workshop on the Seine" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="plate" aria-label="N° 33"><span>N° 33</span></div><div class="place" lang="fr">Atelier naval</div><div class="time">Blue hour · boat workshop on the Seine</div><p class="mean fade">A pinnace is a small sailing boat. In the workshop by the river, one rests on its trestles.</p><div class="prod fade"><b>French Avenue Pinnace Noir</b><span class="pr">{{ all_products['french-avenue-pinnace-noir-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ fa_shop }}french-avenue-pinnace-noir-eau-de-parfum">View fragrance</a></div></div></section><section class="ch" id="n6"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['fa-s-taurus.jpg'] | image_url: width: 900 }}"><img src="{{ images['fa-s-taurus.jpg'] | image_url: width: 1800 }}" alt="French Avenue Genesis Taurus – Night · observatory" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="plate" aria-label="N° 40"><span>N° 40</span></div><div class="place" lang="fr">Observatoire</div><div class="time">Night · observatory</div><p class="mean fade">The Genesis collection: twelve fragrances inspired by the constellations. Under the dome waits Taurus, the bull.</p><div class="prod fade"><b>French Avenue Genesis Taurus</b><span class="pr">{{ all_products['french-avenue-genesis-taurus-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ fa_shop }}french-avenue-genesis-taurus-eau-de-parfum">View fragrance</a></div></div></section><section class="ch" id="n7"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['fa-s-aries.jpg'] | image_url: width: 900 }}"><img src="{{ images['fa-s-aries.jpg'] | image_url: width: 1800 }}" alt="French Avenue Genesis Aries – Night · above the rooftops" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="plate" aria-label="N° 52"><span>N° 52</span></div><div class="place" lang="fr">Sur les toits</div><div class="time">Night · above the rooftops</div><p class="mean fade">Up among zinc roofs and chimney pots, in the moonlight: Aries, the ram.</p><div class="prod fade"><b>French Avenue Genesis Aries</b><span class="pr">{{ all_products['french-avenue-genesis-aries-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ fa_shop }}french-avenue-genesis-aries-eau-de-parfum">View fragrance</a></div></div></section><section class="ch" id="n8"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['fa-s-royal.jpg'] | image_url: width: 900 }}"><img src="{{ images['fa-s-royal.jpg'] | image_url: width: 1800 }}" alt="French Avenue Royal Blend – Late at night · private club" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="plate" aria-label="N° 88"><span>N° 88</span></div><div class="place" lang="fr">Club privé</div><div class="time">Late at night · private club</div><p class="mean fade">Black lacquer, red velvet, a single lamp. Royal Blend in cut crystal.</p><div class="prod fade"><b>French Avenue Royal Blend</b><span class="pr">{{ all_products['french-avenue-royal-blend-edp'].price | money }}</span></div><a class="btn fade" href="{{ fa_shop }}french-avenue-royal-blend-edp">View fragrance</a></div></div></section></main>
