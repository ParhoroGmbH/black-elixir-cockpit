">{{ p.price | money }}</span></a>{%- endif -%}{%- endunless -%}{%- endif -%}{%- endfor -%}{%- endcapture -%}{%- if fa_n > 0 -%}<h3>Royal Blend</h3><div class="grid">{{ fa_cards }}</div>{%- endif -%}{%- assign fa_n = 0 -%}{%- capture fa_cards -%}{%- for p in fa_col.products -%}{%- if p.available -%}{%- unless p.handle contains "fragrance-world" or p.handle contains "-90-ml" -%}{%- assign fa_ti = p.title | downcase -%}{%- assign fa_g = 3 -%}{%- if fa_ti contains "genesis" or fa_ti contains "capricorn" -%}{%- assign fa_g = 0 -%}{%- elsif fa_ti contains "equestrian" -%}{%- assign fa_g = 1 -%}{%- elsif fa_ti contains "royal blend" -%}{%- assign fa_g = 2 -%}{%- endif -%}{%- if fa_g == 3 -%}{%- assign fa_n = fa_n | plus: 1 -%}{%- assign fa_tn = "fa-t-" | append: p.handle | append: ".webp" -%}{%- assign fa_im = images[fa_tn] -%}{%- if fa_im == blank -%}{%- assign fa_im = p.featured_image -%}{%- endif -%}{%- assign fa_nm = p.title | remove_first: "French Avenue " | remove: " Eau de Parfum" | remove: " Extrait de Parfum" -%}{%- if fa_g == 0 and fa_nm == "Capricorn" -%}{%- assign fa_nm = "Genesis Capricorn" -%}{%- endif -%}<a class="card" href="{{ p.url }}"><img src="{{ fa_im | image_url: width: 300 }}" alt="{{ p.title | escape }}" loading="lazy" decoding="async" width="300" height="300"><span class="n">{{ fa_nm | escape }}</span><span class="p">{{ p.price | money }}</span></a>{%- endif -%}{%- endunless -%}{%- endif -%}{%- endfor -%}{%- endcapture -%}{%- if fa_n > 0 -%}<h3>Weitere Düfte</h3><div class="grid">{{ fa_cards }}</div>{%- endif -%}</div></div></section>
<footer class="foot"><a href="{{ routes.root_url }}">BLACK ELIXIR</a> · Maison de Parfum</footer>
{% endcase %}
<script>var T={};T[{{ fa_l | json }}]={};
var CFG={lang:{{ fa_l | json }},base:{{ fa_shop | json }},lurl:{},ssr:1,img:function(){return ""},prd:[]};
/* French Avenue – Une avenue, huit adresses. Erwartet: T, LANGS, CFG {lang, base, img(key,mobile), lurl|null, prd:[[handle,name,price,thumb]], mark, ssr} */
(function(){
var CH=[["haydan",3,"Manège","An Equestrian Series Haydan","french-avenue-an-equestrian-series-haydan-eau-de-parfum"],["meringue",7,"Salon de thé","Meringue","french-avenue-meringue-eau-de-parfum"],["paradise",12,"Jardin d'hiver","Sweet Paradise","french-avenue-sweet-paradise-eau-de-parfum"],["pierce",21,"Sellerie","An Equestrian Series Pierce","french-avenue-an-equestrian-series-pierce-eau-de-parfum"],["pinnace",33,"Atelier naval","Pinnace Noir","french-avenue-pinnace-noir-eau-de-parfum"],["taurus",40,"Observatoire","Genesis Taurus","french-avenue-genesis-taurus-eau-de-parfum"],["aries",52,"Sur les toits","Genesis Aries","french-avenue-genesis-aries-eau-de-parfum"],["royal",88,"Club privé","Royal Blend","french-avenue-royal-blend-edp"]];
var PRICE={};CFG.prd.forEach(function(p){PRICE[p[0]]=p});
var mq=matchMedia('(max-width:1000px),(orientation:portrait)');
var lang=T[CFG.lang]?CFG.lang:'de',t;
function eur(v){var s=v.toFixed(2);return lang==='en'?'€'+s:s.replace('.',',')+' €'}
function $(id){return document.getElementById(id)}
function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;')}
function group(n){return /genesis|capricorn/i.test(n)?0:/equestrian/i.test(n)?1:/royal blend/i.test(n)?2:3}

function render(){
  t=T[lang];
  if(!CFG.ssr){
    var root=document.documentElement;root.lang=lang;root.dir=(lang==='ar'||lang==='he')?'rtl':'ltr';
    document.title=t.title;
    $('h1').textContent=t.h1;$('intro').textContent=t.intro;$('cue').textContent=t.cue;$('shopH').textContent=t.shopH;
    $('langs').innerHTML=LANGS.map(function(l){return '<a href="#" lang="'+l[0]+'" data-l="'+l[0]+'"'+(l[0]===lang?' aria-current="true"':'')+'>'+l[1]+'</a>'}).join('');
    $('street').setAttribute('aria-label',t.nav);
    $('street').innerHTML=CH.map(function(c,i){return '<a href="#n'+(i+1)+'">'+c[1]+'</a>'}).join('');
    $('chapters').innerHTML=CH.map(function(c,i){
      var p=CFG.mark?null:PRICE[c[4]];
      var pr=CFG.mark?'[[P:'+c[4]+']]':(p?eur(p[2]):''),href=CFG.mark?'[[U:'+c[4]+']]':CFG.base+c[4];
      return '<section class="ch" id="n'+(i+1)+'"><div class="stage"><picture><source media="(max-width:760px)" srcset="'+CFG.img(c[0],1)+'"><img src="'+CFG.img(c[0],0)+'" alt="French Avenue '+esc(c[3])+' – '+esc(t.t[i])+'" width="1800" height="1195"'+(i?' fetchpriority="low"':'')+'></picture><div class="veil"></div>'+
        '<div class="txt"><div class="plate" aria-label="N° '+c[1]+'"><span>N° '+c[1]+'</span></div><div class="place" lang="fr">'+c[2]+'</div><div class="time">'+t.t[i]+'</div>'+
        '<p class="mean fade">'+t.m[i]+'</p><div class="prod fade"><b>French Avenue '+c[3]+'</b><span class="pr">'+pr+'</span></div><a class="btn fade" href="'+href+'">'+t.btn+'</a></div></div></section>';
    }).join('');
    var names=['Genesis','An Equestrian Series','Royal Blend',t.more],gs=[[],[],[],[]];
    CFG.prd.forEach(function(p){gs[group(p[1])].push(p)});
    $('groups').innerHTML=gs.map(function(it,gi){if(!it.length)return '';
      return '<h3>'+names[gi]+'</h3><div class="grid">'+it.map(function(p){return '<a class="card" href="'+CFG.base+p[0]+'"><img src="'+p[3]+'" alt="French Avenue '+esc(p[1])+'" loading="lazy" decoding="async" width="300" height="300"><span class="n">'+esc(p[1])+'</span><span class="p">'+eur(p[2])+'</span></a>'}).join('')+'</div>';
    }).join('');
  }
  secs=[].slice.call(document.querySelectorAll('.ch'));tick();
}
var secs=[];
function tick(){
  var vh=innerHeight,cur=-1,sh=$('shop').getBoundingClientRect();
  document.querySelector('.top').classList.toggle('day',sh.top<60&&sh.bottom>60);
  secs.forEach(function(s,i){
    var r=s.getBoundingClientRect();
    if(r.top<vh*.55&&r.bottom>vh*.45)cur=i;
    s.classList.toggle('on',mq.matches?r.top<vh*.8:(r.top<vh*.2&&r.bottom>vh*.5));
  });
  var st=$('street');st.classList.toggle('show',cur>-1);
  [].forEach.call(st.children,function(a,i){if(i===cur)a.setAttribute('aria-current','true');else a.removeAttribute('aria-current')});
}
addEventListener('scroll',function(){requestAnimationFrame(tick)},{passive:true});
addEventListener('resize',tick);
if(!CFG.lurl)$('langs').addEventListener('click',function(e){var a=e.target.closest('a');if(!a)return;e.preventDefault();lang=a.dataset.l;render();});
render();
})();
</script>
</body>
</html>
{%- endpaginate -%}
