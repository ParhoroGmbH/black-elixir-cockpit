<style>
:root{
  --ink:#15130f; --ink2:#1d1a15; --sand:#efe4cf; --sand2:#b9ab92; --henna:#c98a3c; --line:rgba(239,228,207,.16);
  --paper:#f6efe2; --paper-ink:#2a2219;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--ink);color:var(--sand);font:300 17px/1.6 Spectral,Georgia,serif;-webkit-font-smoothing:antialiased}
html[lang=ar] body{font-family:Amiri,"Noto Naskh Arabic",serif}
html[lang=he] body{font-family:"Frank Ruhl Libre",serif}
[dir=rtl] .txt{direction:rtl}
a{color:inherit}
.top{position:fixed;inset:0 0 auto 0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:calc(14px + env(safe-area-inset-top,0px)) 20px 14px;background:linear-gradient(var(--ink),rgba(21,19,15,0));pointer-events:none}
.top a{pointer-events:auto;text-decoration:none;letter-spacing:.18em;font-size:12px;font-weight:600}
.top .dot{font-size:13px;color:var(--sand2);letter-spacing:.04em}
.brand{display:flex;align-items:center;gap:18px;flex-wrap:wrap;pointer-events:auto}
.langs{display:flex;gap:2px}
.langs a{padding:8px 6px;font-size:11px!important;letter-spacing:.1em!important;color:var(--sand2);font-weight:400!important;border-bottom:1px solid transparent}
.langs a[aria-current]{color:var(--sand);border-bottom-color:var(--henna)}
.langs a[lang=ar],.langs a[lang=he]{letter-spacing:0!important;font-size:13px!important;font-family:Amiri,"Frank Ruhl Libre",serif}
.top{transition:background .3s,color .3s}
.top.day{background:linear-gradient(rgba(246,239,226,.96),rgba(246,239,226,0));color:var(--paper-ink)}
.top.day .dot,.top.day .langs a{color:#7a6a55}.top.day .langs a[aria-current]{color:var(--paper-ink)}

/* hero */
.hero{min-height:88vh;display:grid;place-items:center;text-align:center;padding:120px 20px 60px;position:relative;overflow:hidden}
.hero svg{width:min(600px,90vw);height:auto;overflow:visible}
.hero h1{font-weight:300;font-size:clamp(28px,4.4vw,46px);margin:.2em 0 .1em;letter-spacing:.01em}
.hero p{max-width:34em;margin:.6em auto 0;color:var(--sand2)}
.hero .cue{margin-top:44px;font-size:13px;color:var(--sand2);letter-spacing:.06em}
.ink{font-family:"Noto Nastaliq Urdu",serif;font-weight:700;fill:url(#gold);fill-opacity:0;stroke:#e2b766;stroke-width:1;stroke-dasharray:2600;stroke-dashoffset:2600;paint-order:stroke;filter:drop-shadow(0 2px 10px rgba(201,138,60,.25))}
.hero .ink,.ink.go{animation:write 3.4s cubic-bezier(.6,.1,.3,1) .2s forwards}
@keyframes write{75%{fill-opacity:0}100%{stroke-dashoffset:0;fill-opacity:1}}

/* chapters */
.ch{position:relative;height:230vh}
.stage{position:sticky;top:0;height:100vh;overflow:hidden}
.stage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.stage .veil{position:absolute;inset:0;background:linear-gradient(90deg,rgba(21,19,15,.9) 0%,rgba(21,19,15,.62) 34%,rgba(21,19,15,0) 62%)}
.txt{position:absolute;left:clamp(20px,6vw,90px);top:50%;transform:translateY(-50%);width:min(430px,40vw)}
.time{font-size:13px;letter-spacing:.08em;color:var(--sand2)}
.word{display:block;width:100%;height:auto;overflow:visible;margin:4px 0 6px}
.trans{font-style:italic;font-size:20px;color:var(--sand)}
.mean{margin:.5em 0 1.1em;font-size:19px;line-height:1.5}
.prod{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:14px}
.prod b{font-weight:600}
.prod .pr{color:var(--sand2);font-variant-numeric:tabular-nums}
.btn{display:inline-block;margin-top:14px;padding:11px 20px;border:1px solid var(--henna);color:var(--sand);text-decoration:none;font-size:15px;transition:background .2s}
.btn:hover,.btn:focus-visible{background:var(--henna);color:var(--ink)}
.fade{opacity:0;transform:translateY(8px);transition:opacity .6s,transform .6s}
.on .fade{opacity:1;transform:none}

/* name writer */
.namer{background:var(--ink2);padding:110px 20px;text-align:center;border-top:1px solid var(--line)}
.namer h2,.shop h2{font-weight:300;font-size:clamp(26px,3.6vw,38px);margin:0 0 .3em}
.namer p{color:var(--sand2);max-width:34em;margin:0 auto}
.namer form{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:28px 0 10px}
.namer label{position:absolute;left:-9999px}
.namer input{font:inherit;font-size:18px;padding:11px 14px;background:transparent;border:1px solid var(--line);color:var(--sand);width:min(300px,100%)}
.namer input:focus{outline:2px solid var(--henna);outline-offset:2px}
.namer button{font:inherit;font-size:15px;padding:11px 20px;background:var(--henna);color:var(--ink);border:0;cursor:pointer}
#nameSvg{width:min(640px,92vw);height:auto;margin:20px auto 0;display:block;overflow:visible}
.hint{font-size:14px;color:var(--sand2)}
#save{background:transparent;color:var(--sand);border:1px solid var(--henna)}

/* shop */
.shop{background:var(--paper);color:var(--paper-ink);padding:90px 20px 100px}
.shop .in{max-width:1180px;margin:0 auto}
.shop h3{font-weight:400;font-size:22px;margin:56px 0 18px;padding-bottom:10px;border-bottom:1px solid rgba(42,34,25,.18)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:28px 22px}
.card{text-decoration:none;display:block}
.card img{width:100%;aspect-ratio:1;display:block;mix-blend-mode:multiply;transition:transform .35s}
.card:hover img{transform:translateY(-4px)}
.card .n{display:block;margin-top:8px;font-size:16px;line-height:1.3}
.card .p{display:block;font-size:15px;color:#7a6a55;font-variant-numeric:tabular-nums}
.foot{padding:50px 20px;text-align:center;font-size:14px;color:var(--sand2)}
.foot a{color:var(--sand);letter-spacing:.14em;font-weight:600;text-decoration:none}

@media (max-width:1000px),(orientation:portrait){
  .top .dot{display:none}
  .ch{height:auto}
  .stage{position:relative;height:auto;overflow:visible}
  .stage img{position:relative;height:auto;aspect-ratio:3/2;object-fit:contain}
  .stage .veil{display:none}
  .txt{position:relative;left:auto;top:auto;transform:none;width:auto;padding:22px 20px 64px}
  .fade{opacity:1;transform:none}
}
@media (prefers-reduced-motion:reduce){
  .hero .ink-stroke{animation:none;stroke-dashoffset:0;fill:var(--henna)}
  .fade{opacity:1;transform:none;transition:none}
}
</style>
<style>/* Handy: kleinere Produktbilder, 3 Spalten (21.11.2026) */.card img{height:auto!important;object-fit:contain}@media (max-width:600px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:18px 10px!important}.card .n{font-size:12.5px!important}.card .p{font-size:12px!important}}</style>
</head>
<body>
{% case lt_l %}{% when "en" %}<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><linearGradient id="gold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f3d896"></stop><stop offset=".55" stop-color="#cf9442"></stop><stop offset="1" stop-color="#8f5a22"></stop></linearGradient></defs></svg>
<header class="top"><div class="brand"><a href="{{ routes.root_url }}">BLACK ELIXIR</a><nav class="langs" id="langs" aria-label="Sprache">{%- for l in localization.available_languages -%}{%- assign lc = l.iso_code | slice: 0, 2 -%}{%- assign lr = l.root_url -%}{%- if lr == "/" -%}{%- assign lr = "" -%}{%- endif -%}<a href="{{ lr }}{{ page.url }}" lang="{{ lc }}" hreflang="{{ lc }}"{% if lc == lt_l %} aria-current="true"{% endif %}>{% case lc %}{% when "de" %}DE{% when "en" %}EN{% when "fr" %}FR{% when "it" %}IT{% when "da" %}DA{% when "ar" %}عربي{% when "he" %}עברית{% else %}{{ lc | upcase }}{% endcase %}</a>{%- endfor -%}</nav></div><span class="dot">Maison de Parfum</span></header>
<section class="hero"><div>
<svg viewBox="0 0 600 300" role="img" aria-label="لطافة"><text class="ink" x="300" y="200" text-anchor="middle" direction="rtl" font-size="170">لطافة</text></svg>
<h1 id="h1">Lattafa – what the name reveals</h1><p id="intro">Almost every Lattafa fragrance carries an Arabic word as its name. We translated eight of them and took them to the places they speak of – from dawn until deep into the night.</p><div class="cue" id="cue">Lattāfa · grace, delicacy</div>
</div></section>
<main id="chapters"><section class="ch"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['lt-s-qahwa.jpg'] | image_url: width: 900 }}"><img src="{{ images['lt-s-qahwa.jpg'] | image_url: width: 1800 }}" alt="Lattafa Khamrah Qahwa – Dawn · Bedouin tent" width="1800" height="1195"></picture><div class="veil"></div><div class="txt"><div class="time">Dawn · Bedouin tent</div><svg class="word" viewBox="0 0 430 250" role="img" aria-label="قهوة"><text class="ink" x="6" y="185" text-anchor="end" direction="rtl" font-size="150" style="">قهوة</text></svg><div class="trans fade">Qahwa</div><p class="mean fade">Coffee. In the tent it is poured from the dallah before the sun rises over the dunes.</p><div class="prod fade"><b>Lattafa Khamrah Qahwa</b><span class="pr">{{ all_products['lattafa-khamrah-qahwa-eau-de'].price | money }}</span></div><a class="btn fade" href="{{ lt_shop }}lattafa-khamrah-qahwa-eau-de">View fragrance</a></div></div></section><section class="ch"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['lt-s-yara.jpg'] | image_url: width: 900 }}"><img src="{{ images['lt-s-yara.jpg'] | image_url: width: 1800 }}" alt="Lattafa Yara Tous – Morning · a girl's room" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="time">Morning · a girl's room</div><svg class="word" viewBox="0 0 430 250" role="img" aria-label="يارا"><text class="ink" x="6" y="185" text-anchor="end" direction="rtl" font-size="150">يارا</text></svg><div class="trans fade">Yara</div><p class="mean fade">An Arabic girl's name. It reveals nothing more – the light through the mashrabiya tells the rest.</p><div class="prod fade"><b>Lattafa Yara Tous</b><span class="pr">{{ all_products['lattafa-yara-tous-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ lt_shop }}lattafa-yara-tous-eau-de-parfum">View fragrance</a></div></div></section><section class="ch"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['lt-s-abiyedh.jpg'] | image_url: width: 900 }}"><img src="{{ images['lt-s-abiyedh.jpg'] | image_url: width: 1800 }}" alt="Lattafa Ana Abiyedh Scarlet – Noon · salt flat" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="time">Noon · salt flat</div><svg class="word" viewBox="0 0 430 250" role="img" aria-label="أنا الأبيض"><text class="ink" x="6" y="185" text-anchor="end" direction="rtl" font-size="96">أنا الأبيض</text></svg><div class="trans fade">Ana al-Abyaḍ</div><p class="mean fade">“I am the white one.” A name that says white – and a bottle in scarlet.</p><div class="prod fade"><b>Lattafa Ana Abiyedh Scarlet</b><span class="pr">{{ all_products['lattafa-ana-abiyedh-scarlet'].price | money }}</span></div><a class="btn fade" href="{{ lt_shop }}lattafa-ana-abiyedh-scarlet">View fragrance</a></div></div></section><section class="ch"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['lt-s-areeq.jpg'] | image_url: width: 900 }}"><img src="{{ images['lt-s-areeq.jpg'] | image_url: width: 1800 }}" alt="Lattafa Pride Al Areeq Gold – Afternoon · a liwan in Damascus" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="time">Afternoon · a liwan in Damascus</div><svg class="word" viewBox="0 0 430 250" role="img" aria-label="العريق"><text class="ink" x="6" y="185" text-anchor="end" direction="rtl" font-size="120">العريق</text></svg><div class="trans fade">al-ʿArīq</div><p class="mean fade">The time-honoured, the deeply rooted. Like a Damascene house that carries its history in wood and stone.</p><div class="prod fade"><b>Lattafa Pride Al Areeq Gold</b><span class="pr">{{ all_products['lattafa-pride-al-areeq-gold-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ lt_shop }}lattafa-pride-al-areeq-gold-eau-de-parfum">View fragrance</a></div></div></section><section class="ch"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['lt-s-stone.jpg'] | image_url: width: 900 }}"><img src="{{ images['lt-s-stone.jpg'] | image_url: width: 1800 }}" alt="Lattafa Niche Emarati Classic Stone – Late afternoon · Al Fahidi, Dubai" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="time">Late afternoon · Al Fahidi, Dubai</div><svg class="word" viewBox="0 0 430 250" role="img" aria-label="حجر"><text class="ink" x="6" y="185" text-anchor="end" direction="rtl" font-size="150">حجر</text></svg><div class="trans fade">Ḥajar</div><p class="mean fade">Stone. The old houses of the Al Fahidi quarter were built from coral stone – with wind towers above.</p><div class="prod fade"><b>Lattafa Niche Emarati Classic Stone</b><span class="pr">{{ all_products['lattafa-niche-emirati-classic-stone-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ lt_shop }}lattafa-niche-emirati-classic-stone-eau-de-parfum">View fragrance</a></div></div></section><section class="ch"><div class="stage"><picture><source media="(max-width:760px)" srcset="{{ images['lt-s-khamrah.jpg'] | image_url: width: 900 }}"><img src="{{ images['lt-s-khamrah.jpg'] | image_url: width: 1800 }}" alt="Lattafa Khamrah – Evening · majlis" width="1800" height="1195" fetchpriority="low"></picture><div class="veil"></div><div class="txt"><div class="time">Evening · majlis</div><svg class="word" viewBox="0 0 430 250" role="img" aria-label="خمرة"><text class="ink" x="6" y="185" text-anchor="end" direction="rtl" font-size="150">خمرة</text></svg><div class="trans fade">Khamra</div><p class="mean fade">The intoxicating. A word for everything that warms the senses and makes them heavy.</p><div class="prod fade"><b>Lattafa Khamrah</b><span class="pr">{{ all_products['lattafa-khamrah-eau-de-parfum'].price | money }}</span></div><a class="btn fade" href="{{ lt_shop }}lattafa-khamrah-eau-de-