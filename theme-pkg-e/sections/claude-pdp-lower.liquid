.cpl-row__l{margin:0 0 10px;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--cp-mut)}
.cpl-row__g{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.cpl-row a{display:block;color:inherit;text-decoration:none}
.cpl-row__i{display:block;aspect-ratio:1/1;background:#fff;border:1px solid rgba(20,20,20,.08);overflow:hidden}
.cpl-row__i img{display:block;width:100%;height:100%;object-fit:contain;transition:translate .45s cubic-bezier(.2,.7,.2,1)}
.cpl-row a:hover .cpl-row__i img{translate:0 -4px}
.cpl-row__t{display:block;margin-top:6px;font-size:11.5px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

/* ---------- 6) Joy „Merken“ als Herz am Titel ---------- */
.main-product .product__info-container > .app:has(.Joy-Wishlist-ButtonWrapper){float:inline-end;width:46px;height:46px;margin:0 0 6px 12px!important;position:relative;z-index:2}
[dir="rtl"] .main-product .product__info-container > .app:has(.Joy-Wishlist-ButtonWrapper){margin:0 12px 6px 0!important}
.main-product .product__info-container > .app:has(.Joy-Wishlist-ButtonWrapper) + .product__text{margin-top:6px!important}

@media (max-width:989px){
  .cpl-film{padding:48px 20px 40px}
  .cpl-film__body{grid-template-columns:minmax(0,1fr);gap:24px}
  .cpl-film__stage{max-height:none;width:min(100%,460px)}
  [id$="__0813214f-270c-458a-98a9-8ebcbac0fda8"] .media-with-text{padding:48px 20px!important}
  [id$="__0813214f-270c-458a-98a9-8ebcbac0fda8"] .media-with-text__card{gap:28px}
}
@media (max-width:599px){
  .cpl-steps{grid-template-columns:minmax(0,1fr);gap:12px}
  .cpl-steps li{flex-direction:row;align-items:center}
  .cpl-row__g{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cpl-stage{padding:14px}
  [id$="__5f396e91-f049-4d30-969d-0a6f7dcde2b9"] .banner__wrapper{min-height:520px!important}
  [id$="__5f396e91-f049-4d30-969d-0a6f7dcde2b9"] .banner__media::after{background:linear-gradient(0deg,rgba(8,7,6,.88) 0%,rgba(8,7,6,.4) 55%,rgba(8,7,6,.1) 100%)}
  [id$="__5f396e91-f049-4d30-969d-0a6f7dcde2b9"] .banner__content{justify-content:flex-end}
}
@media (prefers-reduced-motion:reduce){.cpl-in{opacity:1;translate:none;transition:none}.cpl-film__stage img{transition:none}}
</style>

<script>
(function(){
var init=function(){
  var T={prev:{{ t_prev | json }},next:{{ t_next | json }},to:{{ t_to | json }},fe:{{ t_film_e | json }},fh:{{ t_film_h | json }},s:[{{ t_s1 | json }},{{ t_s2 | json }},{{ t_s3 | json }}],more:{{ t_more | json }}};
  var RM=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;
  var sec=function(k){return document.querySelector('.shopify-section[id$="__'+k+'"]')};
  var near=function(el,fn,m){if(!el)return;if(!('IntersectionObserver' in window)){fn();return}var io=new IntersectionObserver(function(e){if(e[0].isIntersecting){io.disconnect();fn()}},{rootMargin:m||'600px 0px'});io.observe(el)};
  var reveal=function(el){if(!el||RM)return;el.classList.add('cpl-in');near(el,function(){el.classList.add('is-in')},'-10% 0px')};
  var arrow='<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5"/></svg>';
  var arrowR='<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5"/></svg>';

  /* 2) Filmstreifen */
  var sm=sec('shoppable_media_slider_Rfk6c8');
  if(sm){near(sm,function(){try{
    var slides=[].slice.call(sm.querySelectorAll('li.swiper-slide:not(.swiper-slide-duplicate)'));if(slides.length<2)return;
    var box=document.createElement('div');box.className='cpl-film';box.setAttribute('role','region');box.setAttribute('aria-roledescription','carousel');box.setAttribute('aria-label',T.fh);
    box.innerHTML='<div class="cpl-film__head"><p class="cpd-eyebrow">'+T.fe+'</p><h2 class="cpd-h">'+T.fh+'</h2></div><div class="cpl-film__body"><div class="cpl-film__stage" aria-live="polite"></div><div class="cpl-film__side"><div class="cpl-film__count" aria-hidden="true"></div><div class="cpl-film__caps"></div><div class="cpl-film__nav"><button type="button" class="cpl-film__btn" data-d="-1" aria-label="'+T.prev+'">'+arrow+'</button><button type="button" class="cpl-film__btn" data-d="1" aria-label="'+T.next+'">'+arrowR+'</button><a class="cpl-film__to" href="#">'+T.to+'</a></div><div class="cpl-film__thumbs" role="tablist"></div></div></div>';
    var stage=box.querySelector('.cpl-film__stage'),caps=box.querySelector('.cpl-film__caps'),th=box.querySelector('.cpl-film__thumbs'),cnt=box.querySelector('.cpl-film__count'),to=box.querySelector('.cpl-film__to');
    var items=[];
    slides.forEach(function(li,i){
      var im=li.querySelector('.shoppable-media-slider__media');var cap=li.querySelector('.product-slide-caption');if(!im||!cap)return;
      var src=(im.currentSrc||im.src).replace(/([?&])width=\d+/,'$1width=1100');
      var big=document.createElement('img');big.alt=(cap.querySelector('.card__title-text')||{}).textContent?cap.querySelector('.card__title-text').textContent.trim():'';big.loading='lazy';big.decoding='async';big.width=im.getAttribute('width')||1696;big.height=im.getAttribute('height')||2528;big.dataset.src=src;stage.appendChild(big);
      caps.appendChild(cap);
      var b=document.createElement('button');b.type='button';b.className='cpl-film__thumb';b.setAttribute('role','tab');b.setAttribute('aria-label',(i+1)+' / '+slides.length+(big.alt?' – '+big.alt:''));
      b.innerHTML='<img alt="" loading="lazy" decoding="async" width="64" height="86" src="'+src.replace(/([?&])width=\d+/,'$1width=180')+'">';th.appendChild(b);
      items.push({big:big,cap:cap,b:b,href:cap.getAttribute('href')});
    });
    if(items.length<2)return;
    var cur=-1,show=function(n){n=(n+items.length)%items.length;if(n===cur)return;var it=items[n];if(!it.big.src)it.big.src=it.big.dataset.src;var nx=items[(n+1)%items.length].big;if(!nx.src)nx.src=nx.dataset.src;
      items.forEach(function(x,i){x.big.classList.toggle('is-on',i===n);x.cap.classList.toggle('is-on',i===n);x.b.setAttribute('aria-current',i===n?'true':'false');x.b.tabIndex=i===n?0:-1});
      cnt.textContent=String(n+1).padStart(2,'0')+' / '+String(items.length).padStart(2,'0');to.href=it.href;cur=n;
      var tb=it.b;th.scrollTo({left:tb.offsetLeft-th.clientWidth/2+tb.offsetWidth/2,behavior:RM?'auto':'smooth'})};
    box.addEventListener('click',function(e){var d=e.target.closest('[data-d]');if(d){show(cur+(+d.dataset.d));return}var t=e.target.closest('.cpl-film__thumb');if(t)show(items.findIndex(function(x){return x.b===t}))});
    th.addEventListener('keydown',function(e){var k=e.key;var rtl=document.dir==='rtl';if(k==='ArrowRight'||k==='ArrowLeft'){e.preventDefault();show(cur+((k==='ArrowRight')!==rtl?1:-1));items[cur].b.focus()}});
    var x0=null;stage.addEventListener('pointerdown',function(e){x0=e.clientX});stage.addEventListener('pointerup',function(e){if(x0===null)return;var dx=e.clientX-x0;x0=null;if(Math.abs(dx)>40)show(cur+((dx<0)!==(document.dir==='rtl')?1:-1))});
    stage.style.touchAction='pan-y';
    var host=sm.querySelector('.shoppable-media-slider-section__container')||sm;host.appendChild(box);sm.classList.add('cpl-film-on');show(0);reveal(box.querySelector('.cpl-film__body'));
  }catch(e){}});}

  /* 3) Unboxing: Punkte + Parallaxe */
  var pk=sec('0813214f-270c-458a-98a9-8ebcbac0fda8');
  if(pk){var cw=pk.querySelector('.media-with-text__content-wrapper');
    if(cw&&!cw.querySelector('.cpl-steps')){var ic=['<path d="M3 8l9-4.5L21 8v8l-9 4.5L3 16z"/><path d="M3 8l9 4.5L21 8M12 12.5v8"/>','<path d="M4 6h16M4 12h10M4 18h7"/>','<path d="M3 12h18"/><path d="M8 9h8v6H8z"/>'];
      var ul=document.createElement('ul');ul.className='cpl-steps';ul.setAttribute('role','list');
      ul.innerHTML=T.s.map(function(s,i){return '<li><svg viewBox="0 0 24 24" aria-hidden="true">'+ic[i]+'</svg><span>'+s+'</span></li>'}).join('');cw.appendChild(ul)}
    reveal(pk.querySelector('.media-with-text__card'));
    var img=pk.querySelector('.media-with-text__image');
    if(img&&!RM){var tk=0,on=false;var upd=function(){tk=0;var r=pk.getBoundingClientRect(),h=innerHeight;var p=((r.top+r.height/2)-h/2)/(h/2+r.height/2);p=Math.max(-1,Math.min(1,p));img.style.translate='0 '+(p*-18).toFixed(1)+'px'};
      if('IntersectionObserver' in window)new IntersectionObserver(function(e){on=e[0].isIntersecting;if(on)upd()}).observe(pk);
      addEventListener('scroll',function(){if(on&&!tk)tk=requestAnimationFrame(upd)},{passive:true})}}

  /* 4) Markenvideo: nur sichtbar abspielen */
  var vb=sec('5f396e91-f049-4d30-969d-0a6f7dcde2b9');
  if(vb){var v=vb.querySelector('.banner__media video');reveal(vb.querySelector('.banner__content-wrapper'));
    if(v&&'IntersectionObserver' in window){v.muted=true;new IntersectionObserver(function(e){if(e[0].isIntersecting&&!RM){var p=v.play();if(p&&p.catch)p.catch(function(){})}else{v.pause()}},{threshold:.25}).observe(v)}}

  /* 5) Kollektions-Bühne: 4 Produkte je Kollektion (öffentliche Kollektions-JSON, erst bei Annäherung) */
  var fc=sec('4e58a0ea-60de-47bd-bed6-2f45f4e0323e');
  if(fc){near(fc,function(){var root=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';
    [].slice.call(fc.querySelectorAll('a.card-collection')).forEach(function(a){
      var w=document.createElement('div');w.className='cpl-stage';a.parentNode.insertBefore(w,a);w.appendChild(a);reveal(w);
      var m=(a.getAttribute('href')||'').match(/\/collections\/([^/?#]+)/);if(!m)return;
      fetch(root+'collections/'+m[1]+'/products.json?limit=12').then(function(r){return r.ok?r.json():null}).then(function(d){
        if(!d||!d.products)return;var ps=d.products.filter(function(p){return p.images&&p.images.length&&p.variants&&p.variants.some(function(v){return v.available})}).slice(0,4);if(ps.length<2)return;
        var row=document.createElement('div');row.className='cpl-row';
        row.innerHTML='<p class="cpl-row__l">'+T.more+'</p><div class="cpl-row__g">'+ps.map(function(p){var s=p.images[0].src;s+=(s.indexOf('?')>-1?'&':'?')+'width=300';var t=String(p.title).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]});
          return '<a href="'+root+'products/'+p.handle+'"><span class="cpl-row__i"><img src="'+s+'" alt="'+t+'" loading="lazy" decoding="async" width="300" height="300"></span><span class="cpl-row__t">'+t+'</span></a>'}).join('')+'</div>';
        w.appendChild(row)}).catch(function(){});
    })},'400px 0px')}

  /* 1) Empfehlungen: ruhiges Einblenden */
  reveal(sec('afaa1caf-6b34-4fbe-aa72-e50883d86941'));

  /* 6) Joy-Herz: Text ausblenden, rund, Gold (nur Stil im Shadow DOM, Logik bleibt bei Joy) */
  var CSS='.Joy-Wishlist__Button{width:46px!important;min-width:46px!important;height:46px!important;padding:0!important;border-radius:50%!important;border:1px solid rgba(200,164,92,.7)!important;background:rgba(255,255,255,.9)!important;justify-content:center!important;gap:0!important;transition:background-color .25s,border-color .25s!important}.Joy-Wishlist__Button:hover{background:#141414!important;border-color:#141414!important}.Joy-Wishlist__Button:hover svg path{stroke:#fff!important}.Joy-Wishlist-WishlistButton__Text{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;white-space:nowrap!important}.Joy-Wishlist-WishlistButton__Icon{margin:0!important}.Joy-Wishlist-WishlistButton__Icon svg{width:20px!important;height:20px!important}';
  var styleJoy=function(){[].slice.call(document.querySelectorAll('.product__info-container joy-wishlist-button')).forEach(function(b){var sr=b.shadowRoot;if(sr&&!sr.querySelector('#cpl-joy')){var s=document.createElement('style');s.id='cpl-joy';s.textContent=CSS;sr.appendChild(s)}})};
  var jw=document.querySelector('.product__info-container .Joy-Wishlist-ButtonWrapper');
  var burst=function(){var n=0,iv=setInterval(function(){styleJoy();if(++n>12)clearInterval(iv)},250)};
  if(jw){styleJoy();if('MutationObserver' in window)new MutationObserver(burst).observe(jw,{childList:true,subtree:true});burst()}
};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>

