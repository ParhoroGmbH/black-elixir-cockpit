{%- comment -%}
  Claude Paket E 12.11.2026 – Produktseite: "Häufige Fragen" zu Bestellung und Versand (nur vorhandene Shop-Fakten):
    Lieferzeit  -> CEO 12.11.2026 "1–3 Werktage" (DE) + /policies/shipping-policy (Ausland 5–9 Werktage, keine Zustellung an Sonn-/Feiertagen)
    Versand     -> /policies/shipping-policy (DE ohne Versandkosten, Ausland nach Lieferland im Bestellprozess)
    Rückgabe    -> /pages/ruckerstattungsrichtlinie + /policies/refund-policy (14 Tage, Rücksendekosten, Siegel)
    Geschenk    -> locales claude.gl.s1_html (ab 59 € / ab 99 €, bis 31.12.2026) – nur im Aktionsfenster wie be-seife-hint
    Zahlung     -> /policies/shipping-policy "Akzeptierte Zahlungsmöglichkeiten" (Wortlaut wie snippets/be-faq.liquid)
    Service     -> /pages/contact
  Steht direkt NACH der Sektion be-faq (produktbezogene Avada-FAQ). Gibt be-faq bereits FAQPage-JSON-LD aus, kommt hier KEIN
  zweites; sonst liefert diese Sektion das JSON-LD. Partner-Artikel (Shopify Collective): keine Lieferzeit-/Gratisversand-Aussage.
{%- endcomment -%}
{%- liquid
  assign cpf_be = false
  assign cpf_m = product.metafields.faqs.settings.value
  if request.locale.primary == false
    assign cpf_lk = 'settings_' | append: request.locale.iso_code
    assign cpf_ml = product.metafields.faqs[cpf_lk].value
    if cpf_ml.questions.size > 0
      assign cpf_m = cpf_ml
    endif
  endif
  if cpf_m.questions.size > 0
    assign cpf_st = cpf_m.status | append: ''
    assign cpf_ab = cpf_m.isAppBlockInUse | append: ''
    if cpf_st == 'true' and cpf_ab == 'true'
      assign cpf_be = true
    endif
  endif
  assign cpf_partner = false
  if product.tags contains 'Shopify Collective'
    assign cpf_partner = true
  endif
  assign cpf_now = 'now' | date: '%s' | plus: 0
  assign cpf_keys = 'time,cost,return,gift,pay,help'
  if cpf_partner
    assign cpf_keys = cpf_keys | remove: 'time,cost,'
  endif
  if cpf_now > 1798757999 or product.gift_card?
    assign cpf_keys = cpf_keys | remove: 'gift,'
  endif
  if product.gift_card?
    assign cpf_keys = 'pay,help'
  endif
  assign cpf_keys = cpf_keys | split: ','
-%}
<div class="cpd cpd-faq page-width page-width--{{ settings.max_page_width }} section-padding--{{ settings.white_space }}">
  {%- if cpf_be -%}
    <p class="cpd-eyebrow">{%- render 'claude-pdp-t', k: 'faq_sub' -%}</p>
  {%- else -%}
    <p class="cpd-eyebrow">{%- render 'claude-pdp-t', k: 'faq_sub' -%}</p>
    <h2 class="cpd-h">{%- render 'claude-pdp-t', k: 'faq_h' -%}</h2>
  {%- endif -%}
  <div class="cpd-acc cpd-faq__list" data-cpd-faq>
    {%- for cpf_k in cpf_keys -%}
      {%- assign cpf_q = 'q_' | append: cpf_k -%}
      {%- assign cpf_a = 'a_' | append: cpf_k -%}
      <details class="cpd-acc__item" name="cpd-faq-{{ section.id }}">
        <summary><span>{%- render 'claude-pdp-t', k: cpf_q -%}</span><i aria-hidden="true"></i></summary>
        <div class="cpd-acc__body richtext">
          {%- if cpf_k == 'gift' -%}
            <p>{{ 'claude.gl.s1_html' | t }} {% render 'claude-pdp-t', k: 'a_gift_more' %}</p>
          {%- else -%}
            {%- render 'claude-pdp-t', k: cpf_a -%}
          {%- endif -%}
        </div>
      </details>
    {%- endfor -%}
  </div>
</div>
{%- unless cpf_be -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{%- for cpf_k in cpf_keys -%}
  {%- assign cpf_q = 'q_' | append: cpf_k -%}
  {%- assign cpf_a = 'a_' | append: cpf_k -%}
  {%- capture cpf_qt -%}{%- render 'claude-pdp-t', k: cpf_q -%}{%- endcapture -%}
  {%- capture cpf_at -%}{%- if cpf_k == 'gift' -%}{{ 'claude.gl.s1_html' | t }} {% render 'claude-pdp-t', k: 'a_gift_more' %}{%- else -%}{%- render 'claude-pdp-t', k: cpf_a -%}{%- endif -%}{%- endcapture -%}
  {%- assign cpf_at = cpf_at | strip_html | replace: '&nbsp;', ' ' | replace: '&amp;', '&' | strip -%}
  {"@type":"Question","name":{{ cpf_qt | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ cpf_at | json }}}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]}
</script>
{%- endunless -%}
<script>
(function(){var r=document.querySelector('[data-cpd-faq]');if(!r)return;
r.addEventListener('toggle',function(e){var d=e.target;if(!d.open)return;[].slice.call(r.querySelectorAll('details[open]')).forEach(function(o){if(o!==d)o.open=false})},true)})();
</script>

{% schema %}
{
  "name": "Claude PDP FAQ",
  "tag": "section",
  "class": "section-claude-pdp-faq",
  "enabled_on": { "templates": ["product"] },
  "settings": [],
  "presets": [ { "name": "Claude PDP FAQ" } ]
}
{% endschema %}
