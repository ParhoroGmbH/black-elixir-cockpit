{%- comment -%} Fragrance Library Landing. Oben die Scroll-Story (snippets/fl-story.liquid: Bibliothek bei Nacht + vier Welten auf Glasflächen), darunter zwei Bücherschränke aus altem Holz ("Extrait de Parfum" = 50 + 100 ml zusammen, "Eau de Parfum"), mehrere Böden übereinander. Ein Klick zieht das Buch heraus und schlägt es auf (snippets/fl-books.liquid: Flakon, Noten, Größe, Preis, Warenkorb). Claude · 12.11.2026 (Paket D).
  Dateien (Inhalte > Dateien): be-fl-holz2-*.jpg (Holz), be-fl-papier.jpg, be-fl-cut-*.webp. Die früheren Regal-Dateien fl-plank/stile/back.jpg und die Einstellungen video/video_url/heading/subheading/hint werden nicht mehr benutzt. {%- endcomment -%}
{%- paginate collection.products by 60 -%}
{%- render 'be-landing-cart' -%}
{%- render 'fl-books' -%}
<style>
.fl-land{--bg:#0b0a09;--fg:#f1eadb;--muted:#a79f8e;--gold:#c9a45c;--line:rgba(201,164,92,.28);--serif:"Cormorant Garamond",Georgia,serif;--sans:system-ui,-apple-system,"Segoe UI",sans-serif;overflow-x:clip;background:var(--bg);color:var(--fg);font-family:var(--sans);-webkit-font-smoothing:antialiased}
.fl-land *{box-sizing:border-box;margin:0}
/* volle Breite: Fläche läuft unter der linken Seitenleiste durch (--fl-sbw), Inhalte halten den Abstand */
.fl-land{width:calc(100% + var(--fl-sbw,0px));margin-left:calc(-1*var(--fl-sbw,0px))}
.main-sidebar,.main-sidebar *{transition:color .4s ease,fill .4s ease}
html.fl-dark .main-sidebar,html.fl-dark .main-sidebar a,html.fl-dark .main-sidebar span,html.fl-dark .main-sidebar button,html.fl-dark .main-sidebar p,html.fl-dark .main-sidebar div{color:#fff!important}
html.fl-dark .main-sidebar svg,html.fl-dark .main-sidebar svg *{fill:#fff!important;color:#fff!important}
.fl-land .eyebrow{font-size:.8rem;letter-spacing:.32em;text-transform:uppercase;color:var(--gold)}
.fl-land h1{font-family:var(--serif);font-weight:400;line-height:1.02;text-wrap:balance;font-size:clamp(2.2rem,6vw,4.5rem);margin:12px 0 20px}
.fl-land .lib{padding:12vh clamp(16px,4vw,64px) 14vh calc(var(--fl-sbw,0px) + clamp(16px,4vw,64px))}
.fl-land .intro{max-width:62ch;font-size:1.05rem;line-height:1.65;color:#d8cfbb;margin:0 0 18px}
.fl-land .intro p{margin:0 0 .6em}
.fl-land .hint{font-size:.9rem;letter-spacing:.04em;color:var(--muted);margin:0 0 8px}
/* Schrank */
.fl-land .cab{--pw:clamp(16px,3.4vw,46px);--bh:300px;position:relative;margin:64px auto 0}
.fl-land .cab+.cab{margin-top:96px}
.fl-land .cab-sims{position:relative;z-index:3;height:clamp(40px,5.4vw,76px);margin:0 -12px;border-radius:2px 2px 0 0;box-shadow:0 12px 18px -6px rgba(0,0,0,.9)}
.fl-land .cab-fries{position:relative;z-index:2;height:clamp(46px,4.6vw,60px);display:grid;place-items:center;box-shadow:0 10px 16px -6px rgba(0,0,0,.85)}
.fl-land .plate{position:relative;padding:7px 26px;max-width:86%;font-family:var(--serif);font-weight:700;font-size:clamp(.74rem,1.2vw,.94rem);letter-spacing:.22em;text-transform:uppercase;text-align:center;color:#221405;background:radial-gradient(circle at 9px 50%,#6b4d1c 0 1.6px,transparent 2.2px),radial-gradient(circle at calc(100% - 9px) 50%,#6b4d1c 0 1.6px,transparent 2.2px),linear-gradient(180deg,#e2cb8e,#b8924a 38%,#8f6a2e 62%,#c6a660);text-shadow:0 1px 0 rgba(255,238,196,.4);border-radius:2px;box-shadow:0 2px 5px rgba(0,0,0,.75),inset 0 1px 0 rgba(255,246,214,.55),inset 0 -1px 0 rgba(70,45,10,.6)}
.fl-land .cab-body{position:relative;padding:0 var(--pw)}
.fl-land .cab-body>.flb-pfosten{position:absolute;top:0;bottom:0;width:var(--pw);z-index:2}
.fl-land .cab-body>.flb-pfosten:first-child{left:0;box-shadow:8px 0 14px -6px rgba(0,0,0,.8)}
.fl-land .cab-body>.flb-pfosten:last-child{right:0;box-shadow:-8px 0 14px -6px rgba(0,0,0,.8)}
.fl-land .sh{position:relative}
/* warmes Licht von oben in jedem Fach */
.fl-land .sh::before{content:"";position:absolute;inset:0 0 34px;background:radial-gradient(ellipse 60% 82% at 50% 0,rgba(255,190,110,.24),rgba(255,180,100,.08) 48%,rgba(255,180,100,0) 76%);pointer-events:none}
.fl-land .row{position:relative;z-index:1;display:flex;justify-content:center;align-items:flex-end;gap:5px;padding:34px 14px 6px;min-height:calc(var(--bh) + 40px)}
/* Boden: helle Oberseite (Bücher stehen darauf), Vorderkante mit Stärke, Schatten nach unten */
.fl-land .brett{position:relative;height:46px;margin-top:-11px}
.fl-land .brett .flb-brett{position:absolute;left:0;right:0;top:0;height:13px;clip-path:polygon(1.1% 0,98.9% 0,100% 100%,0 100%)}
