.fl-land .book{position:relative;flex:0 0 auto;height:var(--bh);width:calc(var(--bh)/3.3);border:0;padding:0;margin:0;background:none;cursor:pointer;touch-action:manipulation;font:inherit;color:#d9b768;display:block;border-radius:2px 2px 0 0}
.fl-land .book::before{content:"";position:absolute;left:-6%;right:-6%;top:calc(100% - 3px);height:11px;background:radial-gradient(ellipse 50% 100% at 50% 0,rgba(0,0,0,.9),rgba(0,0,0,.4) 55%,rgba(0,0,0,0));pointer-events:none;transition:transform .45s cubic-bezier(.2,.8,.2,1),opacity .45s}
.fl-land .bk{container-type:inline-size;position:relative;width:100%;height:100%;display:flex;flex-direction:column;align-items:center;padding:calc(var(--bh)*.07) 0 calc(var(--bh)*.055);border-radius:2px 2px 0 0;background:linear-gradient(90deg,rgba(255,255,255,.07),rgba(255,255,255,0) 16%,rgba(0,0,0,0) 78%,rgba(0,0,0,.28)),linear-gradient(180deg,rgba(255,214,160,.1),rgba(255,214,160,0) 22%),radial-gradient(circle at 30% 20%,rgba(255,255,255,.05),rgba(255,255,255,0) 60%),repeating-linear-gradient(37deg,rgba(255,255,255,.012) 0 2px,rgba(255,255,255,0) 2px 5px),var(--c);box-shadow:inset -6px 0 10px rgba(0,0,0,.35),inset 3px 0 6px rgba(255,255,255,.05);transition:transform .45s cubic-bezier(.2,.8,.2,1),box-shadow .45s,opacity .3s}
.fl-land .book .t{font-family:var(--serif);font-size:9cqw;letter-spacing:.2em;text-align:center;line-height:1.5}
.fl-land .book .l{width:80%;height:1px;background:#c9a45c;margin:7% 0}
.fl-land .book .n{flex:1;min-height:0;overflow:visible;writing-mode:vertical-rl;transform:rotate(180deg);font-family:var(--serif);font-size:max(12px,17cqw);letter-spacing:.12em;text-transform:uppercase;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15}
.fl-land .book.long .n{font-size:max(12px,11.5cqw);letter-spacing:.06em}
.fl-land .book .fl{width:56%;aspect-ratio:2/1;display:grid;place-items:center;background:linear-gradient(135deg,#e7c987,#9c7434 55%,#d3ab60);color:#1a1712;font-family:var(--serif);font-size:15cqw;margin-bottom:6%}
.fl-land .book .s{font-size:6.4cqw;letter-spacing:.22em;color:#c9a45c}
.fl-land .book.light,.fl-land .book.light .s,.fl-land .book.light .t{color:#8a6a26}
