.flb-ov .flb-btn--pri:hover{background:#3b2f1f}
.flb-ov .flb-btn:disabled{opacity:.75;cursor:progress}
.flb-err{margin-top:8px;font-size:13px;color:#8f2f1f}.flb-err:empty{display:none}
.flb-ov .flb-x{position:absolute;z-index:3;top:10px;inset-inline-end:10px;width:44px;height:44px;display:grid;place-items:center;border:0;border-radius:50%;background:rgba(29,23,16,.08);color:var(--ink);cursor:pointer;padding:0;box-shadow:none;transition:background-color .2s}
.flb-ov .flb-x:hover{background:rgba(29,23,16,.18)}
.flb-ov .flb-x svg{width:18px;height:18px;display:block}
.flb-ov :focus-visible{outline:2px solid #8a6a26;outline-offset:3px}
/* solange ein Buch offen ist, tritt die Chat-Blase zurück (sie läge sonst über dem Blatt) */
html.flb-open .chatty-ai-mode.state-resting{opacity:0!important;pointer-events:none!important}
@media (max-width:760px){
.flb-ov{padding:0;place-items:stretch}
.flb-bk{min-height:0;grid-template-columns:minmax(0,1fr);grid-auto-rows:max-content;align-content:start;width:100%;height:100%;max-height:none;border-radius:0;box-shadow:inset 0 0 0 6px var(--c,#2a2a2a);overflow-y:auto;overscroll-behavior:contain;transform:translateY(40px) scale(.96)}
.flb-bk.has-tex{background-size:200% 100%;background-position:100% 0}
.flb-bk::before,.flb-bk::after{display:none}
.flb-pg{padding:20px 22px}
.flb-l{padding-top:54px;padding-bottom:0}
.flb-l .flb-box{height:30vh;min-height:200px}
.flb-r::before,.flb-r::after{display:none}
.flb-r{overflow:visible;padding-inline-start:22px;padding-bottom:0}
/* Kaufknöpfe bleiben unten am Blatt stehen */
.flb-acts{position:sticky;bottom:0;z-index:2;flex-wrap:nowrap;margin:16px -22px 0;padding:12px 22px calc(12px + env(safe-area-inset-bottom,0px));background:#f1e4c3;box-shadow:0 -1px 0 var(--rule),0 -12px 16px -10px rgba(60,40,12,.25)}
.flb-ov .flb-btn{padding:12px 10px;font-size:12px;letter-spacing:.12em}
.flb-err{padding-bottom:10px}
.flb-ov .flb-x{position:fixed;top:14px;background:rgba(241,228,195,.92);box-shadow:0 0 0 1px var(--rule)}
.flb-toc dl>div{grid-template-columns:minmax(0,1fr)}
}
@media (prefers-reduced-motion:reduce){
.flb-bk,.flb-bg,.flb-bk::after,.flb-bot *{transition:none!important}
.flb-bk{transform:none}.flb-bk::after{display:none}
}
</style>
<script>
