/* Foto in box (Papiertafel). src = Bild-URL der gewählten Größe; null = kein Foto -> Monogramm. Gleiche URL: nichts tun. Neue URL: neues Bild lädt unsichtbar und blendet dann über. */
function sz(u,w){u=String(u||'');if(!u)return '';if(u.indexOf('//')===0)u='https:'+u;return /[?&]width=\d+/.test(u)?u.replace(/([?&])width=\d+/,'$1width='+w):u+(u.indexOf('?')<0?'?':'&')+'width='+w}
