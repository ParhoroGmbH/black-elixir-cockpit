.flb-ov.is-on .flb-bg{opacity:1}
.flb-bk{--ink:#1d1710;--mut:#5a4b35;--rule:rgba(110,84,40,.5);position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);width:min(1040px,100%);max-height:calc(100vh - 48px);max-height:calc(100dvh - 48px);min-height:min(660px,calc(100vh - 48px));min-height:min(660px,calc(100dvh - 48px));color:var(--ink);background:#f1e4c3;border-radius:5px;box-shadow:0 0 0 9px var(--c,#2a2a2a),0 0 0 10px rgba(0,0,0,.55),0 2px 0 12px rgba(0,0,0,.35),0 50px 90px -10px rgba(0,0,0,.8);opacity:0;transform:translate(var(--ox,0px),var(--oy,0px)) scale(.16);transition:transform .6s cubic-bezier(.2,.85,.25,1),opacity .3s;transform-origin:50% 50%}
