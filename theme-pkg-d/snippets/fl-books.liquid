.flb-toc dl{margin-top:8px}
.flb-toc dl>div{display:grid;grid-template-columns:minmax(96px,max-content) minmax(0,1fr);gap:4px 14px;align-items:baseline;padding:8px 0;border-bottom:1px dotted var(--rule)}
