/* aufgeschlagenes Buch. o={n:Name,h:Handle,u:URL,m:Foto,c:Deckelfarbe,kind:"Extrait de Parfum",no:[Kopf,Herz,Basis],dn:Duftnoten,v:[{ml,p,c,i,up,ur,uu}]} */
var cur=null;
