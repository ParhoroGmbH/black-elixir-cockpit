.flb-legal{margin-top:6px}
.flb-acts{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
.flb-ov .flb-btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;flex:1 1 auto;min-height:48px;padding:12px 22px;border:1px solid var(--ink);border-radius:0;background:transparent;color:var(--ink);font:inherit;font-size:13px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;text-decoration:none;white-space:nowrap;cursor:pointer;touch-action:manipulation;transition:background-color .25s,color .25s;box-shadow:none;width:auto;height:auto;opacity:1}
.flb-ov .flb-btn--pri{background:var(--ink);color:#f6ecd2}
