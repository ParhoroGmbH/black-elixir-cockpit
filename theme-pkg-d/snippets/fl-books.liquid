.flb-bot.flb-bot .flb-fr img{position:absolute;inset:0;width:100%;height:100%;aspect-ratio:auto;border-radius:0;background:none;object-fit:contain;mix-blend-mode:multiply;display:block;opacity:0;transition:opacity .45s ease}
.flb-bot.flb-bot .flb-fr img.on{opacity:1}
.flb-bot .flb-fr .flb-mono{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:block;width:auto;height:auto;white-space:nowrap;writing-mode:horizontal-tb;line-height:1;padding:.3em .55em;font-family:"Cormorant Garamond",Georgia,serif;font-size:22cqmin;letter-spacing:.06em;color:#1a1712;background:linear-gradient(135deg,#e7c987,#9c7434 55%,#d3ab60);box-shadow:0 2px 6px rgba(40,24,6,.4)}
