  {%- when 'ar' -%}{%- assign flb_s = 'اسحب كتابًا من الرف – فينفتح أمامك.|إغلاق الكتاب|المحتويات|الصورة: عبوة 50 مل' -%}
  {%- else -%}{%- assign flb_s = 'Zieh ein Buch aus dem Regal – es schlägt sich auf.|Buch schließen|Inhalt|Abbildung: 50-ml-Flakon' -%}
{%- endcase -%}
