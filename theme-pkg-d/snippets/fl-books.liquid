/* Buchdeckel klappt auf */
.flb-bk::after{content:"";position:absolute;left:50%;right:0;top:0;bottom:0;background:linear-gradient(90deg,rgba(0,0,0,.35),rgba(0,0,0,0) 30%),var(--c,#2a2a2a);transform-origin:0 50%;transform:perspective(1800px) rotateY(0deg);-webkit-backface-visibility:hidden;backface-visibility:hidden;pointer-events:none;border-radius:0 5px 5px 0;transition:transform .75s cubic-bezier(.3,.7,.2,1) .28s}
